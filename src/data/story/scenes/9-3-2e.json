{"name":"9-3-2E","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"......"}]},{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"M16..."}]},{"spans":[{"text":"I think...I scared M4..."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"What, did you dismember a Sangvis Doll in front of her?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Two of them simultaneously..."}]},{"spans":[{"text":"M4 turned around and ran. She looked disgusted..."}]},{"spans":[{"text":"Why...? Neither you nor AR15 are bothered..."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"We don't enjoy it either, but it seems like M4 can't tolerate it as well as we can..."}]},{"spans":[{"text":"I don't get it... A neural cloud like hers isn't suitable for the battlefield..."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"M16...is there something wrong with me?..."}]},{"spans":[{"text":"I think frightening our leader...isn't a good thing..."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"But you can't control yourself, right?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"In our base, the humans raise many puppies. Their hobby is to chase the trucks that pass by every day."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I know, but they've never caught up before."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"What if one day, those puppies manage to catch up to the trucks. What would happen then?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I don't know...what would happen?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"A friend once told me that the puppies would bury all the trucks into the ground."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Huh——??"}]},{"spans":[{"text":"How can that be! How could puppies bury trucks into the ground!"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"......"}]},{"spans":[{"text":"What if they could? Would they do it?"}]},{"spans":[{"text":"SOP II, what if...they could design a puppy like that?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...M16 pats SOP II's shoulder."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"That's why you shouldn't dwell on why you're like this. What's most important is understanding that it is a part of you."}]},{"spans":[{"text":"Learn to accept it, and learn like it."}]},{"spans":[{"text":"After all, we all like you very much. Put a little more trust in us."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"CG9-1.3","raw":"BIN"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"To be honest, I never understood M16's words..."}]},{"spans":[{"text":"What did she even mean?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Sorry, I'm rambling again."}]},{"spans":[{"text":"I don't know why I can't control myself... It's like a dam bursting... I just want to let everything out..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"SOP II..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO, do you like me?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Of course I do, I told you that earlier."}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"When I first met M4, I wasn't sure if she liked me or not."}]},{"spans":[{"text":"She was always very afraid of me. Far more afraid than everyone else combined."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"M16 said before that M4 was a very unreliable T-Doll at first."}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Perhaps the unreliable one was me. And M16. And AR15..."}]},{"spans":[{"text":"If we were normal T-Dolls, capable and obedient, then maybe M4 wouldn't have been so troubled..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You've already done well enough, SOP II."}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Really? I don't think so... If it were someone else..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"If it were someone else, then M4 would merely be an ordinary command-type T-Doll."}]},{"spans":[{"text":"On the other hand, you are the only puppy capable of catching up to trucks."}]},{"spans":[{"text":"That's why only you can know what happens next..."}]},{"spans":[{"text":"M16 once said that the AR Team was only able to become stronger step by step, so the strength of the team must be the sum of everyone's contributions, including yours."}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Is that so... Alright...I suppose..."}]},{"spans":[{"text":"RO, you're really good at talking."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I'm just saying what I think is true. Thanks for telling me so many stories. I'm even more determined now to bring you all back."}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO..."}]}]},{"sprites":[{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Are you ready? The transmitter is fully charged."}]},{"spans":[{"text":"I don't think I need to tell you this, but once I broadcast the signal, the Commander won't be the only one picking up on our position."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Frontline","raw":"BGM"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Of course I know that!"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Keep track of your ammo. We don't have many rounds left."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"No biggie! I still have my hands!"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Please try to do that out of my sight next time..."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"No problem! Or you could always close your eyes!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...RO laughs, and SOP II joins in on the laughter."}]}]},{"sprites":[{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Very well! Then let's begin!"}]},{"spans":[{"text":"Right now, we are the hope of the AR Team! We'll be fine as long as we work together!"}]}]}]}
