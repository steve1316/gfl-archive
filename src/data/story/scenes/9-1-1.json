{"name":"9-1-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the AR Team's temporary safe house one week after M16A1's disappearance."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Hey...SOP II."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What's up?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Does the AR Team get into situations like this often?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I mean right now... A situation where we've lost contact with HQ and are surrounded by hundreds of Sangvis troops in a run-down factory with only a single magazine of ammo left..."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Well...I was in a similar situation a year ago when I got split up with M4 and the others, though there weren't this many enemies..."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That is to say...it's even worse right now?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Mmmm... I guess so?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Right...right..."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...RO suddenly stands up."}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yet you still opened fire on the enemy! SOP II! Didn't I say that we would sneak past that outpost!"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I don't think it would've been possible to sneak past them under those conditions."}]},{"spans":[{"text":"Rather than waiting to be discovered by the enemy, why not take the initiative ourselves?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I had already disguised our signals. Those low-level Sangvis troops wouldn't have been able to recognize us!"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Even if we were right in their face?"}]},{"spans":[{"text":"Wow...it's that awesome?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Of course it is... Wait, that's not the point! What I mean is that you should trust me. I'm the commander and I won't put us into unnecessary danger, understand?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Alright, alright..."}]},{"spans":[{"text":"But that's pretty awesome, is it new technology from 16Lab?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Heh, what's even better is that I can scan the number of enemies behind me while running right now."}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"But we're not running right now..."}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That's why I said \"now\"! Run, they're going to surround us!"}]},{"spans":[{"text":"Want to guess how many Sangvis troops are on our tail, you little troublemaker?!"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Lemme see... A little over a hundred?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Stop looking and run!"}]},{"spans":[{"text":"Aaaaah! Help us, Commander! Hurry and locate our position already!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The previous day, Griffin headquarters."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"工厂背景avg","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"...What's the problem?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Mr. Kryuger, regarding the search operation for M16A1..."}]},{"spans":[{"text":"In my opinion, there is no need for further investigation. We'll simply be wasting our resources."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Losing an irreplaceable advanced T-Doll is a hard loss to swallow. We should not give up if there is still hope."}]},{"spans":[{"text":"Besides, I've already promised the Commander."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Yes..."}]},{"spans":[{"text":"Speaking of the Commander...do you really intend to bring that person to the banquet along with you?"}]},{"spans":[{"text":"I believe a person of such rank isn't suitable for attendance to that kind of event, at least in regards to information security... I suggest that you reconsider."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"The Commander has the right to know what's going to happen, especially as we will be heading into a grueling war very soon. This will be the guarantee for our ensuing victory."}]},{"spans":[{"text":"You've interacted with the Commander far more than myself, so you should be well aware that we don't have many options remaining."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"...I understand."}]},{"spans":[{"text":"The Commander should be arriving soon. I will set up a meeting as soon as possible."}]}]},{"sprites":[],"ops":[{"type":"background","value":"作战室avg","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile, in the Control Center..."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Really, Commander? We can continue our search for M16?"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Being able to convince Miss Helian...you're so awesome, Commander!"}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"But we've already searched through the entirety of the area where M16 went missing, yet we couldn't find any clues at all..."}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That's true, but that also means M16 must've left the area unscathed."}]},{"spans":[{"text":"If she had come across Sangvis troops, there would've been signs of battle, right?"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Of course!"}]},{"spans":[{"text":"That's right! The M16 that I know wouldn't go down that easily!"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"So please continue to support our search, Commander."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Eh? The Commander won't be heading to the frontlines this time?"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The Commander has a mission at HQ this time."}]},{"spans":[{"text":"However, the Commander will continue to give us long-distance support even without being at the frontlines."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, M16's disappearance is my responsibility. I hope that when M4 returns, she'll be able to see the AR Team with everyone present...or at least back to how it was when I first joined..."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO...it'll be fine, I'm sure of it! There's nothing to be afraid of with the Commander here!"}]},{"spans":[{"text":"Let's head out now. M16 is waiting for us!"}]}]}]}
