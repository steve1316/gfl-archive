{"name":"-73-A-18","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"10220","raw":"BGM"},{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"shake","raw":"震屏3"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2024AB_M16c","raw":"BIN"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Doss_AB","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"Not bad."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a fierce battle, only a few of Doss' bodyguards remain by the bridge. They now stay close to him, giving up on any offensive."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the other side, the Commander and the Dolls are down to their last magazines."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Don't even think about taking that thing with you."}]}]},{"sprites":[{"prefab":"NPC-Doss_AB","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"Count your bullets before you speak."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Doss_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"Where is it?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga jerks her head toward the car's trunk."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A bodyguard steps up, opens it, carefully checks something inside, then returns to whisper to Doss."}]}]},{"sprites":[{"prefab":"NPC-Doss_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"Alright. At least for this part, you did well."}]}]},{"sprites":[{"prefab":"NPC-Doss_AB","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"I'll leave the rest to you. Since you volunteered for this mission, see it through to the end."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Doss taps his cane, and two bodyguards carry the box out of the car."}]}]},{"sprites":[{"prefab":"NPC-Doss_AB","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"Farewell. I hope to see you again, my entrusted... loyal subordinate."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga remains behind, gun in hand, facing the Commander's group."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Doss turns away, escorted by his guards, and retreats across the bridge with the box in tow."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"},{"type":"cgDelay","value":"0.2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! Bang! Two consecutive gunshots ring out."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bullte_Ricochet","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro raises her gun and fires at Doss, but Beluga predicts her move and shoots first, hitting the weapon in Kuro's hand."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro's aim jerks, her submachine gun almost slipping from her grip. The bullets miss."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Stop wasting bullets."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro steadies herself, her gun still aimed at Doss—but he's already shielded by his guards."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander and Mityl are completely out of ammo, and don't dare expose that fact by firing."}]}]},{"sprites":[{"prefab":"NPC-Doss_AB","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"Give it up. The only reason you're still alive isn't because I couldn't kill you."}]}]},{"sprites":[{"prefab":"NPC-Doss_AB","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"You should be grateful for tonight's moonlight. It put me in a good mood."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Even now, in what could be called a retreat, Doss remains composed and gentlemanly. He pulls out a handkerchief to wipe the gunpowder off his cane."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The Sewer Rats' business on the canal—was that your doing?"}]}]},{"sprites":[{"