:"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Doss_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"...Perhaps. I don't remember such trivial things."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Doss shrugs dismissively and continues walking. Several cars are parked at the far side of the bridge."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga fires a shot into the ground in front of the Commander."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Don't move. I'm not out of ammo yet."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Heh..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ignoring the threat, the Commander tosses aside their empty gun, draws a knife, and crouches to charge forward."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl is out of bullets, but Kuro fires to cover the Commander's charge."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga dodges, and the Commander sprints past her, heading toward the bridge. Doss has just reached the far end."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a massive explosion, part of the bridge collapses."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2024AB_M16c","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Horn_Car","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep— beep—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There's no path ahead of the Commander now. Across the river, Doss's convoy honks in a cacophony of mockery."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The headlights grow smaller, the honking fades, and eventually everything vanishes into the dark forest of Kamona."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander turns back, knife in a reverse grip, and faces Beluga."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Now, it's between us."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_arenabreakout_battle1","raw":"BGM"},{"type":"background","value":"2024AB_M16","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A dark cloud blots out the moon. By the ruined bridge, tension crackles between both sides."}]}]},{"sprites":[],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Just go. The bridge is gone, you can't chase him."}]}]},{"sprites":[],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Forget the box. This has nothing to do with you to begin with."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga stands at the bridge alone, calm and unshaken."}]}]},{"sprites":[],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Says who? This is our gig."}]}]},{"sprites":[],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"I didn't care at first. It's just a job from a faceless client."}]}]},{"sprites":[],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"But having it taken right under my nose... someone has to answer for that."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The bridge is destroyed. There's no way to cross the canal."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The tires on the Commander's car have been shot out. If they want to chase Doss, they'll have to seize Beluga's car."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I have one more question."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If you're with Doss, why did you let those civilians go back on the boat?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga doesn't answer."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...There's nothing more to talk about."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Stall her. I'll grab her car.","style":{"size":"25"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander whispers to the two girls beside them and prepares to rush forward."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang—another shot lands in front of them."}]}]},{"sprites":[],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Drop it, Mityl. I know you're out of ammo."}]}]},{"sprites":[],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Kuro. If I counted right, are you planning to threaten me with four bullets?"}]}]},{"sprites":[],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"One is enough."}]}]},{"sprites":[],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"I'll say it one last time—leave. Forget the box."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I don't know what's inside or who hired us."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But Doss... Ha..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If I had to choose between them, I'd never hand the box over to someone like him!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Oddly, the Commander thinks they catch a glimpse of Beluga's smile."}]}]},{"sprites":[],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Watch out!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga shifts her aim toward the Commander, one corner of her mouth curling upward."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A gunshot. Someone hits the ground with a thud."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2024AB_M16b","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the woods, one of Doss' bodyguards collapses."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga's barrel is still smoking in the moonlight."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander, Mityl, and Kuro stand rooted to the spot, all dumbfounded by Beluga's sudden about-face turn."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"There, now we've gotten rid of our tail."}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=5%%delay=0%%range=2","raw":"controll_shake"},{"type":"sfx","value":"AVG_Moto_Start","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2024AB_M16c","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga lowers her weapon, walks to the driver's seat, and starts the engine. Seeing the trio still frozen, she leans out of the window."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"bgm","value":"10213","raw":"BGM"}],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"C'mon, get in."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_Moto_Run","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2024AB_Room","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They pull up at a cabin in the woods at a remote location not too far away. It looks long abandoned."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Come in."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga opens the door and enters first. The Commander and the others exchange glances, then follow suit."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"What is it?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander freezes in the doorway. Kuro and Mityl step forward and peer inside."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside, the box that should've been taken by Doss is sitting quietly in the center of the cabin."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Why are you all blocking the door?"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"What's going on? Didn't Doss take the box? Why is it here? And that guard you shot—why was he there?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"...You ask too many questions."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The three walk inside. Kuro circles the box twice, inspecting it."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Looks exactly the same... Is it the real deal?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She knocks on it with her knuckles."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It is."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander, who has crouched down to examine it, stands back up."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Before we set off, I scratched some markings under the security lock—three left, one right."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"They're very small and hard to spot. Shouldn't be any way to fake them."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"There they are! You thought of that? That's genius!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I was worried you all might... Never mind. It came in handy after all."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga leans down to check the box, then straightens up and shoots the Commander an unfathomable glance."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Alright. I admit I didn't see those marks at all."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"What's going on? Can you tell us now?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Just as you've surmised, the one that Doss took wasn't your box. It was another."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Another?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Yes. Your client simultaneously hired at least six teams to escort identical boxs."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Each team departed at 1900 hrs from different locations, heading to different destinations. No one knew which box was real."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"But there was a leak saying that the real one was with you. So I'm afraid your team was just bait."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro slams her fist onto the box."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So the one Doss took...?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Another team gave up the mission. Nobody else knew."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"So I swapped the boxes and let Doss take theirs."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"To people like Doss or Blackgold Universal, it doesn't matter which is real. They'll split up and chase down all six."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"But I had to find the real one."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You want it too?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga doesn't answer immediately. She gazes quietly at the box, brushing off a few leaves that have fallen on top of it."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"No, I want you to deliver it safely."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Then why steal it earlier?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"If people didn't think Doss had taken your box... how long could you have kept it safe?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hey, we're strong, okay? We had you and Doss running scared just now..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro waves her hands proudly, but accidentally punches the box again. She winces, holding in the pain to keep up appearances."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Pfft..."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"...Shut up..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ahahaha..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Laughter finally returns among the four of them. The past few hours of deception and conflict seem all but forgotten."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"If—and I mean if—we had given up the box like the other team, what would you have done?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Do you know why no one knew I had theirs?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Still, I never even entertained the possibility that you'd abandon her. After all..."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"After all...?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"...People and circumstances change, but bonds don't."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Anyway, I've bought you some time. The car is yours. You'll find ammo and supplies in the back."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"The rest is up to you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga gives the box one last look, then turns to leave."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Where are you going?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"There's still clean-up to do on Doss' side."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait! One last question..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why are you so sure ours is the real one?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga pauses and turns slightly. The Commander sees her eyes. They are filled with certainty, without a hint of doubt."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Because... this is the reason I exist."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Take the box and go. The road ahead will not be easy."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
