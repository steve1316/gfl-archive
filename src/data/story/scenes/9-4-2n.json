rue,"side":"left","tags":{}},{"prefab":"M3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M1 Garand","narrator":false,"pages":[{"spans":[{"text":"When I was with the rest of you. "}]},{"spans":[{"text":"Who said I had to do it myself?"}]}]},{"sprites":[{"prefab":"m1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M3","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"m1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M1 Garand","narrator":false,"pages":[{"spans":[{"text":"M14 and my Dummy sorted it out while we were running from Judge. "}]},{"spans":[{"text":"The show you saw later on...was all Miss Thompson's improvisation... "}]},{"spans":[{"text":"She really is amazing."}]}]},{"sprites":[{"prefab":"m1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"T77","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"T77","narrator":false,"pages":[{"spans":[{"text":"If it was Miss M14, that'd explain how you could get it done so quickly."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The two Dolls share a hearty laugh in the room."}]}]},{"sprites":[{"prefab":"T77","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T77","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I'm suddenly...reminded of a very old story."}]}]},{"sprites":[{"prefab":"M3","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M3","narrator":false,"pages":[{"spans":[{"text":"Hmm?"}]}]},{"sprites":[{"prefab":"T77","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T77","narrator":false,"pages":[{"spans":[{"text":"While two men were making their way to freedom, they came across a daunting chasm. "}]},{"spans":[{"text":"One man jumped across easily, but the other didn't have the courage to follow. So the man who made the leap had an idea... "}]},{"spans":[{"text":"He took out his flashlight and shone the light to the other side of the ravine...and asked his friend to walk over on this bridge of light."}]}]},{"sprites":[{"prefab":"M1 Garand","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M1 Garand","narrator":false,"pages":[{"spans":[{"text":"But in the story, the friend refused to do that..."}]}]},{"sprites":[{"prefab":"T77","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"T77","narrator":false,"pages":[{"spans":[{"text":"He wasn't willing to try, but this path paved with light still gave him hope, didn't it?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Way Back is Paved with Light ⁠— END."}]}]}]}
