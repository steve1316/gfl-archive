ages":[{"spans":[{"text":"Cute...? Okay then, I can't believe someone would actually use that word to describe me..."}]},{"spans":[{"text":"This is the karaoke box, where you and Lily were singing in harmony."}]},{"spans":[{"text":"Hahaha, Romero's stealing Tae's squid in this one. Huh, there are even pictures of Gray Tree..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You relive your memories as you look at each picture, and your heart seems to swell up as you do."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sakura, are these for me?"}]},{"spans":[{"text":"I... I'm touched, and I like them very much! Really!"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"...No."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Eh?"}]},{"spans":[{"text":"But you took so many pictures of me!"}]},{"spans":[{"text":"This one is from when I dragged you off to practice, this one is from when we were eating together..."}]},{"spans":[{"text":"So they're not for me?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"I wanted to save them for myself..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Do you believe our show will be a success?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Of course! I have faith in all of you."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Me too. I've been more and more certain of that with each practice session."}]},{"spans":[{"text":"—Our show is going to be a success."}]},{"spans":[{"text":"Just like how you'll be able to return to your own world."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Yeah, yeah, that's right."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"That's why I thought we should leave some memories behind."}]},{"spans":[{"text":"That way, even if we end up parting for a while, there'll be some proof."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{