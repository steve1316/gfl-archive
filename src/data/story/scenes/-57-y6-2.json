{"name":"-57-Y6-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Corridor","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Night falls, and you and Sakura return to the mansion."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"Campaion-34","raw":"BGM"},{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She has an enigmatic smile on her face and an insistent side to her you've never seen before as she drags you up to the bathtub."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You look at the bathtub, which is adorned with a handful of ornaments which look like strands of kelp."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"How is it, how is it? Does it look cool?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Are you raising kelp strands?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Kelp... strands?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sakura stares blankly at you for a moment, and then he