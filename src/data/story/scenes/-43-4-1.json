{"name":"-43-4-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Agent? Agent?","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I'm not picking up your position. Your signal echo vanished in Manhattan.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Please respond, I repeat, please respond...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_amb_wilderness","raw":"SE1"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"...Shut up."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2020TCTDnight2","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lexington Avenue."}]},{"spans":[{"text":"416 re-emerges onto the streets, illuminated by a street lamp.<下雪></下雪>"}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I narrowly managed to escape death just now, I don't want you to blow out my eardrums with your whining."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"I'm glad you're alright, Agent.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Save it. I don't recall you showing the least bit of concern for me when I was running around just now."}]},{"spans":[{"text":"If you really want to make yourself useful, then why don't you think of a way to help me out?"}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"I can't assist you from my current position, Agent...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"...Then forget it."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"It's not like I was really expecting an NPC to be of much help anyway."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The fog slowly clears...<火焰销毁></火焰销毁>"}]},{"spans":[{"text":"The storm is over, and only a few scattered snowflakes still flit through the sky."}]},{"spans":[{"text":"The street lights are evenly distributed throughout the darkness, illuminating the street corners. The cold air forms a mist close to the ground, making this city of death look even more menacing."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"We dispatched a wave of Agents into the Dark Zone before you, but the results were not what we were hoping for — namely, the rogue agents that you encountered.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I'm glad you're much more capable than our previous Agents. I believe that with your help, this operation's success won't be too far off.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Success..."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"416 purses her lips as she walks down the road."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I am not the least bit interested in winning or losing this game. "}]},{"spans":[{"text":"I was dragged into this unwillingly in the first place. "}]},{"spans":[{"text":"45's the one who wants the prize money."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"B-but...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I'm not backing out."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Hm?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"You're just an NPC, so you probably don't understand."}]},{"spans":[{"text":"Anyone would get mad after being treated that way. "}]},{"spans":[{"text":"And while I'm not particularly driven to win, I hate losing pointlessly even more."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as 416 finishes speaking, her communicator suddenly lights up for the first time in a long while."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Good evening. I see you managed to survive?","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I thought Griffin sent out some kind of badass, but turns out she didn't manage to do much to you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"You sound disappointed."}]},{"spans":[{"text":"Upset that I didn't die?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Well, considering this is a game, I don't see why we couldn't give it a try.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"After all, we rarely get to experience such things, don't you think?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"The two of us actually agree on something. That is rare indeed."}]},{"spans":[{"text":"I also feel that since this is a game, we should cherish these rare opportunities. "}]},{"spans":[{"text":"Like say, by doing things we can't do outside."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I'm very glad to hear you say that. Now, if you could rein in that murderous intent you're radiating I would be even happier.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I, for one, have nothing but the deepest faith in an elite Doll like yourself, which is why I've entrusted such an important task to you. ","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I wouldn't rest easy if it had been someone else. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Why, what an honor."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You're welcome. I'll accept a drink from you once the game is over.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Ah~ That's right, thanks to you delaying the enemy, I managed to find the medicine that NPC wanted. There are six doses in total.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I'll bring your share onto the departure craft with me, so you'd better do your best, okay?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The transmission ends."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"We'll see who gets the last laugh."}]},{"spans":[{"text":"The last person who made me mad is still..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2020TCTDdarkarea1","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_The_Division_Ola_Strandh_Dark Zone","raw":"BGM"},{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Forget it."}]},{"spans":[{"text":"This is weird."}]},{"spans":[{"text":"There's no more fog, but it feels even more disorienting than before."}]},{"spans":[{"text":"I'm having difficulty finding the right path."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"That's because hardly anyone has come here before.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Why is it you can still contact me?"}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"We have a special SHD-only frequency.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Really?"}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"After this, please pay attention to the contaminated areas within the Dark Zone. Staying there for extended periods of time will worsen your infection.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"If you're talking about the passages by the road which seem to be glowing green, I already guessed they were bad news. I have no intention of going into them."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"After Black Friday, they moved a large number of the people who needed help to this region, then built a wall around them and established Manhattan's final defensive line.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"The situation deteriorated beyond what the line could handle.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"When Manhattan lost power, this place was quickly abandoned. The only thing left behind other than the cutting edge weapons and gear they once used is death.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Nobody went in again, and nobody has come out alive either.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"The Dark Zone."}]},{"spans":[{"text":"...It takes a light to cast shadows."}]},{"spans":[{"text":"But I can't see the slightest bit of light in this world."}]},{"spans":[{"text":"It's just going from one Hell to a worse one."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"No, we still have a thread of hope left here—","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"\"The people outside desperately need the medicine.\""}]},{"spans":[{"text":"You're trying to say that light is hidden in the darkest place, right?"}]},{"spans":[{"text":"Cliches like that went out of style 40 years ago."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"That's the most important objective to me.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The medicine itself means more than its mere existence.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"What it symbolizes—hope—is far more important.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"People always try to save things because they need a purpose.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"This is also why we're so weak when we try to save ourselves.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"What you said sounds pretty deep and profound, but do you actually know what it means?"}]},{"spans":[{"text":"It doesn't match at all with what I said. You sound like you're reading off a script."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"There seems to be a good extraction point near the Russian Embassy. If you find the medicine, you can call for help there.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Well, isn't that a \"personalized\" suggestion... Hm?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud!"}]},{"spans":[{"text":"As a chill creeps up her spine, 416 silently curses herself for her carelessness — she was so caught up in talking to Dima that she failed to noticed the rapid footsteps behind her."}]},{"spans":[{"text":"By the time she realizes that someone was approaching, her opponent has already gotten to within two body lengths - a somewhat dangerous range for her."}]},{"spans":[{"text":"Before even verifying the identity of the person behind her, 416 explosively maxes out her body's physical parameters by turning to face the source of the sound and holding down the trigger."}]},{"spans":[{"text":"From the corner of her vision, she notices a familiar figure swiftly evading the attack."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Silvery hair and lime green eyes... I won't let you get away this time."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Again? "}]},{"spans":[{"text":"—Alright then, this time I'll silence you for good!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2020TCTDnight1","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":" Several minutes ago."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"System","narrator":false,"pages":[{"spans":[{"text":"The transmission ends. "}]},{"spans":[{"text":"X Hellfire has killed Good Luck Doesn't Last. "}]},{"spans":[{"text":"X Hellfire has killed P