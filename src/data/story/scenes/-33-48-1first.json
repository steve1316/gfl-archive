wn":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"The Paldiski Submarine Base... This feels like a one-way trip..."}]}]},{"sprites":[{"prefab":"Commander","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Even if it is a one-way trip, we must press on. Our friends are still waiting for us. "}]},{"spans":[{"text":"Contact Persica. When M4 gets back, we have a lot to discuss."}]}]}]}
