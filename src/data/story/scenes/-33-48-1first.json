{"name":"-33-48-1First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Reverse","raw":"BGM"},{"type":"night","raw":"Night"},{"type":"background","value":"2019summer_13","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"On the roof of the military armored train."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"How many shield generators left?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Three more to go!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Now just two!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"There should be one somewhere around here... Found it!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 maneuvers herself nimbly as she evades the attack from the machine gun turret and darts around to its blind spot. "}]},{"spans":[{"text":"She finds the shield generator in a spot behind the turret and promptly destroys it with a shot."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"O