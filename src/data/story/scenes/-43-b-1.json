ges":[{"spans":[{"text":"What'll it be? You in or you out?"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Vodka... My vodka...! "}]},{"spans":[{"text":"I'm in!"}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Alright! Count me in too!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The dorm was noisy before, but suddenly it's gotten even worse."}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"...They won't be able to win if they're THIS drunk, right?"}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Newbie! You're coming too! "}]},{"spans":[{"text":"Don't think you can get away!"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"...You're roping me in as well?"}]}]},{"sprites":[{"prefab":"SKS","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Of course! You want to drink too, right?"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"Frankly speaking, I'm not really interested."}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Aw, don't be like that."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-47 suddenly throws her arms around VSK-94's shoulders."}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Think about it! This is a group activity, we don't get those often, you know? "}]},{"spans":[{"text":"And look at you, you're so full of potential, don't you want the Commander to see how great you are?"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Besides, you don't want the others to think you're distant, do you? "}]},{"spans":[{"text":"This is a rare chance for you to get to know the other Dolls while playing a game, you know?"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"That actually sounds quite compelling."}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"That's it, then! "}]},{"spans":[{"text":"Let's go, girls!"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Woohoo—!"}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Vodka, vodka, here I come—!"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"(Sighs) "}]},{"spans":[{"text":"I'm already starting to regret this..."}]}]}]}
