:"Da, da."}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"...I don't get it. "}]},{"spans":[{"text":"Why do you say that?"}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Now where should we begin..."}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Ahaha, I won't beat around the bush, then, rookie. "}]},{"spans":[{"text":"You used to be a gop, right?"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"A what?"}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"A COP! A police officer! "}]},{"spans":[{"text":"Ignore her, she's as drunk as a skunk."}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"...Da, I used to serve with the police, and for a long time too. "}]},{"spans":[{"text":"What about it?"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Hah! Well, not to toot our own horn, but whenever we go out on missions, we almost always end up getting the cops... I mean, police up our asses."}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Da! Thassright! Never thought there'd be a day when we'd have a gop...uh, a cop as a colleague."}]},{"spans":[{"text":"So we got a man on the inside now, right? No need to fear those cops... I mean, police anymore!"}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Hehe... We'll show them the next time we meet."}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"I returned my badge before I came here. What I'm wearing now is just a memento."}]},{"spans":[{"text":"I no longer have any legal authority."}]},{"spans":[{"text":"In addition, your reasons for being pursued and arrested are rather apparent as it is."}]},{"spans":[{"text":"Have you considered that you might have brought it upon yourselves?"}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Haha, you got it! Man, is my face red!"}]},{"spans":[{"text":"Aw, forget it! Come come come, have a drink or two with us!"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"I am currently on duty."}]},{"spans":[{"text":"Also, forgive my bluntness, but I do not wish to drink with you."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Ehhhh? But why?! Give us a reason!"}]},{"spans":[{"text":"We won't let you go until you make it convincing!"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"Would you like me to go by chronological or alphabetical order?"}]}]},{"sprites":[{"prefab":"SKS","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Ahhhh, just come with us! The Commander should have told you that you need to get along with your colleagues, right?"}]},{"spans":[{"text":"This is just being polite, podruga!"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"Why do Dolls still have to comply with the rules of corporate politeness...? Wait, please don't drag me along, I can walk on my own."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-Dorm","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Oi~ Are you looking down on your seniors? You stick-in-the-mud... (hic) Now drink!"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"I'm sorry... Normally, I don't have a problem with drinking."}]},{"spans":[{"text":"But after seeing the three of you, I have decided to steer clear of alcohol."}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Humph... Look at you, you're totally sloshed and you still have the cheek to tell others to drink. You've disgraced Squad Vodka!"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"WHAT? Didn't I say we were Squad Oolong Tea? Don't go around changing things as you like."}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"It sounds horrible. What's so good about oolong tea anyway?!"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"VODKA tastes awful!"}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Put that vodka bottle down before you say that!"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"Also, the two names are nothing alike."}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"(Hic) Quit fighting. "}]},{"spans":[{"text":"Say, you heard about \"it\"?"}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"You mean \"that\"? "}]},{"spans":[{"text":"Everyone in Griffin knows about \"that\"!"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Oh? So the two of you noticed too?"}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Da. What do you think?"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"You're talking about how all the vodka in the base tastes like it's been watered down lately, right? "}]},{"spans":[{"text":"I noticed that long ago."}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Who the hell's talking about that, dumbass?"}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"