{"name":"-43-B-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Corridor","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"In the Griffin base."}]}]},{"sprites":[],"ops":[],"speaker":"Broadcast","narrator":false,"pages":[{"spans":[{"text":"Sign-ups for \"The Division\" Group Tournament are live! Places are limited, so join fast—!"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Hello","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As VSK-94 steps into the corridor, she is suddenly body-blocked by three Dolls."}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Hey...think that's real?"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Looks like the real deal... Tut tut tut."}]}]},{"sprites":[{"prefab":"SKS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Hm, it's not just the clothes... Look at her face. That face. Isn't it super familiar?"}]}]},{"sprites":[{"prefab":"VSK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"VSK-94","narrator":false,"pages":[{"spans":[{"text":"...Excuse me, seniors? "}]},{"spans":[{"text":"May I know what you're talking about?"}]}]},{"sprites":[{"prefab":"AK47","expression":2,"shown":true,"side":"left","tags":{}}]