{"name":"8-4-2E","beats":[{"sprites":[],"ops":[{"type":"background","value":"SFBase","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Per...sica."}]},{"spans":[{"text":"I've extracted...the file."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Well done, M16."}]},{"spans":[{"text":"Deliver it to 16Lab with your drone."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I've already dispatched it along with the equipment you gave me..."}]},{"spans":[{"text":"I've never used it, and I hope M4A1 will never have to use it either..."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"...She'll use it as she sees fit."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Ha, true... She's a smart girl..."}]},{"spans":[{"text":"A bit TOO smart, unfortunately. An indecisive AI isn't fit for command. You really should've designed her to be more assertive."}]},{"spans":[{"text":"Or if I'd been more strict with her... Sadly, that's no longer possible..."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Perhaps... But you're certainly still helping her."}]},{"spans":[{"text":"You know...M4 is right behind me. Everything you say is directly transmitted to her neural cloud."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Why are you doing that?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"To stabilize her mental state."}]},{"spans":[{"text":"I'm attempting to break her seals, but forcing her to awaken through technology will make her neural cloud go haywire."}]},{"spans":[{"text":"Your voice is keeping her calm and at peace. That's crucial to repairing and recalibrating the personality of her AI."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Seal? Recalibrate? I don't think I'm following..."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"M4A1... This time, I won't just wake her up."}]},{"spans":[{"text":"When she awakes, she'll be stronger...and more dependable..."}]},{"spans":[{"text":"That's...how she used to be."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Ha, I just can't picture...an M4A1 like that."}]},{"spans":[{"text":"Too bad...I won't get to see it..."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Will you regret this, M16A1?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Why would I? It's a bargain for me!"}]},{"spans":[{"text":"If I really mean that much to her..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"SFBase","raw":"BIN"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Tsk..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"What is it? Your neural cloud...is starting to act up."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"My head...is throbbing..."}]},{"spans":[{"text":"It's a very dull ache, nothing too bad, but it's kinda annoying... Is this how it feels to be rewired by Parapluie?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Possibly... But AR-15 never reported this."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Maybe she didn't want to. That girl...is always acting brave."}]},{"spans":[{"text":"And...now there seems to be interference in my channel..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"That's Sangvis Ferri rewriting some of your modules. The channel will be jammed."}]},{"spans":[{"text":"Very soon, you won't be able to hear me..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Ha..."}]},{"spans":[{"text":"So I won't even get to say goodbye?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"The link is still there. If you want to say goodbye, do it now."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Haha, will I wake her up, like in your fairytales?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Do you want that?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 falls silent for a moment."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"M4A1..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"No matter what I'll turn into...wait for me."}]}]},{"sprites":[{"prefab":"Persica","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"M16..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Ha, that's a bit embarrassing..."}]},{"spans":[{"text":"But it's all I want to say..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With that, M16 gives herself a good stretch."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"In any case, I'm done here, right? What a relief."}]},{"spans":[{"text":"Then let's bid each other farewell while my mind is still my own..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"M16..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"M16..."}]},{"spans":[{"text":"Don't go..."}]}]},{"sprites":[{"prefab":"Persica","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"M16...don't go...!"}]},{"spans":[{"text":"M16A1!!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At last, I see hope in this labyrinth."}]},{"spans":[{"text":"It is in the form of a familiar and dependable figure, burning all alone in the distance, and I know that is the exit..."}]},{"spans":[{"text":"I run after her. The flame grows rapidly and bursts into a blinding light..."}]},{"spans":[{"text":"Until at last, it turns into a surgical lamp in the ceiling...and I make my way back into reality from what seemed like an endless dream."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"CG8-2","raw":"BIN"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"(Gasps) (Pants)"}]}]},{"sprites":[{"prefab":"Persica","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"M4A1..."}]},{"spans":[{"text":"You've finally..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Where...am I...?"}]}]},{"sprites":[{"prefab":"Persica","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You're home, M4. Welcome back..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I see... I have finally..."}]},{"spans":[{"text":"Also, Miss...Persica..."}]},{"spans":[{"text":"...Where is M16?"}]},{"spans":[{"text":"I heard her voice..."}]}]},{"sprites":[{"prefab":"Persica","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"M16..."}]},{"spans":[{"text":"Is out on a mission... She isn't here for the time being."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Is...that so..."}]},{"spans":[{"text":"I want to...see her..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Really? Then you'll have to wait for quite a while..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Statics crowd out all correspondence in the channel, and the signal is completely lost. It's time to leave. Leave everyone behind..."}]},{"spans":[{"text":"I get on my feet and dust myself. I'm starting to feel rather attached to the room."}]},{"spans":[{"text":"Not because of the deleted memory, but because this is where I bade my last farewell..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"SFBase","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"I am bugged. I am monitored. I am used as an anti-communication weapon... What will I turn into, now that I've been marked by Parapluie?"}]},{"spans":[{"text":"The person who comes to mind right now isn't myself or anyone else. It is none other than AR-15..."}]},{"spans":[{"text":"That girl... What would she be thinking at a time like this...?"}]},{"spans":[{"text":"I'm losing my train of thought. I take a deep breath and hug my weapon tight."}]},{"spans":[{"text":"I leave the room behind as the old iron door creaks shut."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"Most people won't realize it's the last day of their life as they wake up that morning.\""}]},{"spans":[{"text":"Sometimes, things are actually easier when there's nothing else to lose."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"CG8-3.2","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"My neural cloud can no longer propel my limbs. I fall on my knees in the long corridor, like a cat with its bones taken out."}]},{"spans":[{"text":"Time's up..."}]},{"spans":[{"text":"Now...I just have to await my fate..."}]},{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Singing...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"I start to hear the singing of a clear, female voice. I can no longer tell where it's coming from."}]},{"spans":[{"text":"Maybe it won't hurt to just listen... I'm truly exhausted..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Beautiful..."}]},{"spans":[{"text":"Have I finally...started dreaming as well...?"}]}]},{"sprites":[{"prefab":"Dreamer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Not really, M16A1. This is neither a dream nor a delusion."}]},{"spans":[{"text":"You're merely completely immersed in the Sangvis deep web."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"CG8-3.1","raw":"BIN"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Dream...er..."}]}]},{"sprites":[{"prefab":"Dreamer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"My, my. You know...I really, really hate handling stuff like this..."}]},{"spans":[{"text":"Things that make me work overtime on short notice really ruin my mood..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Well...? Not gonna...shoot...?"}]}]},{"sprites":[{"prefab":"Dreamer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Now let's not be hasty. Let me tell you something interesting."}]},{"spans":[{"text":"Just now, you see, a modular drone flew over the area..."}]},{"spans":[{"text":"That kind of thing can be spotted from above very easily, you know..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You mean... WHAT?!"}]}]},{"sprites":[{"prefab":"Dreamer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Relax. It has certainly been shot down, but it has fallen somewhere beyond my territory."}]},{"spans":[{"text":"It'll take a while to see who'll get to it first."}]},{"spans":[{"text":"But then again, it no longer has anything to do with you, does it?"}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Humph..."}]},{"spans":[{"text":"Don't underestimate...our Commander..."}]}]},{"sprites":[{"prefab":"Dreamer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Whatever. After all, I don't really care about that sort of thing."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"So...what...do you want?"}]}]},{"sprites":[{"prefab":"Dreamer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Technically, it's our Mastermind that wants to see you."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"What?"}]},{"spans":[{"text":"I'm not seeing her here."}]}]},{"sprites":[{"prefab":"Dreamer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"She isn't here, alright..."}]},{"spans":[{"text":"But she's there in your mind..."}]},{"spans":[{"text":"Didn't you just hear her?"}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"单挑","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The next day. Griffin HQ."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Welcome back, Mr Kryuger."}]},{"spans":[{"text":"Was everything sorted last night?"}]}]},{"sprites":[