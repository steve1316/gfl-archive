:[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Yes..."}]},{"spans":[{"text":"Mr Kryuger, is the final showdown...about to begin?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Just get on with the preparations..."}]}]},{"sprites":[{"prefab":"Kryuger","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"In any case, it won't be very far off."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Episode 8 - Spark. END."}]}]}]}
