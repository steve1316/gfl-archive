{"name":"9-4-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...RO finds SOP's hiding spot."}]}]},{"sprites":[{"prefab":"RO635","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"(Panting)"}]},{"spans":[{"text":"Is this the place? This should be it according to the tracker..."}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"SOP II!"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Eh? RO? What are you doing here?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You...!"}]},{"spans":[{"text":"(Sigh) You've really done it this time! Do you have any idea...!"}]},{"spans":[{"text":"You really scared me. If you disappeared as well..."}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Sorry, but...!"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You can't use the authorization rights I gave you to leave the team by yourself! Do you know how much effort we spent——"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hang on, RO, look at this!"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What? This is..."}]},{"spans":[{"text":"M16's..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Sad","raw":"BGM"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"M16's equipment case. I'm sure you recognize it."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Of course, but what's inside it? I've asked her several times in the past but she never gave me a proper answer."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"\"Nothing good.\" That's what she had always said."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"How did you find it?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Persica put a small transmitter on it, which can only be detected at close range."}]},{"spans":[{"text":"This was something M16 herself requested...just in case."}]},{"spans":[{"text":"She once said that M4 would probably need it more than she does in the future."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"So the reason you ran off by yourself was to search for this... You being distracted earlier...was it because you were allocating a part of your neural cloud to search for its signal?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I'm sorry...I thought I'd be able to return before you wake up... Since it wasn't far away, I thought heading out solo might have been safer..."}]}]},{"sprites":[{"prefab":"RO635","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"So you thought that I'd slow you down?"}]}]},{"sprites":[{"prefab":"RO635","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"No...that's not what I meant."}]},{"spans":[{"text":"M16 once said that having emotions allow us to make better decisions."}]},{"spans":[{"text":"I thought that it'd be better if you rested some more, as I'm capable of doing such a small thing by myself."}]}]},{"sprites":[{"prefab":"RO635","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I know that you are concerned about me, but...you should have reported this to me earlier. I wouldn't have refused to let you go."}]}]},{"sprites":[{"prefab":"RO635","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What about Helian and the Commander? It's not that I don't trust them, but they care for us too much. They wouldn't have allowed me to retrieve M16's stuff with my own two hands."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Retrieving it with your own two hands... Does it matter to you that much?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"We'll be able to gain some firsthand information on M16's disappearance this way."}]},{"spans":[{"text":"Look, there are bullet holes here and indications that it was dropped on its side. It was probably shot down from the air..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"There aren't any other signs of damage. It seems that at the very least, M16 was safe at the time when she sent this out."}]},{"spans":[{"text":"And since she was able to send it out, it probably means that she wasn't in a dangerous area, so...I think we can relax for now."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"SOP II..."}]},{"spans":[{"text":"You're...unexpectedly smart today."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"W-What is that supposed to mean!"}]},{"spans":[{"text":"I'm not dumb! I just have a one-track mind, that's all!"}]}]},{"sprites":[{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I know, I know. AAT-52 once said something similar. \"I'm not stupid, I'm just inefficient at multiprocessing.\""}]},{"spans":[{"text":"Though, I'm glad that it's you, SOP II. If any other Doll tried to do the things you did today, I'm sure we wouldn't even be alive right now."}]},{"spans":[{"text":"Perhaps I should update my information on the AR Team as I've always thought of you guys as unprofessional goofs..."}]}]},{"sprites":[{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"The AR Team is certainly not as capable as the top elite T-Dolls, but we have far more autonomy."}]},{"spans":[{"text":"That's why operating under M4's command allows us to achieve the full potential of our operational efficiency."}]},{"spans":[{"text":"RO, if you really want to become a member of the AR Team, then you must think from our perspective and not merely follow orders from above."}]}]},{"sprites":[{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Being lectured by a serious SOP II... This is my first time seeing you like this. Sorry, for some reason I feel like laughing, haha..."}]}]},{"sprites":[{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Haha, laugh if you wanna. This is what AR15 taught me back then, and I've always kept it in my mind."}]},{"spans":[{"text":"Yeah... AR15... She talked about so many things, but I understood so little."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"AR15..."}]},{"spans":[{"text":"Yeah, I'm like that as well..."}]},{"spans":[{"text":"I understand too little... But...I've also learned a lot."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Yup, everyone is a good person. That's why I like everyone so much."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Am I included in that \"everyone\"?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":