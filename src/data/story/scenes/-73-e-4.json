"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Slum","raw":"BIN"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Can we really live here?"}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Of course. This place is going to be a medical outpost soon. Lots of people will come."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"A medical outpost?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a little girl on each side holding her hands, Evita walks through the half-constructed medical outpost."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tents and modular container rooms are being set up. Workers unload crates of medical and daily supplies from trucks."}]}]},{"sprites":[],"ops":[],"speaker":"Doctor","narrator":false,"pages":[{"spans":[{"text":"There you are, Doctor Evita. We're making good progress—some of the consultation rooms are already usable."}]}]},{"sprites":[],"ops":[],"speaker":"Doctor","narrator":false,"pages":[{"spans":[{"text":"Staff are gradually arriving too. In less than a week, we'll be able to start treating patients from the area."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Great work, everyone. Where's the consultation room?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2024AB_Operating_Room","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After sterilizing the tweezers, Evita gently takes Susan's hand. The frostbitten skin has fused with the torn fabric of her worn gloves."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Don't be afraid."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"I'm not."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She says this, but as the sharp tip of the tweezers draws near, Susan's left hand clenches hard on her thigh, trying to divert the pain."}]}]},{"sprites":[{"prefab":"NPC-Lilyan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Tess","narrator":false,"pages":[{"spans":[{"text":"Big sis!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her younger sister's voice wavers as she fights back a sob."}]}]},{"sprites":[],"ops":[{"type":"sfx"