own":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Alright, run along now."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tess hugs the doll and skips out. Susan stays beside the Commander's bed, flipping through the last two days of medical records."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Aside from some glucose, there hasn't been much treatment. Are you sure you don't know what caused you to faint?"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I really don't. Honestly, I don't think I need to be lying here anymore."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"No way!"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"(Sighs) If only Doctor Lawrence were still here. He would definitely be able to figure out what's wrong with you."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Speaking of Doctor Lawrence... I heard he and Doctor Evita didn't get along?"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"How did you know that?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Susan blurts out instinctively, then quickly covers her mouth, realizing she said too much."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So it's true? Aren't they colleagues? Why the conflict?"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"I don't really know either. I mean, they didn't have many chances to meet..."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I heard they had an argument two weeks ago?"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"How do you know all this? ...Well, it's true."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"I went to deliver something to Doctor Lawrence's place that day. I heard two people arguing inside."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"One of them did sound like Doctor Evita."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You didn't see her?"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{