{"name":"-73-E-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2024AB_Operating_Room","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Tsk... Why aren't they back yet?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It's already evening when the Commander returns to the ward and sees Susan standing by the empty bed, clearly annoyed."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_carmona","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ahem..."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Where did you go? It's dangerous to wander off alone in your condition. What if you passed out again somewhere by the road?"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I actually feel much better now... No, I promise I'll stay here and complete the three-day observation."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing Susan put her hands on her hips again, the Commander quickly changes their tone."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"By the way, y