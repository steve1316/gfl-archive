":false,"pages":[{"spans":[{"text":"Of course! I want to be just like Doctor Evita."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"You have no idea what a good person she is."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"202410_Warehouse","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It's a rundown warehouse. The glass on the windows has long since shattered, and the wind whistles coldly through the cracks."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_TearCard","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a corner lie some filthy cardboard boxes. Two young girls squat there, tearing the cardboard into small pieces."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Feeling warmer now? Stuff the cardboard under your clothes. It helps block the wind."}]}]},{"sprites":[{"prefab":"NPC-Lilyan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Tess","narrator":false,"pages":[{"spans":[{"text":"Sis, I'm hungry."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susa