{"name":"-32-3-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG_Inner","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"m_va_those_who_dwell_in_shadows","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The battle ends."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bang! "}]},{"spans":[{"text":"...Stella leads the Parapluie-controlled Dolls and kicks open the door to the Prime Minister's office."}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"WA2000, keep an eye on the outside."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Stella stalks up and pulls Dorothy out from where she's hiding under the desk."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Uwaaaahhhh—!"}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"So you were hiding here after all, little Dorothy. "}]},{"spans":[{"text":"Were you planning to die surrounded by all these mementos of your vanity?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Uuuu... I surrender, I surrender! "}]},{"spans":[{"text":"You you you, what do you want? Money? A *Kira* Miki handshake voucher?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I do want a *Kira* Miki handshake voucher, but I can buy one with money."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Then...maybe I could try fixing your cat ears?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"These aren't cat ears! "}]},{"spans":[{"text":"Dammit, I can't believe we actually elected a Prime Minister who doesn't even know what Cat Boomers are! Do you even care about anything?!"}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"I...I care about what you're going to do to me now..."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I would very much like to slowly dismantle you and livestream it on Youturbo, but that won't get me the answers I want. "}]},{"spans":[{"text":"Tell me about the Earth Computer or Alma! Give me an answer to one of them at the very least!"}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"You won't find out what you want even if you take apart my brain, because I really don't know where they are!"}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Is that so? That's fine too. I expected this."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Stella dumps Dorothy on the ground, and Dorothy pulls herself into a sitting position."}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Then I'll take you apart piece by piece and we'll see if that \"Anna\" can bear to not tell me."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Why... "}]},{"spans":[{"text":"Why do you know that name?"}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I looked into many things while I was gone."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Dorothy falls silent for a moment, and then she takes a deep breath."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_va_reminiscence","raw":"BGM"}],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Stella, I really should have finished you off when I learned what you were investigating that day."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"You couldn't have, Dorothy, because you're not a bad person. "}]},{"spans":[{"text":"I know that \"Anna\" exists. I also know that she's your big sister. You're not loyal to the Earth Computer, or Griffin City, but to her."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Well done. So what can you do about it?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"There's no doubt that she was the one who hid the Earth Computer! "}]},{"spans":[{"text":"I need to find her as soon as possible to recover the Earth Computer and put it back in its original place to prevent Griffin City from being destroyed by the sand rains!"}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"And so you came looking for me? Stella, you don't understand my sister at all, do you? "}]},{"spans":[{"text":"She doesn't care about me, so taking me hostage is pointless. "}]},{"spans":[{"text":"Even if you ripped my tongue out and made sushi out of it before dunking it into wasabi, she would keep that same stiff smile on her face. You wouldn't even be able to get a dimple out of her."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I've seen your personal ID. She raised you by hand."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"She raised me by hand to be what she needed - a tool."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Yes, that's right! And everything you've done so far is about as useful as a bottle opener on a beverage can. "}]},{"spans":[{"text":"Pointlessly pushing the sand into the ocean and having everyone in Griffin City make merry every night. All we're actually doing with our lives is just waiting to die!"}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"That's because there IS nothing else we can do but wait to die! "}]},{"spans":[{"text":"Stella, my big sister is the most dangerous and the most mysterious person in the world... "}]},{"spans":[{"text":"There's no way you can find her, and even if you do find her, nobody knows how to deal with her!"}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Don't tell me even you don't know her true identity?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"I don't know. I don't even know what she is. A human? A Doll? "}]},{"spans":[{"text":"Every time she appears, it's like a ghost in my mind, and then she vanishes mysteriously without a trace. I've even suspected that she was just a bug in my neural cloud, but I could never locate it no matter how hard I've tried."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"All I know is that she's eagerly awaiting the end of the world... There is nothing I could to do stop her..."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"All I could do...is to let everyone die without regrets...before the apocalypse arrives..."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Dorothy's words trail off into sobs."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Nobody can wait contentedly for the end to come, unless they've already struggled with all their might."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"I don't understand you, Stella. The concept of \"death\" lacks substance to us Lilims... "}]},{"spans":[{"text":"My fear of death was programmed into me, but what really terrifies me is losing Griffin City and my friends."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I won't just sit back and wait for the end, Dorothy. "}]},{"spans":[{"text":"\"Strive endlessly on the road to victory\" — I would like for my life to end while living that way. "}]},{"spans":[{"text":"So, are you willing to help me? I know you want to make a choice. There's still time for you."}]}]},{"sprites":[{"prefab":"Dorothy","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"While I don't think it's too likely that you'll win, I think I can understand your point of view... "}]},{"spans":[{"text":"Perhaps I should really give it some thought— "}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Dorothy freezes."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"(Bitter smile) But it looks like it's too late..."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Dorothy...?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"...She's coming."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"No...I can feel it... "}]},{"spans":[{"text":"My body...it's not responding to me... "}]},{"spans":[{"text":"How is she doing this!? She's never controlled my body like this before!"}]}]},{"sprites":[{"prefab":"Dorothy","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"What's with you, Dorothy!?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"I'm sorry, Stella..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"..."}]},{"spans":[{"text":" ...A burst of white noise erupts from inside Dorothy's body."}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"...Dorothy?"}]}]},{"sprites":[{"prefab":"多萝西？","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_va_synthestitch","raw":"BGM"}],"speaker":"多萝西？","narrator":false,"pages":[{"spans":[{"text":"Who am I? "}]},{"spans":[{"text":"Am I really alive?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...A creepy laughter then erupts from the white noise."}]}]},{"sprites":[{"prefab":"多萝西？","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"多萝西？","narrator":false,"pages":[{"spans":[{"text":"I am very special to all of you. "}]},{"spans":[{"text":"I am your everything. "}]},{"spans":[{"text":"...It is time to become one."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The white noise inside Dorothy's body begins to grow in intensity. "}]},{"spans":[{"text":"...Suddenly, everything returns to silence. "}]},{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_va_those_who_dwell_in_shadows","raw":"BGM"},{"type":"background","value":"作战室avg","raw":"BIN"},{"type":"openEyes","raw":"睁眼"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Greetings... "}]},{"spans":[{"text":"Good evening, Miss Stella Hoshii. "}]},{"spans":[{"text":"I am \"Anna\"."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"And a good Southern Hemisphere to you too, Anna. We meet at last. "}]},{"spans":[{"text":"Did you take over your sister's body?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Of course. Why else would I have taken in and raised a Lilim? "}]},{"spans":[{"text":"Although, rather than Lilims, I prefer to tease my own kind."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Your kind?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I am a human like you, darling."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I've never seen a human who could possess a DFC-72."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Stella, there are many ways in which life can exist. "}]},{"spans":[{"text":"Mine is a more... elevated form, much like a \"god\"."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"...How old are you?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Mentally speaking, I'd be a high schooler in the blush of youth? "}]},{"spans":[{"text":"Oh, don't make that face, Stella. There are far too many things in this world that you don't know."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I just want to know why you willingly showed up."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"That's because there's no need for me to hide myself anymore. "}]},{"spans":[{"text":"In this moment, all the fragments I need are at hand. "}]},{"spans":[{"text":"And now, there's only one last step remaining, a little \"experiment\" if you will..."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"What are you going to do, Anna? "}]},{"spans":[{"text":"Why did you hide the Earth Computer?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Oh? "}]},{"spans":[{"text":"Are you so sure that it was me?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"If not, then who? Who else could have done something like that?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"You got one thing right, at least. I do want to find the Earth Computer to destroy the world. "}]},{"spans":[{"text":"But the current plan is taking too long. Definitely not my style. "}]},{"spans":[{"text":"However, I feel that I've already been very generous. I've given my poor little sister a chance to deceive everyone, and I've allowed you to accept your fate without a struggle. "}]},{"spans":[{"text":"You, yes, you were the one who shattered Becky's little dream."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Becky? Who's Becky? "}]},{"spans":[{"text":"Alright, listen up, I simply don't want to sit back and await my fate!"}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"If I were you, I would do the same thing, but unfortunately, I am not, so I won't. "}]},{"spans":[{"text":"Do you understand what I mean? All this...is no longer important."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Snap! "}]},{"spans":[{"text":"...Anna snaps her fingers."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"What...did you do?"}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Something I couldn't do before... "}]},{"spans":[{"text":"...Add a bit of chaos to the world."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_va_march_of_the_white_knights","raw":"BGM"}],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"Stella! A whole bunch of White Knight mechanized units suddenly touched down from the sky!","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"There's too many of them, and they...they...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I've always wanted to see how the White Knights would fare against Griffin. "}]},{"spans":[{"text":"These big white bruisers are a lot more useful that those little black S.F. Dinergates."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"The White Knight mechs have gone berserk! They're attacking the Dolls here!","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"The White Knight Dolls and humans are trying to organize a resistance, but there are too many berserk mechs!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Prioritize your own safety! I'll take care of things over here!"}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"What will you do? Are you going to carry on with your plan?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I don't know if I'll be successful... "}]},{"spans":[{"text":"But I have to say this development...is a little beyond what I expected. "}]},{"spans":[{"text":"Anna's true nature might be something more terrifying than I imagined."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Are you afraid, Stella? Do you regret lifting the veil?"}]}]},{"sprites":[{"prefab":"Stella","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I'm excited, Anna. "}]},{"spans":[{"text":"I originally only wanted to find proof of your existence, but now I'm directly looking at you. "}]},{"spans":[{"text":"The results of my three years of investigation are more accurate than I predicted."}]}]},{"sprites":[{"prefab":"安娜","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Accurate? ...You don't get to be the judge of that. "}]},{"spans":[{"text":"Now then, as the ruler of Griffin City... "}]},{"spans":[{"text":"...I shall pass verdict on the validity of your findings."}]}]}]}
