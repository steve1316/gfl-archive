{"name":"-57-Y3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Corridor","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You return to the mansion after a busy day."}]},{"spans":[{"text":"Although you've only been living here for a few days, this place is now the closest thing you have to a \"home\" in this strange world."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After unburdening yourself of your fatigue, you decide to go take a nice long bath to relax."}]},{"spans":[{"text":"You head over to the shower room and are about to open the door."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Suddenly, the door opens by itself—"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"gradientShow","value":"1","raw":"GradientShow"},{"type":"bgm","value":"m_wv_title","raw":"BGM"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Ahhhhhhh! Commander—"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"gradientHide","value":"1","raw":"GradientHide"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"No-no-no-no, it's nothing worth looking at—"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The door closes again with a \"bang\" and a dark silhouette runs away before your eyes..."}]},{"spans":[{"text":"Wait, was that Sakura?"}]},{"spans":[{"text":"Why did she react that way upon seeing you? Did something happen to Franchouchou? Or is it an accident that you don't know about..."}]},{"spans":[{"text":"No, you HAVE to go and see what's going on!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hey... Sakura!"}]},{"spans":[{"text":"Sakura! Sakura—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Shouting doesn't seem to help."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The corridor is pitch black and the only sounds come from your own breathing and your footsteps."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Although Kalin's always been a bit of a penny pincher, surely even she wouldn't be so miserly as to not pay the electric bill..."}]},{"spans":[{"text":"Eh?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There's a weird sensation on your leg, like you've kicked something hard. Perhaps you could try kicking it again?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":"？？","narrator":false,"pages":[{"spans":[{"text":"Ugh—"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You crouch down in the darkness and feel something fluffy yet hard on the ground."}]},{"spans":[{"text":"You have a rough idea of what it is and slowly begin to speak—"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sakura... I know you're a zombie, but I'm still a human being..."}]},{"spans":[{"text":"Could you not keep dropping your head onto the ground? It's scary whether or not the lights are on..."}]}]},{"sprites":[],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"I'm not Sakura..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Then I'd better go turn on the lights to see who you are."}]}]},{"sprites":[],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Stop-stop-stop! Wait, wait for me to find my body!"}]},{"spans":[{"text":"In any case, just leave me alone for now!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Nope. I'm going to keep holding your head like this until you explain things clearly."}]}]},{"sprites":[],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Then... Then let's keep a distance as we talk!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why is that?"}]}]},{"sprites":[],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"It... It's for your own good!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sakura's body feels its way toward me and takes the head from your hands."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"sfx","value":"AVG_20Winter_Open_Light","raw":"SE2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You turn on the lights while you're at it."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Corridor","raw":"BIN"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"(Coughs heavily) Don't... Don't you think you've been really unlucky these last couple of days?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Frankly speaking, I'd say I've been pretty unlucky since the moment I saw you guys."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Which is why I can't keep ruining your luck!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sakura smiles bitterly."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"You... You must want to go back to your world very much, right?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Of course."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"So we can't mess up this show."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah, I know. I'll do my best."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":11,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"No! You don't understand!"}]},{"spans":[{"text":"If-if you keeep hanging around with me, you might regret the outcome."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":11,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why do you say that?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"I... I've always been really unlucky. "}]},{"spans":[{"text":"The harder I try, the worse the result."}]},{"spans":[{"text":"I don't know if that's going to affect you."}]},{"spans":[{"text":"I... I know this is very important to you, so I don't want to spoil it. "}]},{"spans":[{"text":"So please. please stay away from me."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What about you and the others?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"...Well, everyone's used to all the problems I cause."}]},{"spans":[{"text":"And they... They've all died before, so I guess they're familiar with that sort of thing."}]},{"spans":[{"text":"But you're different. I don't want you to get infected by my bad luck."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I've never been the betting sort, though."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Because I'm like you too, Sakura. I'm a very unlucky person. "}]},{"spans":[{"text":"Or rather, anyone who's born during my time must be pretty unlucky."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So I don't believe in luck."}]},{"spans":[{"text":"If I really was a lucky person, I wouldn't have a life like this."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Commander... I..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Still, I'm not the sort who gives up easily."}]},{"spans":[{"text":"That's because I know that if luck is zero percent of anything you do, then you have no choice but to put 100% of yourself into your endeavors."}]},{"spans":[{"text":"It's just like you, Sakura. No matter how other people treat you, or how seriously others treat the performance..."}]},{"spans":[{"text":"You're always practicing. You'll always be the one who practices the hardest."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Ah... So you noticed?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yup. I've been paying attention to you from the beginning."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"And I... I've also been paying attention to you. I've been hoping that you could go back to your original world."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'd like Franchouchou to put on a successful show too."}]},{"spans":[{"text":"But I forbid you to say you're keeping your distance from me or whatever. After all, we're both really unlucky and I might end up spreading my unluckiness to you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sakura laughs with a \"pffft\"."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Then, let's be unlucky together."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yup."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"And let's do our best together too!"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Of course!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sakura's happiness seems to have spread to you, because your lips can't help but curl into a smile."}]}]}]}
