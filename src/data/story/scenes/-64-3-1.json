,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_lifttable","raw":"SE1"}],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Oh, she slips! And her curry is spilled all over Webley's suit—"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Stop, I didn't ask for a real-time commentary."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Sorry for misunderstanding my task. Please don't give me a bad review because of this."}]}]},{"sprites":[{"prefab":"QSB91","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-70,150"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"QSB-91","narrator":false,"pages":[{"spans":[{"text":"Don't get angry, Boss. We've been having a shortage of ingredients lately. Other than potatoes, the Dolls have to fight over all the food..."}]},{"spans":[{"text":"So everyone gets pretty tense whenever it's mealtime."}]}]},{"sprites":[{"prefab":"QSB91","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-70,150"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Didn't I say our supply issues would be resolved soon? We just have to hang in there for a bit longer."}]}]},{"sprites":[{"prefab":"QSB91","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-70,150"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"QSB-91","narrator":false,"pages":[{"spans":[{"text":"You did..."}]},{"spans":[{"text"