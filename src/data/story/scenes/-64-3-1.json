 What are those?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"I've never heard of them either... Are those dishes where you're from?"}]}]},{"sprites":[{"prefab":"QSB91","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-70,150"}}],"ops":[],"speaker":"No. 322","narrator":false,"pages":[{"spans":[{"text":"Hahahaha, you're funny, comrade. Why would we need such extravagant food?"}]}]},{"sprites":[{"prefab":"QSB91","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-70,150"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're happy with just potatoes...?"}]}]},{"sprites":[{"prefab":"QSB91","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-70,150"}}],"ops":[],"speaker":"No. 322","narrator":false,"pages":[{"spans":[{"text":"Of course!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Hm, I guess that's just how things are in Sector 2Z64."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"frame","value":"2","raw":"边框"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"2022saros_MessyKitchen","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"effect","value":"%%code=AVG_chuxian_yan%%","raw":"common_effect"},{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"},{"type":"sfx","value":"AVG_deep_frying","raw":"SE1"},{"type":"b