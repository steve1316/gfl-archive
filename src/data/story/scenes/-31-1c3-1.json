{"name":"-31-1C3-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"background","value":"BG-Wall","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 and AK-12 steadily move deeper into the region where the defenders and the rebels are fighting."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"We've nearly cleared out the units in the sector around the lowest levels. "}]},{"spans":[{"text":"We're going to head up. After this, we'll be making direct contact with human rebels. "}]},{"spans":[{"text":"M4, are you ready?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Wait a moment."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What's the matter?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 walks over to M4's side and finds that she is inspecting a human collapsed by the wall."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"This man's one of the wall's defenders. Huh, seems to be an officer, too. "}]},{"spans":[{"text":"As a human, he must have had a hard time holding out here by himself for so long."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"H