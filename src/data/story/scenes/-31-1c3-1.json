es":[{"spans":[{"text":"You really do like doing things your own way... Fair enough. "}]},{"spans":[{"text":"Let me see what this unnecessary complication brings us. "}]},{"spans":[{"text":"I'll make a move first, then."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 leaves."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Thank you, young lady..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Please bear with this for a little longer, I'm going to take you to a safe place where you can take shelter."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"(Coughs) No need for that... "}]},{"spans":[{"text":"...Head to the frontlines, more people need you there."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Right now, you need me more."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"M4 carries the officer into a sealed area where the quarantine wall segments are joined and gives him basic first-aid for his wounds."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"The bleeding's stopped, you should be fine now."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Thanks for the rescue."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"No need to thank me, this is my duty."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"You don't seem to be from our unit. "}]},{"spans":[{"text":"(Coughs heavily) ...Have things reached the point where we need to put a girl like you on the frontlines...?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"It's fine, I'm a Tactical Doll."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"What? I can't believe Dolls are so realistic now... "}]},{"spans":[{"text":"Oh, but still, thank you and whoever sent you to help us."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"My order is to help your unit repel the rebels. "}]},{"spans":[{"text":"In order to facilitate our movements, I hope you will tell your comrades not to attack me and my companion."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"(Cough) ...Alright... "}]},{"spans":[{"text":"What's your IFF signal...?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'll send it to you now."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The garrison officer picks up the radio on his webbing and opens a communications channel."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Attention all units... "}]},{"spans":[{"text":"The designated Tactical Dolls have been sent by our side to provide support... Do not attack them..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Will that do?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"That's enough. Thank you for your cooperation."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Can you tell me who sent you to help us?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...We just happened to be passing by."}]}]},{"sprites":[{"prefab":"Garrison Officer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Is that so...? I understand. "}]},{"spans":[{"text":"You have to stop them, otherwise the entire city will be doomed..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Understood. They won't get their way. "}]},{"spans":[{"text":"Take care of yourself."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...M4 returns to the wall passage and meets up with AK-12."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I've solved the problem that was troubling you."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Yeah, I heard it all over the radio. "}]},{"spans":[{"text":"Did you plan this?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I just happened to come across an opportunity and took advantage of it. "}]},{"spans":[{"text":"It was all for the sake of making the operation more successful. "}]},{"spans":[{"text":"Also, Ange doesn't want to see unnecessary casualties."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...Is that really the case?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"What are you trying to say?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"No matter how much you try to pretend you're a cold machine, you can't run away from who you are inside. "}]},{"spans":[{"text":"I won't hate you, even if you don't cover it up."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...I didn't do it to make you like me."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I understand. "}]},{"spans":[{"text":"Go do whatever you want, provided it doesn't jeopardize the mission. "}]},{"spans":[{"text":"That way, I'll be able to see more interesting things."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...You have terrible hobbies."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It's not like it's going to do you any harm now, is it?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Whatever, do as you please."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"(It's not just who I am inside that I can't escape, but OGAS as well... What should I do from now on...?)","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Inside the quarantine wall."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"sfx","value":"Gunfight","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 and AK-12 support the defenders in an intense clash with the rebels."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"The enemy offensive seems to have tapered off. "}]},{"spans":[{"text":"AK-12, are they making any new moves?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"The defenders are steadily encircling the rebels at the top of the wall. "}]},{"spans":[{"text":"The rebel forces have been cut in half and one of those halves is trying to escape..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Pathetic. To think they'd abandon their units to run away..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Still, there's something weird here. The scans show that the fleeing rebels are heading toward the base of the wall."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"If they're retreating, that position would end up being flanked. It's not suitable for defense. There must be something fishy going on."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 connects to the comms network and reports the situation to Ange."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Did you hear that, Ange? The enemy's situation is a little abnormal. I've already sent you the distribution of their forces."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"The enemy's gathering at the base of the wall, huh...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Tsk... the surrounded rebel troops might just be bait. They've discovered that they can't seize control access for the entire quarantine wall and so they're using their backup plan.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"That other group of rebels is probably going to try and seize the sector containing the wall control room, and then they'll try to open the wall up! You need to get to the control room and stop the rebels before they make their move!","style":{"color":"#00CCFF"}}]}]}]}
