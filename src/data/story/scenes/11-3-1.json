fadePointOn","raw":"黑点1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"It doesn't matter. Let's just get a handle on the way she operates for now and track her later. The informant will give himself away eventually."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Five minutes later."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO...have you finished going through all the records?"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yeah...something's off..."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Doesn't that convertible look familiar to you?"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Not just familiar. This is the very same car we spotted her with earlier... "}]},{"spans":[{"text":"That maid...she's been walking through different streets, but she's just going around in circles."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"But why? Some kind of weird strolling command?"}]