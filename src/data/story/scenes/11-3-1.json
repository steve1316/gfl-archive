":false,"pages":[{"spans":[{"text":"A cliché but effective way to capture someone. "}]},{"spans":[{"text":"Should I sniff out all the stalkers one by one?"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"No, that would take too long, and there's no telling if we missed out anyone."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Then... "}]},{"spans":[{"text":"Fourth floor to the right, someone there has been observing this area the whole time. He's hidden behind the curtains but I can still faintly sense his signal. "}]},{"spans":[{"text":"It could be the Doll in command... I'm not the best in electronic warfare. He might become aware of me if I force a connection, so why don't you give him a try?"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Got it. "}]},{"spans":[{"text":"I'll just have to hack into this Doll and track down the others through him. "}]},{"spans":[{"text":"Leave it to me. Keep an eye on the maid."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Just keeping an eye on her isn't safe enough. If they decide to make a move, we won't get there in time to stop them from snatching the maid."}]}]},{"sprites":[{"pref