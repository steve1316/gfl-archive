{"name":"-38-2-2Round","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"flashback","raw":"回忆"}],"speaker":"Audio Recording","narrator":false,"pages":[{"spans":[{"text":"\"We've run out of money...\" "}]},{"spans":[{"text":"\"I've borrowed a sum but it's only enough to cover our daily expenses. At least we can pay the bills for now...\""}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Audio Recording","narrator":false,"pages":[{"spans":[{"text":"\"You've got to think of something. Aren't you a man?!\" "}]},{"spans":[{"text":"\"At this point, there's only one thing we can do...\""}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Audio Recording","narrator":false,"pages":[{"spans":[{"text":"\"Have you got the money?\" "}]},{"spans":[{"text":"\"I bought several life insurance plans for Angelina with it.\""}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Audio Recording","narrator":false,"pages":[{"spans":[{"text":"\"As long as we pull through, we can have other, cuter children.\" "}]},{"spans":[{"text":"\"Sweet dreams, my dear Angelina.\""}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Audio Recording","narrator":false,"pages":[{"spans":[{"text":"\"Cyborgs don't remember their past, so give her a new name.\" "}]},{"spans":[{"text":"\"The only thing her parents did right was to name her after the angels... Let's call her Angelica.\""}]}]}]}
