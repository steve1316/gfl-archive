aker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"Nothing at all. They themselves—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_SCARL3","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Like a phantom, Suzuka Mizukane dodges the Commander's shots with light and graceful movement. She vaults over the same piece of cover and stares into the Commander's soul with her dark eyes."}]}]},{"sprites":[{"prefab":"NPC-Suzuka","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-160,100"}}],"ops":[],"speaker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"...Betrayed you."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Don't be ridiculous!","style":{"size":"50"}}]},{"spans":[{"text":"What do you know about betrayal?!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"sfx","value":"AVG_Combat_Hits","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At this distance, the Commander decides to drop their gun and opt for close-quarters combat."}]}]},{"sprites":[{"prefab":"NPC-Suzuka","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-160,100"}}],"ops":[],"speaker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"What's more, all the Dolls here are traitors."}]}]},{"sprites":[{"prefab":"NPC-Suzuka","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-160,100"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Suzuka","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-160,100"}}],"ops":[],"speaker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"When given a better choice, are you so sure the Dolls would still choose you?"}]}]},{"sprites":