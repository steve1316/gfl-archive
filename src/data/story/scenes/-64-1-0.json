er","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The ghostly voice speaks behind them again."}]}]},{"sprites":[],"ops":[],"speaker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"I've read the Dolls' memories. You wish to be the shining beacon in a brave new world, isn't that right?"}]},{"spans":[{"text":"Big Brother is presenting you with the opportunity."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is it an opportunity... or a trap?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander turns around, but there is nobody behind them. The soft, disembodied voice continues to croon into their ear."}]}]},{"sprites":[],"ops":[],"speaker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"You keep fighting, but you are not a warmonger who relishes in violence."}]},{"spans":[{"text":"Quite the contrary, fighting has caused you endless suffering."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"We are going to build an ideal world."}]},{"spans":[{"text":"A world that isn't ravaged by war and ELID."}]},{"spans":[{"text":"A world with no friction, discord, or strife. Just eternal peace."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't give me that crap, as if such illusory things could actually exist."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"},{"type":"sfx","value":"AVG_2022Saros_Gunpast","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander fires in the direction of the voice, but none of the bullets hit