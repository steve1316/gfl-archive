{"name":"-43-4-3","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2020TCTDdarkarea1","raw":"BIN"},{"type":"bgm","value":"GF_The_Division_Ola_Strandh_Dark Zone","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"—Somewhat earlier, at the United Nations Plaza."}]},{"spans":[{"text":"After being taken over by the Last Man Battalion, this place, which once safeguarded peace, was converted into a military stronghold."}]},{"spans":[{"text":"The defenders here were cleared out not long ago. UMP45 spots the human agent who's been guiding them over the radio all this time on the plaza...<下雪></下雪>"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"...Yo, have you been waiting here the whole time?"}]},{"spans":[{"text":"Come to think of it, I've been wondering where you were all along."}]},{"spans":[{"text":"So you were waiting for us at the destination after all, hm?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"It's you...!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"\"It's you\"? "}]},{"spans":[{"text":"Got a problem? "}]},{"spans":[{"text":"Sounds like you've got a bone to pick with me."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"...No, that's not what I meant, Agent."}]},{"spans":[{"text":"What about the other agents? Are they not here yet? As I recall, you weren't operating alone."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I'm the only one here, and I'm going to be the only winner."}]},{"spans":[{"text":"...You have the flare gun, right? Give it to me."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45 reaches out to Dima for the most important item in the game."}]},{"spans":[{"text":"With the flare gun, the game can enter its final stages. After that, all she has to do is get on the chopper and the winner will be decided."}]},{"spans":[{"text":"...At least, that's how it's supposed to be."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as 45 thinks Dima is going to hand her the flare gun, Dima suddenly takes a step back."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"...What a surprise. So even you are going to get between me and the prize money?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"No, that's not it. It's just..."}]},{"spans":[{"text":"Um... It's a little dangerous to call for the evac chopper when you're fighting by yourself."}]},{"spans":[{"text":"We need more manpower to deal with any unexpected things that might come up."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"...Do we now?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Yes... Once you call the evac chopper, unexpected things are sure to occur."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"How unexpected can they be? Are talking turtles are going to burst out of the sewers or something?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"I'm being serious...urgh!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As Dima tries to talk UMP45 down, the latter trains the cold, dark and hollow muzzle of her gun at the NPC."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You don't sound like you're the least bit afraid of \"unexpected things\". "}]},{"spans":[{"text":"The truth is, you know EXACTLY what's going to happen, don't you? Or do you simply not want to give me the gun?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"A-Agent—！"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I don't care which it is."}]},{"spans":[{"text":"A mere NPC has no right to tell me what to do."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45 snatches the flare gun and points it into the sky."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2020TCTDdarkarea","raw":"BIN"},{"type":"sfx","value":"AVG_The_Division_Flare_Gun","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There is a shrill screech, and a brilliant red light soars into the jet-black sky..."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"You... What have you done?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Almost at the same time, UMP45's vision distorts slightly."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_The_Division_ISAC_On","raw":"SE1"}],"speaker":"Helicopter Pilot","narrator":false,"pages":[{"spans":[{"text":"—Evac chopper approaching."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Well? Nothing much has happened."}]},{"spans":[{"text":"Simple enough, wasn't it?"}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"No! This isn't like what I expected at all!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_The_Division_ISAC_On","raw":"SE1"}],"speaker":"ISAC","narrator":false,"pages":[{"spans":[{"text":"High-threat target detected."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_The_Division_ISAC_Off","raw":"SE1"}],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Aaaaahhhh they're here, we're doomed we're doomed we're doomed!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Who are you babbling to? "}]},{"spans":[{"text":" Would you mind shutting the hell up?"}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"I will not shut... Uwahhhh!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A black tide of rogue agents floods in, giving them not time to breathe."}]},{"spans":[{"text":"As both sides exchange heavy fire, UMP45 precisely and methodically eliminates all the targets approaching her."}]},{"spans":[{"text":"Meanwhile, Dima has been pinned inside the cover, but she still seems to be trying to contact somebody else."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"We're doomed... It's over..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"If this is what scares you, then you're pathetic."}]},{"spans":[{"text":"These peons can't even come close to hurting me as long as I have enough ammo in reserve. "}]},{"spans":[{"text":"It'll be a piece of cake to hold out until the chopper arrives."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"You don't understand! You don't know anything at all!"}]},{"spans":[{"text":"If you fail here... It means all my previous work will be for nothing!"}]},{"spans":[{"text":"...Aaaahhhh! When can I get out of this goddamn place?!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I don't know anything?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"That's right! You don't know anything!"}]},{"spans":[{"text":"These rogue agents aren't the scary part! It's—"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"It's \"Hellfire\", right?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Now that you mention it... I've been meaning to ask this for a while, but I haven't been able to find the opportunity."}]},{"spans":[{"text":"Miss Agent, don't you think your behavior is far too unsightly? "}]},{"spans":[{"text":"And here I had some expectations of you."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Er... W-what do you mean..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You're not an NPC at all. You're a player, like us."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"I...!"}]},{"spans":[{"text":"I don't understand what you're talking about—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dima stands up in an attempt to run away, but then a shot whizzes past her ear."}]},{"spans":[{"text":"She gets the message and crouches back down immediately."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Ahhhh, I'm hit, I'm hit!"}]},{"spans":[{"text":"I don't want to be stuck in this godforsaken place forever, somebody save me!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I really am impressed by your sheer nerve. Your masquerade is in tatters and you're STILL trying to carry on pretending?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Er..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Of course, if that was it, I wouldn't care at all."}]},{"spans":[{"text":"It doesn't matter one bit to me whether you're a player or an NPC. "}]},{"spans":[{"text":"That is until I noticed one teeny tiny detail..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"W-what detail?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"If I'm not mistaken, you know me, don't you?"}]},{"spans":[{"text":"Ever since we met, you've been acting very strangely."}]},{"spans":[{"text":"Compared to, oh, someone who was afraid of a dangerous stranger, it was more like you were afraid of ME."}]},{"spans":[{"text":"You're afraid of \"UMP45\"."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"What are you talking about, why would I be scared of you for no reason at all?!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You've been stuck in the game all this time, haven't you?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Ye...huh? "}]},{"spans":[{"text":"W-what do you mean?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Heehee."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_The_Division_Machine_Gun_Tower","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45 chucks a gun turret over the cover. After successfully distracting the rogue agents, she shifts her attention back to Dima."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_The_Division_Machine_Gun_Tower_Shooting","raw":"SE1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Nervous, aren't you? Ja, you should be."}]},{"spans":[{"text":"If you're who I think you are, then you should know how I do things."}]},{"spans":[{"text":"This game is winner-takes-all, and I will be the winner. I don't care how I reach that outcome as long as I do."}]},{"spans":[{"text":"Therefore, right when the game began, I tried a special trick I used before in the past."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"A special trick..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"(Grins) That's right, I gave myself a little access, enough to allow me to check the status of every player logged into this game. Do you know what I found?"}]},{"spans":[{"text":"Out of the 24 players in the game, 19 of them were from Griffin. After adding my team, the total comes to only 23 people..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"And as for the last player, perhaps they were careless, but they didn't hide their login information. "}]},{"spans":[{"text":"And the place that player logged in from...surprisingly enough, it's very similar to a place I once visited~"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Though surrounded by countless enemies, UMP45 runs through the information she has learned in a playful, mocking tone, then she points a finger at Dima."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"What! Why you! You actually found my server address?!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Quit pretending."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45 snatches off Dima's gas mask."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Aaaaaahhhh! What are you doing?! "}]},{"spans":[{"text":"I'm dying I'm dying!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I have to say, seeing your performance was quite entertaining, and 416 hasn't even suspected it yet."}]},{"spans":[{"text":"Ah, I wonder what kind of amusing faces she and Gr G11 would make if I told them about this. To think Miss Dima, who has been pretending to be an NPC all along, is actually—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"—Tsk, I didn't expect you to be the first one here."}]},{"spans":[{"text":"416 must have gone to great lengths to shake you off."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A gunshot interrupts UMP45's exposition. She looks toward the source of the sound and sees a short-haired Doll. It is Vector."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"You're the other player, right?"}]},{"spans":[{"text":"Sorry, but I need to win."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"No problem, no problem. That's how competitions are. There must be a loser if there is to be a winner."}]},{"spans":[{"text":"You, on the other hand, should have put that bullet into me instead."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"I have no grudge with you. I just want to settle this fair and square."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Don't try to reason with her!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bangbangbang!"}]},{"spans":[{"text":"Before Dima can finish, while Vector is distracted—"}]},{"spans":[{"text":"UMP45's gun spews a tongue of flame!"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vector swiftly rolls into cover, and the gunshots stitch a line of small bullet holes into the tarmac."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Hey! Have some class!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Can it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rattle rattle rattle..."}]},{"spans":[{"text":"A discordant note rings out amidst the lethal melody of gunfire."}]},{"spans":[{"text":"45's wealth of battle experience beats her about the head and when she looks down, she sees a pair of grenades rolling to her feet."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Scheiße!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She curses quietly, then leaps back like a frightened sparrow."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_The_Division_Grenade","raw":"SE1"}],"speaker":null,"narrator":false,"pages