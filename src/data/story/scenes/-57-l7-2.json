:[{"text":"Ahem, it looks like I was overthinking things.","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You narrow your eyes and carefully study the hairclips. With your keen powers of observation, the answer is obvious."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Um..."}]},{"spans":[{"text":"Ummm..."}]},{"spans":[{"text":" Er, aren't they all the same?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"They're totally different!"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So what sets them apart from each other?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily picks up two of the hairclips and holds them up before your eyes."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"The left has cooler tones, and it goes better with costumes that have lower color temperatures."}]},{"spans":[{"text":"The one on the right has the best luster; it sparkles under the stage lights and is super cute!"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You could make a whole thesis out of that..."}]}]},{"sprites":[{"prefa