","value":"2","raw":"分支"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Yup."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily takes it off, just as she said, but you still have a little trouble believing it."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Are you really going to give it to me?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Yup-yup!"}]},{"spans":[{"text":"Although you said you wouldn't be able to contact Lily again, you might still have the chance to watch one of Franchouchou's concerts, right?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"When the time comes, it doesn't matter who you're disguised as, Lily will be able to spot the brightest star in the auditorium as long as you wear this hairclip!"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Lily..."}]},{"spans":[{"text":"If I get the chance, I'll make sure I put it on."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Yup! That star will be our secret code, then... It's a promise, okay?"}]}]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=Saga_Lily_item%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily extends her pinky finge