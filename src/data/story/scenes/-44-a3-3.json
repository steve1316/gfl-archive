s":[{"prefab":"RPK16","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"You need to calm down. "}]},{"spans":[{"text":"If AK-12 were here, I'm sure that's what she'd say."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If 12 were here, she'd already be dialing the Earl's number."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"...Unfortunately, I don't have his contact details. "}]},{"spans":[{"text":"Actually, none of us do. Communication with him has always been one-sided. "}]},{"spans":[{"text":"We can't get in touch with him."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Light?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Miss RPK is right. "}]},{"spans":[{"text":"We're also only taking orders from above. "}]},{"spans":[{"text":"Even J doesn't know where these orders come from. "}]},{"spans":[{"text":"Our superior won't tell us either... Agents' rules."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...You have a point. Why did I even bother asking you? "}]},{"spans":[{"text":"I'm really at my wit's end here."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange taps the table softly. Her fury has slowly subsided as she appears to be deep in thought again."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Athena's Owl..."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That's the bar where we first met. "}]},{"spans":[{"text":"It's also where I met the Commander."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"The one in the Old Town district? That is quite out of the way. "}]},{"spans":[{"text":"It does make for the perfect place for secret meetings."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"It's not that simple... The Earl owns that place. "}]},{"spans":[{"text":"The entire bar is under his control. In other words, that's where we'll find him."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange gets up and starts pacing back and forth."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That's right... We're setting off now. "}]},{"spans":[{"text":"I need to see the Earl. "}]},{"spans":[{"text":"I'm going to ask him what exactly he's planning to do."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"I don't believe this is wise... "}]},{"spans":[{"text":"Ange, surely you know that we're just pawns in his game of chess. "}]},{"spans":[{"text":"No one will ever blame a chess piece for its mistake; they'd just laugh at the player for making a bad move. "}]},{"spans":[{"text":"You've already done all that you can. It might not be a bad idea to just wait and see for now."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Just doing \"all I can\" means nothing, RPK. "}]},{"spans":[{"text":"What I need is results... So long as I'm still on my feet, I will never just watch while things unfold. "}]},{"spans":[{"text":"If I were content with being a chess piece and letting these bigwigs push me around... "}]},{"spans":[{"text":"How would I be any different from Yegor?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Captain Yegor's final struggle did not change his fate as a chess piece."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"He simply lost, but at least he tried. "}]},{"spans":[{"text":"I beat him. If even he tried to fight back, then that's also the least I can do."}]}]},{"sprites":[{"prefab":"RPK16","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"No wonder we're called Task Force DEFY~"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RPK-16 smiles sagely. She shakes her head and stops trying to talk Ange into changing her mind."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Now that we're all in agreement, get 15 and 94 here. "}]},{"spans":[{"text":"Light, you're also coming with me."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Right."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange takes her coat off its hanger and flings it over her shoulders, then makes for the door with determination in her eyes."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_Bar","raw":"BIN"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"Athena's Owl\"."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bam! "}]},{"spans":[{"text":"Ange slams her bionic fist down on the bar table, causing the wooden surface to crack."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Where is the Earl?"}]}]},{"sprites":[],"ops":[],"speaker":"Barkeep","narrator":false,"pages":[{"spans":[{"text":"I don't know what you're talking about..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Don't play dumb. "}]},{"spans":[{"text":"I'm asking you—Where. Is. Griffin?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The bar looks very different from Ange's two previous visits. "}]},{"spans":[{"text":"Apart from Ange, Light, and the DEFY Dolls, the only person in here is a member of the staff. "}]},{"spans":[{"text":"She was prepared to have Light send away all unrelated bystanders, but things appear to be much simpler. "}]},{"spans":[{"text":"Ange eyes the bartender before her and sneers."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Reaching for that gun under the counter? "}]},{"spans":[{"text":"Wanna bet which of us will get to it sooner?"}]}]},{"sprites":[],"ops":[],"speaker":"Barkeep","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Listen here."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange leans forward with her elbow planted on the counter."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"This isn't anything personal, and I'm not here looking for trouble. "}]},{"spans":[{"text":"You've seen me before. I met the Earl here. "}]},{"spans":[{"text":"I just want to get in touch with him because there's is something important that I wish to discuss. "}]},{"spans":[{"text":"If I don't get to him fast enough, there could be catastrophic consequences that neither of us can live with. "}]},{"spans":[{"text":"Do you understand?"}]}]},{"sprites":[],"ops":[],"speaker":"Barkeep","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The bartender stares at Ange and shakes his head."}]}]},{"sprites":[],"ops":[],"speaker":"Barkeep","narrator":false,"pages":[{"spans":[{"text":"I have no idea what you're on about."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Well, this isn't going anywhere... 15?"}]}]},{"sprites":[{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"The hidden chamber is to the left. There is a massive empty space behind the second wine rack."}]}]},{"sprites":[],"ops":[],"speaker":"Barkeep","narrator":false,"pages":[{"spans":[{"text":"What...?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh! "}]},{"spans":[{"text":"The bartender blanches. With a whoosh, he lets go of the glass he's cleaning and reaches under his counter."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Crack! "}]},{"spans":[{"text":"But Ange is faster. Her powerful bionic arm punches right through the counter and grabs the pistol that is taped to the underside."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What did I tell you?"}]}]},{"sprites":[],"ops":[],"speaker":"Barkeep","narrator":false,"pages":[{"spans":[{"text":"This...!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light swings himself over the counter and starts inspecting the location that AK-15 pointed out."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_door_storehouse","raw":"SE1"}],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Found it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He pulls at a wine bottle that seems to be fixed to the rack and gives it a turn, and the rack retracts to reveal an opening in the wall."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"How old-school... "}]},{"spans":[{"text":"If it weren't for 15, no one would've thought to look for this kind of mechanism."}]}]},{"sprites":[],"ops":[],"speaker":"Barkeep","narrator":false,"pages":[{"spans":[{"text":"You'll regret this."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I've been living in regret for many years. "}]},{"spans":[{"text":"Over all the things I didn't do."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud! "}]},{"spans":[{"text":"After knocking out the bartender with the butt of her gun, Ange follows Light into the secret passage."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light 