{"name":"-44-A3-3","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2020summerOffice","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Ange's temporary hideout."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Well?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"It's no good. "}]},{"spans":[{"text":"J ran the DNA samples we collected through our database but there wasn't a single match. "}]},{"spans":[{"text":"All their criminal records are clean, and they have no medical history on file. "}]},{"spans":[{"text":"I'm afraid...they're unregistered population from the Yellow Zone."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What about the two Nyto bodies?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"They have been inspected and an autopsy is underway. "}]},{"spans":[{"text":"But...we haven't discovered anything worth mentioning."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}},{"pref