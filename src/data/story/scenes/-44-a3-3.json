[{"text":"Ange walks up to the wall and traces the roads with a finger. "}]},{"spans":[{"text":"Many intelligence officers must have gathered here in the past and created a large web using pins and strings. "}]},{"spans":[{"text":"She can still see the numerous marks they have left on the map."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her eyes fall on one particular spot on the map. "}]},{"spans":[{"text":"It is circled in red and labeled \"Angelia\"."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"A luxury residential area? "}]},{"spans":[{"text":"Why is it labeled with your name?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...The mansion."}]}]},{"sprites":[{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"The mansion. "}]},{"spans":[{"text":"The mansion is here."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"I see... I see now."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"It...It's been here all along. "}]},{"spans":[{"text":"The Earl... He knew, but he never told me."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This asshole..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange clenches her fists but soon unclenches them."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Just as well. "}]},{"spans":[{"text":"Now we have a new lead."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"I still think this isn't wise, Ange. You're just like a moth hurtling straight towards a flame."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Enough already... Stop giving me unsolicited advice like AK-12. I've made up my mind."}]}]},{"sprites":[{"prefab":"RPK16","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Really? Alright then. "}]},{"spans":[{"text":"...I suppose there's no stopping you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RPK-16 shakes her head. "}]},{"spans":[{"text":"She looks at Ange, then at the map on the wall. "}]},{"spans":[{"text":"Her eyes twinkle with sinister amuseument."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
