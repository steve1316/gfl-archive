 that..."}]}]},{"sprites":[{"prefab":"Weaver","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"I'd like my reward."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Agent smiles and takes a seat opposite Ouroboros. Then, she places a crisp, brand new photo on the table."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"This is your reward."}]}]},{"sprites":[{"prefab":"Weaver","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"You... "}]},{"spans":[{"text":"You're not..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"While everyone else wore smile in the photo, Ouroboros looked out of place with her annoyed expression."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"Welcome home, Ouroboros."}]}]},{"sprites":[{"prefab":"Weaver","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"You..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The critically damaged Ouroboros finally passes out, unable to hold on any longer."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Well, what are you waiting for? Do it. "}]},{"spans":[{"text":"She's so badly