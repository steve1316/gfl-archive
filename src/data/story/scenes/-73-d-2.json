{"name":"-73-D-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2024AB_Ware","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a deserted warehouse on the western plains of the valley, Dark Zone."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"There's no dust. The marks of heavy items dragged across the floor are still fresh. They haven't been gone long."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The warehouse is now empty of cargo. All that remains are some bare shelves and cardboard boxes, left scattered without care."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a small side room, there's still a kettle full of water on the stove. A dry teapot sits on the nearby table."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"They must've been about to make tea, but didn't wait for the water to boil."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Left in a hurry, huh."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The documents our client wants are supposedly in the basement safe. Let's find them first."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"},{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"202408_Room","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The three descend into the basement. It's damp and dimly lit. The small room holds just a few simple tables and chairs. There are torn marks on the walls where papers once hung."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"They destroyed everything before leaving and left no evidence behind. Are they hiding from someone?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"This whole region is just scattered settlements. No major power has taken an interest, so it's been left to fester."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"That's why so many small gangs gather here. No one's big, they rise and fall overnight. It's chaos. Hard to tell who this warehouse belongs to... or who they're afraid of."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Using the code provided by the client, the Commander opens a hidden safe behind a painting on the wall."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside is a sealed brown envelope, marked with tamper-proof tape."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's go. Time to hand it over."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Aren't we going to take a look?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro eyes the folder in the Commander's hand, itching to open it."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"In the Dark Zone, information is power."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"So is knowing when not to be curious..."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Wait—look here. Isn't this the Sewer Rats' emblem?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro snatches the envelope and flips it over, pointing to a stamp in the corner—two rats gnawing on a wad of cash."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Didn't expect to run into your rivals. No reason not to open it now, right?"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"},{"type":"background","value":"2024AB_Ware","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"...Pages upon pages. Files on the Sewer Rats... gold mines. Doss... Karven. Cargo ships..."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"What does all this mean?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Back upstairs, the three of them sit in a clean corner of the warehouse, spreading the documents out to examine them."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_File_Put","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"So many contracts, invoices, financial records. Overwhelmed, Mityl sets down the one in her hands."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"If it's sealed in a safe, marked, and retrieved by a third party, it must be something dirty."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander keeps flipping through the files, searching for links among the various forms and papers."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"These show that Doss is offering protection to the Sewer Rats and helping them with human trafficking."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"In return, the Sewer Rats give back 80% of their profits, handled through a subordinate of Doss' named Karven."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"80%?!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"They're skimming that much off the top?!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"They only take that much probably because the Sewer Rats are relatively big."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"\"Only\"?! That's insane!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Sure, what they're doing is illegal, but the cut is outrageous..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl grabs several contracts, her eyes wide as she searches for any sign that this could be fake."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Calm down. That's the Antonio family we're talking about."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"In the Dark Zone, if you want to do shady business, you can offend Blackgold Universal, but not Doss."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Getting 20% is better than getting nothing."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0%%range=3","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl slumps to the ground, defeated. One of the pages slips from her hand, landing near the Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Hm?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander picks it up. It's stamped with the emblems of both parties. They study them incredulously."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Beluga said the stuff they left us was all taken from Doss. Some had the Antonio family crest on it... If I remember correctly..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander points at the stamp."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Isn't this one missing a leaf?"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"I think... you're right!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Whoa! This is huge!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Someone's pretending to be the Antonio family and impersonating Doss! That's a death wish!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"So when Doss said he didn't know about the boat... he was telling the truth?"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.2","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander gathers the scattered papers and reseals the envelope carefully."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Looks like we'll have to ask that nervous client what's really going on."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"单挑","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outside an inconspicuous-looking villa in northern Floranpino, Dark Zone."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bodyguard","narrator":false,"pages":[{"spans":[{"text":"Only one of you can go in."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Two bodyguards block their path. The three glance at each other. The Commander pulls out the sealed envelope."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'll go."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander raises their hands, letting the guards search them. All weapons and their communicator are placed on a nearby table."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bodyguard","narrator":false,"pages":[{"spans":[{"text":"Collect them on your way out."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander nods to Mityl and Kuro, then steps inside."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Close","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"background","value":"2020summerOrphanage","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The villa's interior is lavish. Genuine leather sofas, ornate rugs, a glittering crystal chandelier—all a stark contrast to the humble exterior."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander studies the place carefully, noting the layout and security as they're led to a small study next to the living room."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A pot-bellied middle-aged man sits behind the desk, waiting."}]}]},{"sprites":[],"ops":[],"speaker":"Client","narrator":false,"pages":[{"spans":[{"text":"You brought it?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The client waves off his men. The Commander hands him the envelope."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He doesn't open it, just inspects the seal."}]}]},{"sprites":[],"ops":[],"speaker":"Client","narrator":false,"pages":[{"spans":[{"text":"Good work. Here's your payment."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He pushes a small briefcase across the desk. The Commander doesn't take it."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Thanks."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The package is delivered. If there's nothing else, I'll be going."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The client says nothing. He waves a hand in dismissal."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander reaches for the briefcase—then suddenly slams it into the client's face. At the same time, they duck, roll beneath the desk, and kick over the man's chair."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The client yelps, caught off guard and temporarily blinded. By the time he recovers, the silenced pistol he was hiding under the desk is already in the Commander's hands."}]}]},{"sprites":[],"ops":[],"speaker":"Client","narrator":false,"pages":[{"spans":[{"text":"Hel—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Staring down the barrel now aimed at his head, the cry dies in his throat."}]}]},{"sprites":[],"ops":[],"speaker":"Client","narrator":false,"pages":[{"spans":[{"text":"What do you want?!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Keep your hands where I can see them."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You weren't going to let me walk out of here anyway. Consider this a small payback."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0%%range=3","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man lies on the floor, clutching his head. His heavy frame trembles, too afraid to move."}]}]},{"sprites":[],"ops":[],"speaker":"Client","narrator":false,"pages":[{"spans":[{"text":"Don't kill me! I have money! You can have everything—everything in this villa!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What's going on between you and the Sewer Rats, Karven?"}]}]},{"sprites":[],"ops":[],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"How do you know... You looked at the files!"}]}]},{"sprites":[],"ops":[],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"If you read them, then you should know I'm with the Antonio family. I'm Doss' man! Touch me, and... heh, how many lives do you think you've got?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"Besides..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Karven's small, beady eyes dart to a spot behind the Commander. A chill of killing intent washes over them..."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"gradientShow","value":"2","raw":"GradientShow"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Been waiting for me, have you?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
