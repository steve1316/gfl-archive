{"name":"-57-C3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2023SAGA_Balcony","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clouds streak across the sky as the evening breeze blows."}]},{"spans":[{"text":"You catch sight of the girl sitting on the bench, her silver hair glinting in the light of the setting sun. Before your brain can react, your feet are already carrying you over to that twilit figure."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're here as well, Junko."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Commander-san... Are you here to watch the sunset too?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah..."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"The past few days must have been hard for you. "}]},{"spans":[{"text":"It can't have been easy to take in the existence of zombies and the Franchouchou concert all of a sudden."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah, but that isn't the hardest part for me."}]},{"spans":[{"text":"At the very least, my mission is clear and my goal is well-defined."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"What IS the hardest part, then?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You point to your heart."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sometimes, it feels empty here, like I'm adrift and alone."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Did you always stay at home in the past?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Not really. I was pretty much running around outside all the time."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Do you have your doubts about being able to go home in seven days?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Not really. Since I could come here, I'm sure I'll be able to go back."}]},{"spans":[{"text":"If I can't do it with the concert, I'm sure there's another way."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"...Pfft, you really are a strong one."}]}]},{"sprites":[],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I just... I'm not worried about things that I can change with action."}]},{"spans":[{"text":"But... I haven't been able to sleep recently."}]},{"spans":[{"text":"That's why I was looking for a place to calm myself down."}]},{"spans":[{"text":"I didn't expect to find you here, though."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Because you're a traveler out of time."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Junko..."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"All the little tricks you learned to improve your way of living are useless, and you can't find a niche in your new environment."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"And so you feel sad and uncomfortable, but that's perfectly normal."}]},{"spans":[{"text":"Being from the past, I can at least find some traces of my past existence."}]},{"spans":[{"text":"But you're from the future, and there is nothing here that you're familiar with. That must be harder to bear."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Now I'm feeling embarrassed that you have to comfort me."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"No, I'm not trying to comfort you."}]},{"spans":[{"text":"Rather... I'm trying to comfort myself."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"As it turns out, I'm not the only one who feels like they can't fit in."}]},{"spans":[{"text":"That makes me feel a little normal now."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Pfft!"}]},{"spans":[{"text":"...Wait, you feel uncomfortable too, Junko?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Mm, yes. I still have trouble getting used to a lot of things, and I have a hard time wrapping my head around them."}]},{"spans":[{"text":"Still, you should be able to adapt a lot easier than me."}]},{"spans":[{"text":"Frankly speaking, even using a computer is quite hard for me."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ah... Me too."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I've never used a computer with such a thick screen before!"}]},{"spans":[{"text":"And... there are lots of things from my time that don't even exist in this world... "}]},{"spans":[{"text":"How should I put it... It's like being used to a calculator, and then having to switch to an abacus."}]},{"spans":[{"text":"I feel so helpless all the time..."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Pffft, well, all you can do is pretend you don't know anything and start from scratch."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah... There's so much work waiting for me, but I know so little."}]},{"spans":[{"text":"It feels like I went from being pretty smart to super dumb all of a sudden."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Let's do it together, then."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Let's learn how to adapt to this era together."}]},{"spans":[{"text":"After all, we're both far from home."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Alright."}]},{"spans":[{"text":"Then... this will be our... Hm... our little secret."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Yes, it's a deal."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sun slowly descends, painting this secret moment a mesmerizing gold."}]},{"spans":[{"text":"These two wayfarers from out of time have found companions in each other."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
