","raw":"同时置暗"}],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"Hmph!"}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"Now that we've taken their money, we should at least offer them something in return. So, who's the target?"}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bodyguard","narrator":false,"pages":[{"spans":[{"text":"No idea."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"shake","raw":"震屏3"}],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"No idea?!"}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bodyguard","narrator":false,"pages":[{"spans":[{"text":"Word is, it's a teenage girl. She suddenly appeared in town, had some kind of run-in with them... They didn't expect her to be so dangerous..."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"Oh? Interesting."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"Send someone to investigate. Don't provoke her yet."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"树林","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"You're Beluga, the one they were talking about?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Something you want?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"Relax. I come in peace. I'm here to offer you a sincere invitation—to join the Antonio family."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Antonio? You're Doss?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"Haha, no. But I'm one of Doss's most trusted men. You can call me Karven."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga eyes the rotund middle-aged man in front of her. He doesn't quite match the fearsome image she'd heard associated with Doss."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bodyguard","narrator":false,"pages":[{"spans":[{"text":"Boss, about that favor we promised the gang—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Karven draws and shoots the bodyguard who whispers the reminder."}]}]},{"sprites":[],"ops":[],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"A little gift, to mark our first meeting."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga smirks coldly."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"Pleasure doing business."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"background","value":"2022saros_CyberCityStreet","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Half a month later."}]}]},{"sprites":[],"ops":[],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"Boss, it's here."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Karven hunches forward as he leads the way. Behind him is Doss, dressed in a tailored suit, cane in hand, flanked by four stoic bodyguards."}]}]},{"sprites":[],"ops":[],"speaker":"Karven","narrator":false,"pages":[{"spans":[{"text":"Watch your step here, there's a ledge."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"