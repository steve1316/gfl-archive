pression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doss","narrator":false,"pages":[{"spans":[{"text":"People should serve willingly. If that's not the case, then forget it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Doss turns to leave with his men. One guard lags behind intentionally, as if this scenario is routine."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud! The sound of something heavy hitting the floor."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Doss glances back from the doorway to see Jim's lifeless body, his neck twisted unnaturally."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Next to him stands Beluga."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"You don't need a gun to kill someone."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"I'm in."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"10213","raw":"BGM"},{"type":"background","value":"2020summerOrphanage","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"sp