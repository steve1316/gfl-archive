y."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...M4 walks ahead alone."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Just pipe down a little, SOP-II."}]},{"spans":[{"text":"M4 is taking it the hardest..."}]},{"spans":[{"text":"And you know how hard she tried to put on a happy face in the recording for the commander yesterday."}]},{"spans":[{"text":"After all...she feels the most guilty for what happened..."}]}]},{"sprites":[{"prefab":"m45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"m45","narrator":false,"pages":[{"spans":[{"text":"Um... Miss M4, dinner is ready."}]},{"spans":[{"text":"Would you like to dine in the cafeteria or should I bring it to your quarters?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Cinnamon rolls again?"}]}]},{"sprites":[{"prefab":"m45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"m45","narrator":false,"pages":[{"spans":[{"text":"Apologies. Ingredients are limited at the detention center. Cinnamon rolls and sandwiches are all I can make."}]},{"spans":[{"text":"I'm working hard on improving the recipes and will try to dish out something new tomorrow."}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Uh... So it'll still be bread..."}]}]},{"sprites":[{"prefab":"m45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"m45","narrator":false,"pages":[{"spans":[{"text":"Deepest apologies. Due to security concerns, HQ has restricted the resources coming in and out of the detention center..."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"si