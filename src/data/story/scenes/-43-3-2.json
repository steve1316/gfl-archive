":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"According to the game manual I read, it seems there are even more powerful enemies than this. "}]},{"spans":[{"text":"...Looks like I need to meet up with the others ASAP."}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"As long as we're around, it doesn't matter what kind of enemies they are!","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"But the important thing is that you need to get here quick, Vivi! We can hardly wait!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Agent, I've remotely hacked into the computers in the control room. The automated weapons along the way should have stopped scanning for hostile targets.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"You should leave before the enemy notices something is wrong...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"I will..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-RuinedCity","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After reaching the surface through the emergency passage, the first thing that Vector sees are the fallen ruins of a tall bridge."}]},{"spans":[{"text":"It forms a slope, and as she looks across the expanse, she can see the clock on the roof of Grand Central Terminal, illuminated by the ground lights."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Grand Central Terminal..."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"It's the hub of Manhattan's traffic, or at least it used to be.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"(Sighs) It all happened so fast...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100","commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"R93","narrator":false,"pages":[{"spans":[{"text":"Am I imagining things, or is she being sentimental?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"Even though she's an AI simulation, humans and Dolls don't experience joy and sadness in the same way.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"...If we had enough time, I'd like to help her too.