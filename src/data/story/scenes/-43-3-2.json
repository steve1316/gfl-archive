{"name":"-43-3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"GF_xDivision_Scene2","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Sewer","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vector sprints through the subway station platform. After she disables the last of the rogue agents with the flashbangs she threw out, she empties her magazine in their direction."}]},{"spans":[{"text":"In the wake of the gunshots, the man before her who's breathing heavily through his gas mask collapses to the ground."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"That's them taken care of..."}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"Well done, Vivi!","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"If we weren't waiting to meet up, I'd like nothing more than to rush over and help you!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"I told you, I don't want more casualties, and these guys are still manageable."}]}]},