:"关闭火花"},{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Unfamiliar S.F. Doll","narrator":false,"pages":[{"spans":[{"text":"Oh dear, just a bit too late, M16. "}]},{"spans":[{"text":"We aren't able to break down the door... What a shame—"}]}]},{"sprites":[{"prefab":"Beak_M16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"MachineGunBurst","raw":"SE2"},{"type":"sfx","value":"Gunfight","raw":"SE1"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"Unfamiliar S.F. Doll","narrator":false,"pages":[{"spans":[{"text":"My, my, don't Griffin Dolls have any manners at all?"}]}]},{"sprites":[{"prefab":"Beak_M16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Sangvis Doll deflects the bullets AR-15 fired at M16 with a casual flick of her right arm."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Beak_M16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"(She blocked the bullets with just an arm...)"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"What are you doing, AR-15? "}]},{"spans":[{"text":"Isn't that a member of the AR Team...?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Not anymore. "}]},{"spans":[{"text":"She stopped being our friend the moment she decided to join Sangvis Ferri. "}]},{"spans":[{"text":"The AR Team...is now nothing more than an empty shell."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left",