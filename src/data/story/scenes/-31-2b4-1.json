aker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Drop your weapons before my forces smash you to pieces."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Why should I?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"That's an order. An order sanctioned by absolute superiority in strength. "}]},{"spans":[{"text":"If you don't want to be reduced to a pile of scrap metal, obey me."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Do not hesitate, and do not think about resisting. "}]},{"spans":[{"text":"You aren't in the position to do so."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"AR-15, we're running out of ammo. If we fight them, the probability of our survival is zero...","style":{"co