ans":[{"text":"Tsk..."}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"As the saying goes, old friends make the worst enemies. You sure know your former teammate very well."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Humph, follow me. But I can't guarantee if I'll remember the way."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You will."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 points her gun at AN-94."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You'd better find the way, for the sake of your new friends as well as your old ones - before OGAS starts to get worse."}]}]}]}
