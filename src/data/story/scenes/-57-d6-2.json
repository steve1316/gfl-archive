rator":false,"pages":[{"spans":[{"text":"Before you can recover from your shock, you see Tae grab Ai, Junko, Lily, and Yugiri one after another. Even Romero is included."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Tae... I can't believe you had such a clear plan in mind..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"However, the other girls are nowhere as clear-minded as she is."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Saki-chan, what the heck are you doing? Why are you riding your bike on my Christmas tree!"}]}]},{"sprites":[{"prefab":"NPC-Saki","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-190","spriteScale":"1.4"}}],"ops":[],"speaker":"Saki Nikaido","narrator":false,"pages":[{"spans":[{"text":"Haha? This is a balance beam that Tae gave me!"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Nonsense! This is material for Lily to make wooden stars with!"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Goodness... That's enough arguing out of you. Allow me to finish making hairpins out of it."}]}]},{"sprites":[{"prefab":"NPC-Romero","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,240","spriteScale":"1.25"}}],"ops":[],"speaker":"Romero","narrator":false,"pages":[{"spans":[{"text":"Arf-arf-arf! (He bravely stands up to fight for his future doghouse.)"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,