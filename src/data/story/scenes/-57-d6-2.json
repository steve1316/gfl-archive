oint thinking so much about it. We'll make it up as we go along."}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,-290","spriteScale":"1.3"}}],"ops":[],"speaker":"Tae Yamada","narrator":false,"pages":[{"spans":[{"text":"Mnhurgh...? (She looks at you in confusion.)"}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,-290","spriteScale":"1.3"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let me give you a hand."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You roll up your sleeves and help Tae pick up the tree trunk."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2023SAGA_Villa_N","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as your strength is about to give out, you manage to get the tree to the open space in front of the mansion."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm so tired..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"bgm","value":"BGM_Saga_AVG_Day","raw":"BGM"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"You're back at last!"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"This is..."}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-290","spriteScale":"1.3"}}],"ops":[],"speaker":"Tae Yamada","narrator":false,"pages":[{"spans":[{"text":"Ahhhh! Nghhhaahh! (Sh