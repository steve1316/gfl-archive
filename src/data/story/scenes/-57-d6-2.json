:"Commander","narrator":false,"pages":[{"spans":[{"text":"Why don't we just leave it here until we all decide what we want to do with it?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"According to the meteorologist, there will be heavy rain tonight. This piece of lumber will be a write-off if we leave it here unattended."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"It could have been a lovely Christmas tree..."}]}]},{"sprites":[{"prefab":"NPC-Romero","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,240","spriteScale":"1.25"}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Romero","narrator":false,"pages":[{"spans":[{"text":"Arf-arf-arf-arf! (He seems to be speaking up for his doghouse.)"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Your solution is nowhere closer to resolving the dispute. Just as it seems everyone is going to start fighting again—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Saw_Door","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vrm—"}]},{"spans":[{"text":"Vrrrmmvrrmmm—"}]},{"spans":[{"text":"The menacing sound of a chainsaw revving up comes from behind your back."}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=2%%delay=0.1%%range=15","raw":"controll_shake"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"T-Tae?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Wonder","raw":"SE1"}],"speaker":null,"narrator":false,"pages