rator":false,"pages":[{"spans":[{"text":"The Blackgold operative who tried to argue earlier hangs back, and just when everyone lowers their guard, he raises his weapon and fires at Kuro, who is the closest to the box."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro dives and rolls aside just in time, dodging the incoming rounds. However—"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She's too close to the cliff's edge. The bullets force her back step by step until she slips and falls."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"AAAAH!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hold on!"}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=50000%%delay=0%%range=1","raw":"controll_shake"},{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The safety rope linking Kuro to Mityl and the Commander snaps taut, yanking them toward the cliff."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander can't keep their footing and gets dragged forward."}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=2%%delay=0%%range=3","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the back, Mityl clamps her hands around the rope, straining against the pull, her body arched to the limit as she slides several meters, trying to stop the fall."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Zipper","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's hands scrape across the rock, leaving blood in their wake before they finally grab a patch of wild grass on the edge, just enough to hold."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Are you okay?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dangling from the cliff, with only their arms keeping them up, the Commander glances down."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"I'm okay!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Suspended in mid-air five meters below the ledge, Kuro sways dangerously with nothing but the rope to support her."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"What are you doing? We already won the bet!"}]}]},{"sprites":[],"ops":[],"speaker":"Blackgold Operative","narrator":false,"pages":[{"spans":[{"text":"Captain, the box is safe! They can't use it to threaten us anymore. We should grab it and go while they're distracted."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Blackgold Operative","narrator":false,"pages":[{"spans":[{"text":"...If their box is real, we can't let them go so easily."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate stays silent. She watches the three figures hanging by a single rope, fighting to stay alive, then looks toward the box resting quietly at the edge of the ledge."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The operative urges her again. The others hesitate, but clearly, they're tempted too."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"You promised!"}]}]},{"sprites":[],"ops":[],"speaker":"Blackgold Operative","narrator":false,"pages":[{"spans":[{"text":"Captain!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate walks up to the box. The operative's eyes glint in triumph. Meanwhile, Mityl clings desperately to the rope, unable to move, helpless to intervene."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Hurry!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Still dangling off the cliff, the Commander tries desperately to climb up, but Kuro's weight makes it impossible."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Unexpectedly, Hecate doesn't touch the box. She walks to the cliff's edge and stands in front of the Commander."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"The scene feels all too familiar."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's legs flail in the air as they struggle to find a foothold on the steep rock wall—only to send pebbles tumbling down. They glance up at Hecate and crack a tired grin."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah... Definitely getting a sense of déjà vu."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"10295","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"2024AB_Hecatec","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Four years ago."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Don't hurt the hostage."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander and Hecate have just cornered a group of retreating kidnappers on a cliff. Three are down, while one remains."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Kidnapper","narrator":false,"pages":[{"spans":[{"text":"Don't come any closer! Or I'm taking him with me!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The last kidnapper has the unconscious hostage tied to him. In his right hand is a paratrooper knife, its blade pressed firmly against the safety rope."}]}]},{"sprites":[],"ops":[],"speaker":"Kidnapper","narrator":false,"pages":[{"spans":[{"text":"Let me down safely."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They're still 50 meters above the ground. If they fall, the hostage won't survive."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Stay calm."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate gazes at the infrared laser point hovering on the kidnapper's face."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bullet_Hit_Body","raw":"SE1"},{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! A gunshot cracks through the air. A sniper bullet has taken him clean. His hand falls open, losing grip on the knife."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander smiles, pulls out a flashlight, and signals downward with a series of long and short flashes."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A familiar voice responds from below."}]}]},{"sprites":[],"ops":[],"speaker":"Old Friend","narrator":false,"pages":[{"spans":[{"text":"Heh! I'm coming up."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Care to explain?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Old war buddy."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We planned this—