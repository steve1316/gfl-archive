{"name":"-73-A-22","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"10299","raw":"BGM"},{"type":"background","value":"2024AB_Hecatec","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We won."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the ledge halfway up the mountain, the Commander, Kuro, and Mityl stand victorious over Hecate and her Blackgold squad."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The battle ends. The box is pulled up and set aside."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"We actually won!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hahahahaha... I told you... cough... told you we're strong!"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Hecate","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"You may leave."}]}]},{"sprites":[],"ops":[],"speaker":"Blackgold Operative","narrator":false,"pages":[{"spans":[{"text":"Captain—"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB",