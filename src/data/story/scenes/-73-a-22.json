","raw":"BIN"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_flag","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They're falling..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander feels their body plummeting through the air, but their soul seems to float free."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They see their friend's face—a twisted mix of excitement and fear. The bloodied paratrooper knife in his hand must have slipped during the cut, slicing his own hand in the process."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I was wrong.","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander shuts their eyes."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Then—suddenly, they stop falling."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A tremendous force tugs at their right arm, halting their descent."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander opens their eyes. Hecate is gripping them tightly from just below the cliff edge."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":