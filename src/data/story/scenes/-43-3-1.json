 are internal conflicts among your people."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Well, I'd prefer to call them disagreements.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"But I didn't expect that sort of thing to happen...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"And twice, too! Dammit, I thought I had them under control...","style":{"color":"#00CCFF","size":"30"}}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Twice? What happened?"}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Ahem! That's not important.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I'm telling you this because I believe you're not the same as those traitors. We've taken steps toward the righteous path, so someone has to keep walking down it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"Oho, what's this? Was someone introducing the game's plot?","style":{"color":"#00CCFF"}}]}]},{"