r":"#00CCFF"}}]}]},{"sprites":[{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100","commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"How are things on your side?"}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"We were just about to look for you, but we found an entrance to the Dark Zone before that.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"The surroundings are fairly safe, but two people from one of the other teams were eliminated here. Thanks to them, we scored some explosives.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Maybe we could make this a meetup point, but we'd like to know where you are and how long it'll take for you to get here.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"I'm in the subway section of Grand Central Terminal. According to the map, it would be faster to reach a Dark Zone entrance from here, but..."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"There are enemies camping out here, probably to wait out the storm, so getting past them won't be easy.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Indeed, so just to be on the safe side...hm?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"background","value":"BG-Sewer","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as Vector is about to go around them, the tracks around her suddenly erupt in a series of explosions."}]},{"spans":[{"text":"The tremendous shockwaves cause the ceiling overhead to collapse. Sensing danger, Vector immediately dodges the cascade of concrete chunks that crash into the ground with heavy booms."}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"Vivi?! ","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Was that an explosion just now? Are you alright?!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"...I'm fine."}]},{"spans":[{"text":"But the electrical circuits in the subway were destroyed and it's a little dark here. Give me a while to check things out."}]}]},{"sprites":[{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100","commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"R93","narrator":false,"pages":[{"spans":[{"text":"...What's the situation?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100","commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"The subway entrance has been sealed off by fallen slabs of concrete."}]},{"spans":[{"text":"I'm not trapped here, but...it looks like I'll have to pass through the enemy hideout."}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"Man, if only we hadn't split up, we might be able to help you out.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"The enemies here are a piece of cake. No need to worry."}]}]},{"sprites":[{"prefab":"NPC-Dima","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Dima","narrator":false,"pages":[{"spans":[{"text":"Er, Agent, just a heads-up for you...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"A group of troublesome people just showed up. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Troublesome people?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"},{"type":"bgm","value":"GF_xDivision_Scene3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Several powerful flashlight beams sweep through the darkness before Dima can elaborate."}]},{"spans":[{"text":"Vector reflexively ducks behind the cover created by the fallen concrete. Through the gaps, she can see several armed and dangerous-looking men searching the surroundings."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"sid