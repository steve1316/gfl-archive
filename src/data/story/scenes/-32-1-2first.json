{"name":"-32-1-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"Desert","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"m_va_digital_drive","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The chase continues, with Dana and Architect's cars neck to neck. The White Knights are behind them."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Dana! Ahead of you! It's a cliff!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Hehe, you just won't let me go, will you?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Of course, you're my final prey — Can you hold on tighter, shorty?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"What what what what what are you going to do!?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Exactly what you have in mind! That's right, you guessed it!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I told you there's a cliff up ahead! Are you insane!?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"You're a Doll, so what if you get broken in the fall?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I'm worried about YOU! Who's going to get me out of here after this!?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Don't worry, I know what I'm doing! Hang on!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Still not going to brake, human? I'll bet three backup bodies that my reflexes are faster than yours, and I can afford that bet too!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"I agree, you'll definitely beat me in a game of chicken...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But I don't intend to brake.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"shake","raw":"震屏"}],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"What—!?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Darling— "}]},{"spans":[{"text":"Are you ready to go to hell with me?"}]}]},{"sprites":[],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"AAAAAAAHHHHHHHH!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bang! "}]},{"spans":[{"text":"Dana's car crashes into Architect's, and both vehicles plunge off the cliff together."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Cough cough… Cough... "}]},{"spans":[{"text":"Dammit... Dana! Dana, where are you!?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Beep- beep-","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Sorry, but the user you have called is not in network range.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"...! "}]},{"spans":[{"text":"Architect! Cough cough..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"Desert","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Architect dusts herself off and adjusts her hair."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"That was pretty fun, kiddo. But a single native and a shorty like you aren't enough to catch me. "}]},{"spans":[{"text":"Now get out of my way, I've got a job to do."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Super-Shorty struggles to her feet and raises her weapon."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"First off, don't call me short again. "}]},{"spans":[{"text":"Second, I won't let you leave this place."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Oh? Have I snatched you before?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I don't remember, but I only remember that I hate you..."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Isn't that ridiculous? I could understand if you hated Executioner, as she's always owed people money. "}]},{"spans":[{"text":"But me? I'm a good girl who's done no harm to man or beast. I've never hurt anyone before! "}]},{"spans":[{"text":"Now, get out of my way or I'm really going to get mad."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"...Dream on."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"(Sigh) I don't like opening fire at this range, but that doesn't mean I won't. "}]},{"spans":[{"text":"You asked for this, kiddo—"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bang! "}]},{"spans":[{"text":"... Thud! "}]},{"spans":[{"text":"...Architect wobbles, then collapses."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Whew... you alright, shorty? "}]},{"spans":[{"text":"I knew carrying a baguette on me would end up coming in handy someday."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"You...took down a Doll with a loaf of bread?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"French, with sesame seeds added. "}]},{"spans":[{"text":"Come on, shorty. You did well, but don't take a risk like that in future."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I don't know why, I don't understand why I hate S.F...."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Haha, who knows, you might really have been a White Knight in the past, hm?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"We don't have midgets like her among the White Knights."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_va_troubling_news","raw":"BGM"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"You're late again, Jericho. Did your cars get all clogged up with sand?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"It's because we took a saner route."}]},{"spans":[{"text":"I'm getting used to seeing you in all kinds of godforsaken places, Dana."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Well, I'm not used to seeing the White Knights show up, especially when they've got the same target as me."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"We usually classify actions like yours as...\"obstruction of police business\"."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Really? I'd call it \"friendship\"."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Only humans would believe in that sort of nonsense. What I want is something more concrete."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Jericho kicks the unconscious Architect."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"The target's head is intact. Take her back to the vehicle and scan her memory module. "}]},{"spans":[{"text":"We've finally seized the last S.F.."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"My car's a write-off. Would you mind fronting me a few Repair Fairies as payment? Thanks would be nice too, by the way."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"First off, this isn't your vehicle. Secondly, you showing up messed up my plans, and let's not talk about how I'm going to arrest you if your strike to her head ended up damaging her memories. "}]},{"spans":[{"text":"Dana, aren't you aware that the martial law specifies to not engage and hurt another party?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"So what did Architect do?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Isn't being who she is enough to get arrested? And who is this midget anyway?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Don't call me a midget!"}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"The natives have been forbidden from personally employing Dolls since a hundred years ago, Dana. Have you done the relevant paperwork?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"I picked her up just now. She can't remember who she is, and I couldn't just leave her there for S.F.."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"That's good, so you won't mind parting with her for a bit, then?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Oi, she didn't absorb too much sunlight."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Dana, we're the cream of the White Knights' Unit 765, the Blitzkrieg Corps. We don't care about Dolls taking in too much sunlight. "}]},{"spans":[{"text":"What I'm concerned about is the fact that any Doll from the outside who made contact with S.F. might be infected with the \"Parapluie\" virus."}]},{"spans":[{"text":"Moreover, we have no idea of her origins. I need to have my people take her to our Griffin City base for a checkup."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"The \"Parapluie\" virus?"}]}]},{"sprites":[],"ops":[{"type":"background","value":"3X","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"It's an electronic virus carried by S.F.. Once it infects a Griffin Doll, the supreme leader of Sangvis Ferri — the Mastermind \"Elisa\" — will be able to freely control them, as though they were a S.F. unit."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Our unit's ultimate mission is to capture Elisa and put an end to the days of Sangvis Ferri menacing Griffin City once and for all. "}]},{"spans":[{"text":"The S.F. we captured before didn't hold any intelligence about Elisa, but now, the last S.F. has fallen into our hands. I'm sure the information we need is in her head. "}]},{"spans":[{"text":"If we're lucky, we'll be able to capture Elisa today and end their reign of terror, but we need to perform the standard checks just in case."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"Desert","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"I wish you good luck in advance, Jericho. Also, can I accompany her back to the base?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Have you really only known each other for an hour? You sound more like her big sister."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"This is just how we natives are. Don't need to build affection or whatnot. We do what we feel like. And besides, she's as cute as my imouto!"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"I understand. It's just like how I still don't find myself liking you despite having known you for so long."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"You really are a stick in the mud as always, Jericho. "}]},{"spans":[{"text":"But I quite like you, mainly when you're fighting to get me paid."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"(Sigh) As I've said before, you're interfering with police business... "}]},{"spans":[{"text":"In any case, it's up to the Prime Minister in how we deal with her. Let me give her a call."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Relax, shorty. It's just a routine physical check. "}]},{"spans":[{"text":"You'll only have to take off your coat at most. It's very likely you'll be able to keep your skirt on."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I'm not scared! "}]},{"spans":[{"text":"It's just...so much is happening at once, I'm not too sure what's going on..."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"You'll be fine. Griffin City might be a mess, but at least it won't eat you like the sand."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Alright, congratulations, Dana."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"You've secured a gigantic payout for me?"}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"You and the kid can take my car back, and once the checkup's over you can take her home. That's the payment I managed to negotiate for you."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"I wouldn't be surprised if that was the Lilim Prime Minister's idea of a generous reward."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Be content with it. The Prime Minister's been incredibly busy recently, and you're getting a ride from the world's elite White Knight unit. Hey, someone, get over here and clean up the scene."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Will we be going to Griffin City now?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"That's right, even though you still don't remember anything... "}]},{"spans":[{"text":"Although, that would definitely be a good thing in Griffin City."}]}]}]}
