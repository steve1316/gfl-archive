{"name":"-57-W6-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Beach","raw":"BIN"},{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The night wind is brisk as you walk with Yugiri on the beach, listening to the sound of the waves lapping on the shore."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"...So you're not an idol manager in the Griffin Base, Commander-han?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No, I'm not. Granted, we do have some Dolls who used to work in the idol business, but my job doesn't cover that sort of thing."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Then you really are amazing, considering how you've learned to be an idol manager in just a few short days."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"And you're a good one, no less."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm going to get all swollen-headed if you keep praising me like that, you know."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Fortunately, the night is dark and Yugiri cannot see your face."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"In that case, what kind of work did you do in the Griffin Base?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I commanded T-Dolls in battle, managed the base's daily operations, as well as... some other things."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"While I'm not too sure what exactly that all covers, keeping an entire base running must be quite difficult."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Well, my schedule would be quite packed every day, and there were times when I had to go abroad for assignments for an extended period of time."}]},{"spans":[{"text":"But I think it's worth it to become the shining beacon in a brave new world."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"A shining beacon in a brave new world..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri comes to a halt and turns to you. However, she is not looking at you, but through you, toward a distant place far, far away."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Once, I had a friend who said the same things you did."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Did your friend also fight ceaselessly to make the world a better place?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Ah, no, his ambitions weren't nearly as grand."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"He just... He just wanted Saga to prosper again."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It doesn't matter how grand or petty his ambitions were. Someone with the will to change the world will receive recognition and support."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A sad smile crosses Yugiri's face."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Commander, why do you want to be the shining beacon in a brave new world?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Where I live, a great power originates from what we call the Relics. This power is beyond the control of humans for the time being."}]},{"spans":[{"text":"Thus, people are fighting each other to seize these Relics. Some people fear them and want them to be buried forever. Others covet their power and seek to claim it for their own."}]},{"spans":[{"text":"The world is engulfed in endless conflict because of them."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"What about you, Commander?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"What would you do if you had such power? "}],"choices":["Control and use it.","Bury and destroy it.","Leave it alone."]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I would use it for my own purposes."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"And how would you make use of such great power?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I would stop all wars and conflicts and help those afflicted by ELID return to their normal lives."}]},{"spans":[{"text":"Where we come from, being able to live a day like you do in present-day Saga is a luxury."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri lowers her head in thought."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Stopping wars and conflict has never been an easy thing."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It wasn't. It will never be."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"But you are resolved to do it."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes. Just like how, when I first joined Griffin, I wanted to become the shining beacon in a brave new world."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I want to destroy that power. It is too strong and causes people who possess it to lose their minds. It also makes those who don't have it burn with desire for it."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"You... don't wish to wield such power?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"If I had it, it could make all my wishes come true."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But happiness that is easily obtained is not true happiness."}]},{"spans":[{"text":"I sometimes think that there is no true happiness in this world."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"So happiness is merely an illusion, and it can only be attained on the road to seeking it?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes. Once you have it, you won't value it, and it won't be as attractive as it was when you set out to obtain it."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"I didn't think you were such a seeker, Commander."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"It is a thorny road, after all."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I have always wanted to be the shining beacon in a brave new world."}]},{"spans":[{"text":"But I am also aware that I may never achieve it, and I am prepared to accept that."}]},{"spans":[{"text":"Even so, I will continue walking down this path, until I can walk no further."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I don't want to use it, and I don't want to destroy it."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"So you will simply leave it by your side and ignore it?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"3","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If I do nothing, then those who covet it won't dare to do anything."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"So the sword is most threatening before it leaves the sheath?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"3","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Precisely."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"But if you do that, you will become an eternal guardian, ensuring it never falls into the hands of others."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"3","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I am willing to pay that price if I can achieve my goal."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"I see."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri looks solemnly into your eyes. Her gaze returns from the distance and rests on you."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"I will support your ambitions with all my strength. If there is anything I can do for you, please let me know."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yugiri..."}]},{"spans":[{"text":"Just hearing those words from you is enough."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"In the past, I once helped a dear friend fulfil his dream to make Saga prosper anew."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"I see something of him in you. You are just like him, someone who sincerely wishes to make the world a better place."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"I hope your wish will come true, and to that end, I am willing to do anything I can to help you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri takes your hand, and you can feel the countless years flowing through her body."}]},{"spans":[{"text":"Though she endured many hardships, she never gave in to them."}]},{"spans":[{"text":"She did not admit defeat then, and she will never admit defeat ever."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"And so, you squeeze her hands."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Here's to becoming the shining beacon in a brave new world."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
