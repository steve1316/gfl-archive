e,"pages":[{"spans":[{"text":"Lily, go somewhere safe and wait for me."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before you can take more than a couple of steps toward him, Lily senses your intentions and grabs your shirt from behind."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"You've made a mistake..."}]},{"spans":[{"text":"He's just here to pay his respects."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily stands aside and reveals a child-shaped statue in the grass behind her."}]},{"spans":[{"text":"Someone has offered a piece of bread to it, spread thickly with mayonnaise and ketchup."}]},{"spans":[{"text":"Apparently that man did it."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You know him, Lily?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Mm, we used to come to the market together. He would buy me cute dolls, and we'd share the same kind of bread..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ehhh?!"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"That man... is Lily's Pappy."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"These two look nothing alike!","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Lily looks more like Mommy, but my Pappy raised me..."}]},{"spans":[{"text":"He might look mean, but he's actually a really nice person."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You scratch your head in embarrassment."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm sorry, I lost my cool the moment I saw you cry..."}]},{"spans":[{"text":"I should have asked why you were feeling sad."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Sad? Lily wasn't feeling sad..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Why would Lily feel sad? Just being able to see Pappy again, being able to walk through the market with him again, that's enough for Lily."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She's still smiling, but she averts her eyes from you."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Then... did he recognize you, Lily?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Actually, Pappy was lost in his thoughts, and Lily just followed him secretly..."}]},{"spans":[{"text":"But that's fine. If Lily ended up alone with Pappy, Lily would probably reveal herself by accident, and that would be troublesome."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"So you didn't say anything to your dad?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Mm. But it's okay. Lily has already told all the things Lily wants to tell Pappy on stage..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"It's strange, the stage is so far away from the audience, but Lily feels that she is closer to Pappy than ever before."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"That's why Lily will continue getting along with Pappy as Franchouchou Member No. 6."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily wipes away the last of her tears."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Still, I won't be able to hold Pappy's hand and do a lot of things with him this way..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Lily..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You do your best to keep your voice even."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Shall we go explore the market? It doesn't matter if it's something fun or something tasty. If you like it, we can go try it, Lily!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her little hand grabs onto your sleeve, and a smile blooms on Lily's face."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Sounds great..."}]}]}]}
