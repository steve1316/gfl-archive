{"name":"12-2-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"2019summer_7","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I seem quite suited for organizing files. "}]},{"spans":[{"text":"Maybe I can find a job like this after I retire as a Tactical Doll."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Right, you can take over from me here. All that's left is to separate and extract the relevant memories."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Understood. I'll begin the process now."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"17xh-Networld","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the expansive cyberspace, an intricate door materializes out of thin air. "}]},{"spans":[{"text":"The door is decorated with engravings of flowers and ivies."}]}]},{"sprites":[{"prefab":"Dandelion","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Looks like you've found the memory fragments."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO slowly pushes the door open."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Several identical-looking Isomers lie silently in a familiar sea of Epiphylla, as if trapped in an eternal realm of dreams. "}]},{"spans":[{"text":"Under the moonlight's tender caress, their bodies dissolve into pastel-colored shards, hovering aimlessly, helplessly. "}]},{"spans":[{"text":"Images of the memories flash intermittently on the surface of the shards."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Are these the memory fragments of the Isomers who merged with OGAS? "}]},{"spans":[{"text":"Some of Dandelion's own memories are also in the mix. Guess I'll have to dig around for what we're after."}]}]},{"sprites":[{"prefab":"Dandelion","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"All the memories you touch will be uploaded to the external device. "}]},{"spans":[{"text":"We can then access the content directly on the outside."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I see. I'll start processing them."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO reaches out and touches a dim memory fragment tentatively."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"2018Winter5-1","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"【When you become stronger, we'll meet again.】"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"ST AR-15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Was this...back then?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"That's right. This was from when I went after Mastermind after the Collapse Fluid dirty bomb went off."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So it really was you who were trying to beat the Military to Mastermind."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You know about that, Commander?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"After the explosion, Ange gave me a sitrep. "}]},{"spans":[{"text":"But she lost touch with you back then, so that's all I knew."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'm sorry...Commander...for detonating the dirty bomb... "}]},{"spans":[{"text":"I know you were gravely injured in that explosion. "}]},{"spans":[{"text":"Griffin also lost a lot of capable Dolls. "}]},{"spans":[{"text":"They will never return. Their consciousness vanished from the surface of the earth forever. "}]},{"spans":[{"text":"If only I had done better back then..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If you hadn't detonated the bomb, I would've disappeared just like them. "}]},{"spans":[{"text":"The battlefield has no room for what-ifs. You saved us, and you did your best."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But I failed my mission even after making such a huge sacrifice..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Sad","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 laments as she stares at herself in the past."}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 knew that her magazine was empty, yet she still held down her trigger helplessly. "}]},{"spans":[{"text":"The entire world went still. "}]},{"spans":[{"text":"The Intercontinental Railway rumbled on. "}]},{"spans":[{"text":"The frigid wind howled. "}]},{"spans":[{"text":"A branch snapped from the heavy snow. "}]},{"spans":[{"text":"Everything faded away. "}]},{"spans":[{"text":"Leaving only the empty clicks of M4's trigger. "}]},{"spans":[{"text":"She wasn't even sure if she was actually squeezing the trigger or if she was just imagining the sound. "}]},{"spans":[{"text":"\"Click, click, click...\""}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"It's time."}]}]},{"sprites":[],"ops":[{"type":"flash","raw":"闪屏"},{"type":"duration","value":"10","raw":"duration"},{"type":"rate","value":"20","raw":"rate"},{"type":"delay","value":"30","raw":"delay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 looked up. A carrier had shown up above them without her noticing. M16 grabbed onto the long rope ladder hanging down. "}]},{"spans":[{"text":"She took one last glance at M4 before she climbed up with Elisa over her shoulder. "}]},{"spans":[{"text":"M4 was left all alone on the roof of the train. "}]},{"spans":[{"text":"She looked up and watched M16's figure vanish into the distance in a daze."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4's silent world was suddenly thrown into turmoil and confusion as what felt like an invisible wave of air came crashing over her. "}]},{"spans":[{"text":"She stumbled several steps back. "}]},{"spans":[{"text":"A violent explosion occurred in the first carriage of the train and the flames started racing towards M4. "}]},{"spans":[{"text":"She steadied herself by reflex and turned around immediately, dashing in the other direction towards the end of the train."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"16... "}]},{"spans":[{"text":"Why... "}]},{"spans":[{"text":"WHY?!!!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The chain of explosions consumed one carriage after another. Soon, M4 was cornered onto the final carriage – there was no escape."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Is this it...?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4! "}]},{"spans":[{"text":"M4, jump!!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15's shout pierced right through the haze that had been muffling M4's mind like a sharp blade, and a multitude of sounds finally started registering in her ears again. "}]},{"spans":[{"text":"The howling wind and thunderous explosions suddenly grew clear and washed over her like a crashing wave. "}]},{"spans":[{"text":"She grew dizzy for a moment. "}]},{"spans":[{"text":"ST AR-15 was riding a motorcycle, desperately trying to catch up with the intercontinental train. "}]},{"spans":[{"text":"She kept trying to inch closer to the hurtling vehicle. "}]},{"spans":[{"text":"There was no room for M4 to hesitate with the blazing flame behind her. "}]},{"spans":[{"text":"She looked back and wanted to answer ST AR-15, but she had run out of space to run."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I'll catch you! Just jump!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"1","raw":"Shake"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"15! I'm counting on you!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_brake","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 leaped off the train. ST AR-15 hurriedly adjusted her position and tried to grab M4 by the torso. "}]},{"spans":[{"text":"M4 slammed heavily in ST AR-15 and the motorcycle went spinning out of control. "}]},{"spans":[{"text":"The two Dolls were thrown off and crashed onto the ground. "}]},{"spans":[{"text":"Meanwhile, the train in the distance ran off the rails amidst the explosions. Heavy smoke rose into the sky... "}]},{"spans":[{"text":"Blocking their view of the receding Sangvis aircraft."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Cough...cough... M4, you okay?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'm fine... Some of my internal support structure is damaged... But I think I can still stand."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I didn't expect Sangvis Ferri would still have resources left to rescue Mastermind. "}]},{"spans":[{"text":"We have to think of a way to track that carrier."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"No...it wasn't S.F..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Not S.F...? What do you mean?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"The one who rescued Mastermind was... "}]},{"spans":[{"text":"It was..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 bit her lip as ST AR-15 stared at her wordlessly."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"It was M16. "}]},{"spans":[{"text":"M16...she betrayed us..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"sfx","value":"Heartbeat","raw":