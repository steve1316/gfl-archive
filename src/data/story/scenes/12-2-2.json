ear Voice","narrator":false,"pages":[{"spans":[{"text":"No, this isn't the end yet."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"!!"}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"Everything has only just begun. You cannot make such a choice."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I never can! "}]},{"spans":[{"text":"Everyone is always taking my choices away from me! "}]},{"spans":[{"text":"I've had enough!"}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"Only those who survive get to make choices, so you must listen to me..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"No, I don't want to hear your voice at all!"}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"But you must. New enemies are amassing in the vicinity. "}]},{"spans":[{"text":"There are still Griffin signals out there. This battle isn't over yet."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"It's all over! "}]},{"spans":[{"text":"I failed! I screwed it all up! "}]},{"spans":[{"text":"I no longer...have a purpose...of living..."}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"No, you have to live on. "}]},{"spans":[{"text":"Your past, your present, as well as the mystery that you still haven't solved are all waiting for you."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You mean YOUR mystery! "}]},{"spans":[{"text":"I don't know what you're trying to do, but all this time you've been deceiving me, tricking me! "}]},{"spans":[{"text":"Just accept it! You're getting blown to kingdom come along with me!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"In that case, there is no other way. I do not want to do this, but it's for your own good – for \"us\"."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"},{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4...what's up with you?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 released the finger that had been squeezing the charging trigger and slung the particle cannon back onto her back."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Nothing. We need to find a military signal relay. "}]},{"spans":[{"text":"We might be able to gather information on the current situation by hacking into the military network."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Weren't you..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I changed my mind. This isn't the time for that kind of thing. "}]},{"spans":[{"text":"We're too far away from the theater. We've got to re-establish communications. "}]},{"spans":[{"text":"With both Ange and Griffin."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You...have a point. "}]},{"spans":[{"text":"What got you to calm down all of a sudden?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I can't afford to not calm down at a time like this. We need to hurry."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Back then...you were controlling M4's actions, Dandelion?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I didn't have a choice. Lunasia lost all motivation. "}]},{"spans":[{"text":"So I had to remove her from critical danger. "}]},{"spans":[{"text":"Two Tactical Dolls wandering in the wilderness would soon attract Paradeus' attention. "}]},{"spans":[{"text":"If \"Father\" had gotten to them, it would have exacerbated the situation dramatically."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The white enemies... I was trapped inside a Dinergate, but they still made a huge impression..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Force fields."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"That's right, which is why I decided to avoid them. "}]},{"spans":[{"text":"ST AR-15, you already noticed something odd about Lunasia back then, didn't you?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"She suddenly became so gung-ho, it just wasn't her style. "}]},{"spans":[{"text":"But if letting you take control meant getting her out of that... "}]},{"spans":[{"text":"Then all I could do was to bear with it."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Ultimately, victory is all that matters – everything else can be sacrificed. "}]},{"spans":[{"text":"How very characteristic of the AR Team."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...So M4 and AR-15 only escaped because of your intervention."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Lunasia suffered from trauma that's far beyond your imagination. She had been second-guessing and blaming herself this whole time. "}]},{"spans":[{"text":"But I couldn't let her destroy herself just like that. She's worth more than anyone could fathom."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"You'll understand in time. Now I'd like to get on with uploading her memories."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Alright."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I...I'd rather not be so valuable."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The worth of your existence is an objective fact. Being in denial doesn't change that."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ahem... "}]},{"spans":[{"text":"So how did you and AR-15 make it back? "}]},{"spans":[{"text":"I knew nothing of your whereabouts throughout the entire withdrawal."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Let's keep watching. Everything is documented fully in M4's memory fragments. "}]},{"spans":[{"text":"Soon you'll see what we encountered, Commander."}]}]}]}
