":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"What have you decided?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I've decided... to do my job properly."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"You mean... you've made up your mind to run your shop in earnest?!"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"That's wonderful!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Purin grasps the Commander's hands in excitement."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"You've finally decided to stay in Sector 2Z64 and be with us forever and ever!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How about some pudding to celebrate this?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Pudding? Why pudding?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Let's have some shredded potato stir-fry at the canteen instead!"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"I've still got some urgent work to do today. We'll celebrate later!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Okay."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Purin skips along, but then she suddenly turns around."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Oh right, Commander. Have Batou and the Major still not connected to their prosthetics?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Well, apparently someone spotted a big, muscular man and a nimble woman sneaking into the Ministry of Love last night."}]},{"spans":[{"text":"I was just wondering if it was them..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander hesitates for a moment."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"They still haven't made the connection."}]},{"spans":[{"text":"But even if they could, I wouldn't know where their prosthetics have gone..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"I see... My job today is to investigate the two suspicious intruders."}]},{"spans":[{"text":"I don't know what they're after; I just hope they're not here to disturb the peace."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"After all, the residents here have finally found a quiet sanctuary where they can live simple and ordinary lives."}]},{"spans":[{"text":"Anyone who tries to destroy such a world will surely be loathed."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Purin, do you still remember your life before coming here?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Hm... It wasn't actually that long ago, but somehow it felt like another lifetime..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What about the first time we met?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"op