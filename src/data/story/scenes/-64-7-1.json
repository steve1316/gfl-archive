over the bottle label. The Dolls' faces in the group photo on the table look distorted through the glass and the clear liquid it contains."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I don't know what they want."}]},{"spans":[{"text":"If you ask me, I want them to come home immediately."}]},{"spans":[{"text":"But if—"}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Don't tell me you're gonna say..."}]},{"spans":[{"text":"If they are happy in Sector 2Z64, you'll just let them go?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why not? If happiness is right there in front of you..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tableware","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Batou puts down his glass silently."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Batou, this is the Commander's business. We have no right to interfere."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"I know that, of course..."}]},{"spans":[{"text":"But letting go just like that is way too selfish."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Selfish?"}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":t