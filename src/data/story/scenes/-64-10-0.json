xt":"Just like this virtual world, which is floating in mid-air."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Why don't you go with them and wake everyone up?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"They can handle it themselves."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Purin looks toward Sector 2Z64 in its state of collapse. Entire buildings are falling apart as if they were melting in the sun."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Look, over there!"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"What is it?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"That's the Ministry of Truth, where I met you!"}]},{"spans":[{"text":"It's now all crumbled, like cookies in a school bag!"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"The Ministry of Love, where Miss Ibis works, is still standing. Oh, it's also starting to fall apart..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}},{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Purin."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}},{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}},{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"The Major and her team have already logged out of Sector 2Z64 and returned to reality. Why are you still here?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Um..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"You seem to be keeping a lot of secrets from me."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"I'm still here because I can't go back, 433."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"作战室avg","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Back in the real world, in the command room at Griffin's base."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Tachikomas are rummaging excitedly through the files shared by the Commander while muttering something about \"parallelization\" and \"natural engine oil\". The Commander scratches their head and looks over to the Major, who has finished her preparations."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"...That's all for now, Commander. We should head back."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"We still have a lot of questions for Takashi Shimamura, things that we haven't quite figured out."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Batou taps the hard drive in which Shimamura's consciousness is stored."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What about Suzuka Mizukane...? Are we just keeping her here at our base like this?"}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"She should have a taste of amnesia."}]},{"spans":[{"text":"You look like you could use some help around here anyway."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"It's too dangerous to have her and Shimamura together in one place. Separating them is the way to go."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Alright."}]},{"spans":[{"text":"I've already said this once, but I would like to extend the invitation again..."}]},{"spans":[{"text":"Your prosthetics will be preserved for as long as the Griffin base stands. You're very welcome to visit again if you get the chance."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Sure, let's go out for a drink next time."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Don't get your hopes up."}]},{"spans":[{"text":"We may meet again, or we may not."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander glances uneasily at the no longer functional AR equipment."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Also..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"About Purin?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah... Can she really not return from Sector 2Z64?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Batou sighs."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"She's too reckless."}]},{"spans":[{"text":"After taking serious damage the first time we entered Big Brother's room, instead of undergoing repairs, she just had to return to the battlefield first thing."}]},{"spans":[{"text":"Then she went and came up with the crazy idea of combining the AI of 2Z64 with her own data just to achieve our aim. Now she's completely tied up with Sector 2Z64..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"You're both reckless."}]},{"spans":[{"text":"One is trapped in Sector 2Z64, and the other can never return to Sector 2Z64 even if he shoots himself."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Don't worry, at least we can guide Purin back to our original world."}]},{"spans":[{"text":"She'll just end up losing her memories of this place."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"I'll do my best to restore her."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Please give her my thanks. I haven't had the time to thank her properly."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"No problem."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Then it's time for us to go."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Please take care."}]}]},{"sprites":[],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Major's and Batou's prosthetics become inactive."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After giving them a solemn salute, the Commander leaves the command room."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Major, have you forgotten something?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"No."}]},{"spans":[{"text":"I just have a sudden feeling that we may end up visiting this place quite frequently."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Well, you know Purin. She'll nag us about coming here once she finds out about everything."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"You're right."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021summer_Street","raw":"BIN"},{"type":"bgm","value":"BGM_SAC2045_LastSunset","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In an unknown region in Sector 2Z64."}]},{"spans":[{"text":"Standing next to Purin, 433 gazes morosely at the faraway sunset."}]},{"spans":[{"text":"The setting sun, which was still so glorious just a moment ago, is now about the size of a cocoa bean."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Boys and Miss Ibis have finished helping all the other Dolls log out."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Yeah."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Aren't you going?"}]},{"spans":[{"text":"The Commander must be waiting for you, no?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}},{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}},{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Don't worry about me. The Major and Mr. Batou will bring me back safely."}]},{"spans":[{"text":"Just not all of me..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}},{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}},{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Oh, I shouldn't have said that. You're looking even more upset..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}},{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Purin, thank you for fighting with us till the very end."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Without you, we couldn't have made it home."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Why are you so serious all of a sudden? I don't know what to say..."}]},{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Look, the sun is almost gone!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Purin points toward the sunset in the distance."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAC_2Z64Collapse","raw":"BIN"}],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"It's quite wondrous if you think about it. There are countless stars in the universe, but not a single one can illuminate this world once the sun goes down."}]}]},{"sprites":[],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"That's because the universe we're in isn't entirely static, homogenous, or infinite. Besides, we need to consider the effects of the expansion of space—"}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"...I'm being sentimental here!"}]}]},{"sprites":[],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Oh, sorry."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Haven't you ever wondered?"}]},{"spans":[{"text":"Where does the sun go after it sets? Why does it give the world light then take it away so cruelly?"}]}]},{"sprites":[],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Once the sun sets here, it rises and lights up somewhere else. The Earth is round, after all."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Forget it. I shouldn't be waxing poetic to you."}]}]},{"sprites":[],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Also, I don't think the sun takes away the light it gives the world."}]},{"spans":[{"text":"At least not all of it."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Oh?"}]}]},{"sprites":[],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Thanks to sunlight, grass grows from the soil, young leaves burgeon on branches, and cats can laze around licking their new-grown fur..."}]},{"spans":[{"text":