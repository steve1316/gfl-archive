:"2023SAC_JailPhoto","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The faces of four girls are shown clearly in the photo."}]}]},{"sprites":[],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"We had this taken when..."}]}]},{"sprites":[],"ops":[],"speaker":"QBU-191","narrator":false,"pages":[{"spans":[{"text":"Feels a bit funny seeing this again."}]}]},{"sprites":[],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"But we're finally all back together."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Yes, we're all back together again!"}]},{"spans":[{"text":"But this time, we're going to succeed!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2021white_Jail","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander circles around the Dolls and Purin, who are all buzzing with excitement, and makes their way to the Major and Batou."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"The situation hasn't really changed. We stick to the plan."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right, I'm ready."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"The most crucial part of the plan is all on you."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No problem. For the sake of everything, I will not fail."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander looks up at the Dolls, but then their tablet suddenly chimes."}]},{"spans":[{"text":"It is a message sent a few hours ago."}]},{"spans":[{"text":"The sender was Purin Esaki."}]}]}]}
