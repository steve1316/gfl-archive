{"name":"-64-8-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2021white_REDNET3D","raw":"BIN"},{"type":"bgm","value":"10230","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Within Purin's mental domain."}]},{"spans":[{"text":"The Commander is painfully aware that Purin has the absolute advantage in here."}]},{"spans":[{"text":"To avoid taking unnecessary casualties in a direct confrontation, the Commander decides to spread out their forces."}]},{"spans":[{"text":"But even so, the situation is inevitably tilting in Purin's favor..."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"How long are you going to keep running, Commander?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hiding behind the temporary barricade that 433 and QBU-191 built using redundant data, the Commander watches Purin cautiously from a distance."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Major, do you copy?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"The signal is still pretty clear. Good thing the encrypted channel is still working.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How are things on your end?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"You're the one she's after, so we're relatively safe for now.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Should we come over to give you a hand? It'll take us about five minutes to reach you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's regroup first. She's got too much firepower. We haven't been able to find an opening yet, so I advise against moving in now."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Understood.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After ending the call, the Commander realizes that Purin is nowhere to be seen."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Where has she gone?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"She went in the Major and Batou's direction. They'll probably miss each other."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Okay, keep an eye on her movement."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Boys, you still good?"}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"I'm fine; I've finished most of the repairs."}]},{"spans":[{"text":"Commander, an unknown signal tried to establish communication with me a few minutes ago..."}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Was it the Major?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Or could it be Purin trying to pinpoint our location?"}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"Probably neither. The signal originated from outside the domain."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"QBU-191","narrator":false,"pages":[{"spans":[{"text":"I can't really think of anyone who'd try to contact Boys at a time like this..."}]},{"spans":[{"text":"Commander, should we set up a connection?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Do it."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Boys, keep up your defenses. If anything seems off, sever the link immediately."}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Under everyone's watchful gaze, Boys sets up the connection."}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"Who is this?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pzzzt..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a short burst of static, a soft, breathy voice whispers from the other end of the line."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Commander, it's me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander has no trouble recognizing the voice."}]},{"spans":[{"text":"In fact, the Commander is feeling uncertain because they recognize the voice."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"And you are?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"That doesn't matter. What matters is that I promised I'd fight by your side till the very end.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Commander, you need to get away from the barricade right now!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With no time to think, the Commander drags the Dolls away from the temporary barricade out of pure reflex."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Explo_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"BOOM!"}]},{"spans":[{"text":"A wave of heat rushes toward the Commander from behind."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"bgm","value":"10247","raw":"BGM"}],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Commander!"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"QBU-191","narrator":false,"pages":[{"spans":[{"text":"Watch out!"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"I knew you'd be here!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Run!"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Run straight ahead; you'll then find cover at your two o'clock in 30 meters!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"...Who are you, really?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I don't have time to explain! Just do as I say!","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Commander, she will fall apart if you separate the data from her core AI!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"QBU-191","narrator":false,"pages":[{"spans":[{"text":"You mean bombarding the AI in her neural cloud with a massive flow of data to take up the original data's bandwidth?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Yes. You'd better hurry...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"Commander, what should we do?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"To generate such a vast amount of data, the three of us will have to attack her neural cloud simultaneously. We may even need some help from the Major and Batou..."}]},{"spans":[{"text":"But that'll leave no one to protect the Commander!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Explo_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom! With the threat of death approaching fast from behind, the Commander can only keep running."}]},{"spans":[{"text":"Reason cautions against trusting the voice in the comms channel completely, but their body seems to be moving with a will of its own."}]},{"spans":[{"text":"The physical strain and inner turmoil combined are causing the Commander's heart to pound heavily in their chest."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Trust me, Commander. I've never lied to you!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Do as she says."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Commander?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'll cover you."}]},{"spans":[{"text":"This will at least buy us enough time for the Major and Batou to get here."}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"QBU-191","narrator":false,"pages":[{"spans":[{"text":"We'll try to end this quickly."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After making sure the Dolls are hidden behind cover, the Commander dashes away in the opposite direction on their own."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Commander, thank you for trusting me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"There you are!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander turns to peek at Purin, who is gaining on them, as they tear through the completely open area."}]},{"spans":[{"text":"The Commander lures Purin to corner them."}]},{"spans":[{"text":"Data flows rapidly through her fingers. The Commander has no doubt the torrent of data will easily overcome them in their current state of exhaustion."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Why do you keep running?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"shake","raw":"震屏"},{"type":"bgm","value":"10258","raw":"BGM"}],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Is staying here such an ordeal for you?!"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander takes in their surroundings and suddenly chuckles."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Do you remember the first time we met?"}]},{"spans":[{"text":"I was running around the base like a lunatic, searching for my Dolls."}]},{"spans":[{"text":"And you were running after me, trying to comfort me and help me figure out what to do."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"How is it any different this time?"}]},{"spans":[{"text":"I'm also trying to catch up with you to convince you to calm down and make the right decision."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Telling someone to pull themselves together and telling them to make a decision based on what you want are two completely different things."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"...I simply don't want you to return to a reality that is filled with darkness and endless despair."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What about you? What did you choose to do when you were confronted with dark reality?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"I came here and found a pure sanctuary untouched by darkness."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No, you are not one to run away from reality."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"If reality cannot be changed, what's wrong with running from it?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Grey_Hand_Mech","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Growing tired of the Commander's obstinacy, Purin waves her hand and binds the Commander to the spot."}]},{"spans":[{"text":"The Commander makes no attempt to struggle. They just gaze at Purin calmly as she draws closer."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Batou told me you were once pushed into the darkest abyss, but you did not despair; you climbed back out yourself."}]},{"spans":[{"text":"All because of a small cup of—"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Pudding.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Mr. Batou treated me to pudding and told me to live a good life.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So it's really you."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Commander, just hang in there a little longer. We're almost done—","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"You're still obsessing over the difference between what is real and what isn't..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Purin's stern face suddenly twists into a cruel smile."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"But that's okay. Once you undergo the cyberbrain conversion and forget—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Explo_Close","raw":"SE1"},{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]},{"spans":[{"text":"The instantaneous attack almost blows Purin's entire body apart."}]},{"spans":[{"text":"Her smile evaporates and is replaced by terror. She looks toward the source of the attack—"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Impossible! This can't be—"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Commander, are you behind this?!"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"...How could you do this to me?!"}]},{"spans":[{"text":"It was me who helped you find the Dolls! It was also me who gave you a place you belong in Sector 2Z64!"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It was Purin who did these things for me."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"What are you talking about..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Grey_Hand_Mech","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander breaks free from their ineffective bindings and walks over to the heavily damaged Purin."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I don't tend to lower my guard and put my trust in strangers, but strangely enough, I do trust Purin."}]},{"spans":[{"text":"Probably because she was the only one who stayed by my side when I woke up in the utterly empty base."}]},{"spans":[{"text":"Or maybe it's because she was hellbent on helping me carry out the plan to take back everything, even if the plan was insane; even if there's nothing in it for her."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Then why are you doing this to me?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Because the Purin I know is a strong and tenacious person who never runs away. No matter what obstacles are in her way, she just charges at them head on..."}]},{"spans":[{"text":"And if she trips and falls, she just eats some pudding and finds hope again."}]},{"spans":[{"text":"But not you. You are nothing but a delusional phantom that skulks in falsehood."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"Purin\" cowers on the floor and reaches out to grasp at the Commander."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Commander, our attack was effective!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes, I can see that. It was most timely."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Should we initiate another attack?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"There's no need for that. Leave the rest to me."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"？江崎普林","narrator":false,"pages":[{"spans":[{"text":"Commander, save me..."}]},{"spans":[{"text":"There are so many things I want to do... I want to run that little shop with you, eat pudding with you..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander raises their gun."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You don't even understand what the pudding stands for."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"},{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]},{"spans":[{"text":"Her body dissolves into formless data and eventually disappears."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"2021white_Jail","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With the illusion dispelled, the Commander returns to the cell where Boys was being held captive."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...That was close."}]},{"spans":[{"text":"Thank you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander taps their communicator, but nothing comes through from the other end."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Purin?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud! The Commander hears something hit the floor behind them."}]},{"spans":[{"text":"They whirl around and find a petite girl lying by their feet."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Purin!"}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You actually meant it when you said you'd always be by my side..."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"...Did I come in useful?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes... Don't talk. I'll contact the Major now."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Commander... I heard everything you just said..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"When we get back to the Griffin base, let's have some pudding together."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sure."}]},{"spans":[{"text":"But save your strength for now."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Okay..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Purin closes her eyes quietly in the Commander's arms."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Major rushes down the corridor of the prison."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Major!"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Commander, are you alright?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm fine, but Purin..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Let me have a look."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"2022saros_Spotlight","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"At a home where the lights are off and it is pitch dark."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_2022_Summer_AVG_2","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The small room is like a forgotten laundry basket in the corner—messy and giving off a terrible smell."}]}]},{"sprites":[],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Purin stands before the half-closed door but seems reluctant to open it."}]},{"spans":[{"text":"She knows full well that there's nothing behind the door."}]},{"spans":[{"text":"But whenever she finds herself on the verge of despair, she always ends up back in this place."}]},{"spans":[{"text":"She feels like a ghost trapped in a labyrinth."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Dad, Mom, Sis..."}]},{"spans":[{"text":"You must've gone somewhere far, far away, while I'm still stuck here."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It hurts everywhere. The fight with Takashi Shimamura has left her severely injured. She finally escaped with great difficulty, but she can't move anymore."}]},{"spans":[{"text":"She is utterly helpless as her mind drifts back to this place."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Someone is still waiting for me..."}]}]},{"sprites":[],"ops":[{"type":"flash","raw":"闪屏"},{"type":"duration","value":"10","raw":"duration"},{"type":"rate","value":"20","raw":"rate"},{"type":"delay","value":"30","raw":"delay"},{"type":"cg","value":"670","raw":"CG"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her mind feels like a glacier thawing gradually in scorching sunlight... becoming one with the ocean."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022saros_Spotlight","raw":"BIN"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I trust you."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Don't underestimate me. I've still got plenty of tricks up my sleeve..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Purin conjures up 2Z64's AI, which 