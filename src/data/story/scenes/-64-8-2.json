":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"I'll go into the specifics when this is all over."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Major interrupts the Commander before they can ask more questions."}]},{"spans":[{"text":"Purin opens her eyes and gets to her feet. She seems to have recovered some of her strength."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Thank you, Major. I'm feeling much better."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Sorry for causing you trouble again..."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"There's nothing wrong with doing what you think is right."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Agreed!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Purin walks up to the Commander."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Commander, so you've made up your mind."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":2,"shown":true,"side":"left","tags"