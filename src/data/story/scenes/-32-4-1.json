ana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Super-Shorty smiles, and the elevator doors close on her."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Alright, now..."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Dana turns to the White Knight mech behind her."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"How do you do, my White Knight friend. Can I wait at the entrance right here?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"White Knights","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Uh... "}]},{"spans":[{"text":"Bonjour?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The nearby White Knights do not respond. "}]},{"spans":[{"text":"...Dana looks around. There are no Dolls or humans nearby. All the White Knight mechs stand in place, still as statues."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Hola—! "}]},{"spans":[{"text":" やほ—! "}]},{"spans":[{"text":"您好—! "}]},{"spans":[{"text":"Let me think... There's also... "}]},{"spans":[{"text":"...Lei hou? "}]},{"spans":[{"text":"Hmm... They say spoken Chinese includes Mandarin, Cantonese, and all kinds of dialects, so was my intonation off?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"White Knights","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Dana","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Hey, do you have sand in your hearing modules?"}]}]},{"sprites":[{"prefab":"Dana","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The White Knight in front of Dana slowly raises its firearm and points it at her."}]}]},{"sprites":[{"prefab":"Dana","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Oh? Have the White Knights changed the way they greet people recently? Or..."}]}]},{"sprites":[{"prefab":"Dana","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Get down, Dana!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Boom! "}]},{"spans":[{"text":"A grenade hits the White Knight in front of Dana, and a massive explosion sends her flying!"}]}]},{"sprites":[{"prefab":"Dana","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Boss","raw":"BGM"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"(Cough cough) ...Dammit, what the hell—!"}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The scene is in chaos. Humans and Dolls are trying to stop the berserk White Knight mechs, but to no avail."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"主界面背景","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"whitescreenOff","raw":"白屏2"},{"type":"spark","raw":"火花"}],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Hey! Over here, over here!"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...As the berserk mechs rush toward Dana, she turns and sees Architect waving from behind a cover. "}]},{"spans":[{"text":"...Dana nimbly evades the mechs and rolls behind the cover."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Although you might think I'm bragging, but I really could've dodged their attacks!"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"I know. I've seen the videos from when you were an auxiliary cop, but I doubt you could dodge gunfire from ten-odd mechs at once."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"I've certainly never had the chance to try that. "}]},{"spans":[{"text":"So, what's all this about? Should I ask why the White Knights are attacking me, or should I pretend to be concerned about you and ask how you escaped? The White Knights should have put electronic shackles on you, right?"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"As for your first question, Anna's on the move. She's assumed direct control of the White Knight mechs and has driven them all berserk, and it seems like you are not an important character in her script."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Anna? Who's Anna?"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Good question. Since we're in the middle of a battlefield, I'll cut things short. "}]},{"spans":[{"text":"Anna is the true master of this city, and the final boss of the entire incident."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Very good, that's easy enough to understand."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"As for your second question, do you really care about the answer?"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"A little. You're not like the other S.F., and I really am curious. By the way, are you good in a fight?"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"If the place allowed for it, I wouldn't mind going a couple of rounds with you, but—"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Architect quickly pokes her head out and launches another grenade."}]},{"spans":[{"text":"Boom!"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"But now's not the time, and there's someone else you should be concerned about right now, isn't that right?"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"You're right. Shorty... I bet she's in danger!"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"I don't know what's up with that kid, but the White Knights went crazy the moment she entered the building. You know what that means, right?"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"I don't care how that Anna wants to write her shitty script, but I'm going to wreck it!"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Don't tell me you're going to dismantle all the mechs on the base by yourself? You should get some of those Dolls and natives to help you out!"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"I will, and you have got to help me, Architect."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Hahaha! My wealth of kindness is positively trembling at the idea! But you do remember that you're the one who caught me and brought me here, right?"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"I'll pay you with Hassy."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Oh? I love Hassy! You got yourself a deal!"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"To be honest, I've always wanted to throw down with those white chrome domes. "}]},{"spans":[{"text":"Now...in the name of cuteness, let the battle begin!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"White","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
