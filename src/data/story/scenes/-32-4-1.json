ges":[{"spans":[{"text":"It's nighttime now..."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Good Southern Hemisphere, shorty. "}]},{"spans":[{"text":"It seems like Jericho's on another mission. You'll have to enter by yourself."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Um..."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Don't worry. The White Knights won't hurt you."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The White Knights step forward to escort Super-Shorty away."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"...Dana. "}]},{"spans":[{"text":"When I first met you, my factory-set personality told me that I should be hating you, probably because you kept calling me \"shorty\"."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Then you can call me \"Red Comet\"."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Like heck I will! And why do you deserve such a cool nickname!? "}]},{"spans":[{"text":"What I'm trying to say is, I don't dislike you so much now. I'm more afraid of what's going to happen next..."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"You'll be fine, shorty. "}]},{"spans":[{"text":"This is a checkup that'll only take less than half an hour. I'll be waiting out here for you. We'll go to a bar afterward."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Let me get this out of the way first, I don't want to drink anything alcoholic."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The White Knights lead Super-Shorty to the base's main building."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Non-alcoholic drinks are way more expensive than alcohol. You won't find anything even resembling a tea leaf in Griffin City's commercial districts. It's industrial alcohol all the way down."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...As Super-Shorty is escorted f