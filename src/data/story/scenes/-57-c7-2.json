{"name":"-57-C7-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2023SAGA_Beach","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"},{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The gentle waves surge longingly toward you again and again, only to curb their enthusiasm and flow back out, leaving only the fine sand between your toes as the proof that they had once lapped at your feet."}]},{"spans":[{"text":"The subtle itch and the faint pain they cause is easy to bear yet impossible to ignore... much like your present feelings."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is this... for me?"}]}]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=Saga_Junko_item%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There is an ozaki figurine in Junko's hands."}]},{"spans":[{"text":"She gingerly offers it to you."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"closeMask","raw":"关闭蒙版"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"I should have given this to you long ago."}]},{"spans":[{"text":"But I kept losing focus when I applied the finishing strokes, so it took longer than it should."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm surprised... to think you'd actually lose focus, Junko."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Well, it's hard to concentrate when you're thinking of other things."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"And what kind of things would those be?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"If I could return to my own time like you, Commander..."}]},{"spans":[{"text":"Should I stay with Franchouchou and be an idol, or should I go back to the past and be an idol there?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}],"choices":["Stay with Franchouchou.","Go back to your own time."]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You look at Junko and you know what is the real cause of her hesitation."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You should stay with Franchouchou, of course."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Why?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Because you love Franchouchou."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"When you shone by yourself in the past, you were the bright moon of the Showa era."}]},{"spans":[{"text":"Now that you're in Franchouchou, you are among the stars."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"When you were by yourself, whether others liked or disliked you..."}]},{"spans":[{"text":"I'm sure it must have been rather lonesome, right?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"...You're right."}]},{"spans":[{"text":"And besides, I've found something more precious here."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You asked me that question to clear your doubts, didn't you?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Yes... and no."}]},{"spans":[{"text":"Why can't you stay, then?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I still have people there that I can't just bear to give up."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"I see."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If you're truly unhappy here, then you should go back to your own time."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"When I woke up, the scariest thing wasn't that I'd come to another time period."}]},{"spans":[{"text":"Rather, what frightened me most was... what they would do without me..."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If they had come here with me... "}]},{"spans":[{"text":"Then maybe I wouldn't be so eager to go back."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"More than not being used to the language, the local customs, or my identity... "}]},{"spans":[{"text":"What really weighs on my heart is how the people around me would fare."}]},{"spans":[{"text":"Perhaps I could fulfil my dream of giving them peaceful days in an era like this."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's why I think that if you think you have two clear-cut choices—\"Franchouchou\" or \"going back\", you should choose the latter."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"After all, when you see them, you'll end up thinking, \"If only I could go back by myself.\""}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So rather than regretting your choice forever, you should choose to be a little selfish and insist on having things your way."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"...it's not like that."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"To me, the others are more important than going back. "}]},{"spans":[{"text":"As a zombie, I could obviously choose to die again."}]},{"spans":[{"text":"That is, if I really hated everyone."}]},{"spans":[{"text":"But I don't."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"So rather than staying stuck in the past forever, I'd rather have a future where I'm fighting alongside everyone else."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Thank you for helping me rule out an answer."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It would seem I only ever had one choice to begin with."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Congratulations, blast from the past. You've finally set sail upon a new boat."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"And congratulations to you on going back to the future. You'll soon be able to return to your own ship."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"I'm glad I could give you this ozaki figurine."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Speaking of which, why are you giving me this figurine?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Don't you think it looks a lot like you?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Wait, so this is how I appear in your heart?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"It's adorable."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"A... adorable?"}]},{"spans":[{"text":"Alright then, if that's what you think, I... I suppose I could accept it."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"This way, I'll feel happy every time I paint them."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"That's because I gave a fellow traveler from another world a handmade doll."}]},{"spans":[{"text":"It's proof that we once shared our journey."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That we did."}]},{"spans":[{"text":"And it will never change, no matter what happens."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You answer with great certainty."}]},{"spans":[{"text":"You will reunite with that girl who plays her guitar under the setting sun over and over again."}]},{"spans":[{"text":"Whether it's during an afternoon break in the office, or late at night when you're drinking alone..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
