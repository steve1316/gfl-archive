m!"}]},{"spans":[{"text":"An artfully accurate shot forces Mizukane out of the smokescreen."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Commander, cover me!"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Alright!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang-bang-bang! While Mizukane is exposed, the Major unleashes a barrage on her."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bullet_Hit_Body","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mizukane takes the bullets head-on before disappearing from view once more."}]}]},{"sprites":[],"ops":[],"speaker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"You lot from Section 9 are always an eyesore."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bullet_Hit_Wall","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang-bang! The Major fires promptly at the voice."}]},{"spans":[{"text":"But the shots miss their mark."}]}]},{"sprites":[{"prefab":"NPC-Tachikoma","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150","commsBox":""}}],"ops":[],"speaker":"Tachikoma","narrator":false,"pages":[{"spans":[{"text":"Target detected! Coming in from two o'clock!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Fire!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Gatling_gun","raw":"SE1"}],"speaker":null,"narrator":false,"pages":