{"name":"-64-9-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-Sewer","raw":"BIN"},{"type":"bgm","value":"BGM_stage10","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In an unknown area in Sector 2Z64."}]},{"spans":[{"text":"Following information provided by Ibis, the Commander's company enter an underground tunnel."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Water_Drip","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Unlike the sunny surface of Sector 2Z64, the tunnel is cold, damp, and smells of mold."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"Big Brother's room is just down this tunnel."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"QBU-191","narrator":false,"pages":[{"spans":[{"text":"I remember we almost got stomped by the enemies swarming at us the first time we came..."}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Does this underground tunnel have any forks where the enemy can lie in ambush? How big are their forces?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"The tunnel is made of a single thoroughfare with a handful of forks."}]},{"spans":[{"text":"The enemy did ambush us at the forks, and there were about 30 to 50 of them."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"We should at least pick up some signals from a force of that size."}]},{"spans":[{"text":"But right now the area is quiet like a tomb."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is it possible that there's no ambush?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"We can tackle an ambush. I'm worried about something else."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Staring into the dark passage ahead of them, the Commander recalls the way Mizukane and Shimamura move."}]},{"spans":[{"text":"Their inhuman speed and strength."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"In such a narrow and enclosed space, they have a significant advantage."}]},{"spans":[{"text":"We can't draw out the fight by keeping our distance."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"This is probably why they put Big Brother's room here."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Should I scout ahead?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Yes. I need to know the exact distance between us and the entrance to Big Brother's room. Also take note of the forks where they could stage an ambush."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Right, I'll go have a look."}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"I'm coming too! I've been here before, so I can provide some reference data!"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What about your injuries?"}]}]},{"sprites":[{"prefab":"NPC-Purin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-50,50"}}],"ops":[],"speaker":"Purin Esaki","narrator":false,"pages":[{"spans":[{"text":"No worries, I can move just fine!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ibis, go with Batou and Purin and give them a hand. 433 and Boys can handle things here."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"QBU-191","narrator":false,"pages":[{"spans":[{"text":"Roger."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The trio that splits from the group soon disappears into 