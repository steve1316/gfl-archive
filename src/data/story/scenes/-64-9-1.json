ukane and her forces."}]}]},{"sprites":[{"prefab":"NPC-Tachikoma","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150","commsBox":""}}],"ops":[],"speaker":"Tachikoma","narrator":false,"pages":[{"spans":[{"text":"No problem!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"433, send an encrypted message to Ibis. Get them to return immediately."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Got it!"}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"Commander—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ka-chak—"}]},{"spans":[{"text":"A soft but threatening sound almost goes unnoticed in the confusion."}]},{"spans":[{"text":"The next moment—"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Duck!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Explo_Close","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tinnitus_0","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An RPG sails over their heads and explodes behind them."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"It's Mizukane."}]}]},{"sprites":[{"prefab":"NPC-Suzuka","expression":0,"shown":true,"s