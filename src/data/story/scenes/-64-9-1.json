,"narrator":false,"pages":[{"spans":[{"text":"Yes. My vision is deteriorating. It's starting to get patchy in dimly lit places."}]},{"spans":[{"text":"But don't worry about it. I'll be fine once I return to reality."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Looks like even Shimamura's creation can't prevent human brains' inevitable disconnect with the virtual world."}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"It's just your vision for now, but what other symptoms are there when it gets worse?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"When it gets worse... the Commander will start losing their hearing, senses of smell and taste, until finally..."}]},{"spans":[{"text":"Only their sense of touch will remain."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"433's voice trails off as her mind wanders."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"What are you thinking?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"The onset of the Commander's symptoms is a bit too rapid... I suspect foul play..."}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"Their connection decay started too soon?!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"According to the information I was given before, connection decay usually starts a week after a human is first connected to a simulation."}]},{"spans":[{"text":"There were occasional cases where the onset of symptoms occurred a little early, but there has never been a case as extreme as the Commander's."}]}]},{"sprites":[{"prefab":"NPC-BoysAntiTank","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Boys AT Rifle","narrator":false,"pages":[{"spans":[{"text":"Those bastards definitely aren't playing fair!"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Then things are getting out of hand. We must prepare for the possibility that the Commander could be put out of action any second."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Trying their best to remain calm, the Commander moves their body, which is still functional and under their control for the time being."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No matter what happens, we must ensure the plan succeeds."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Major leans in closer."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Commander, regarding the finer details of the plan..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't worry about me. I can still do my part if I'm only losing my five senses."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Alright, then we stick to the plan."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm counting on you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_FT_Heel","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Footsteps once again echo through the cavernous underground tunnel."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"Are they back?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Hold on."}]},{"spans":[{"text":"Tachikoma."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}},{"prefab":"NPC-Tachikoma","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150","commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"