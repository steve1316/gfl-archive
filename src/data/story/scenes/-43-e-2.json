{"name":"-43-E-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2020TCTDdarkarea1","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Sixth Avenue. "}]},{"spans":[{"text":"After A-91 has left."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"What was A-91 trying to do?"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"I don't know either. Maybe she came all the way here to clown around?"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Do vodka Dolls all have such weird senses of humor?"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"They're funnier than the Schwarzbier Dolls, at least."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"And for some reason, she was the only one left of her squad. "}]},{"spans":[{"text":"What kind of team leader would allow her team members to be stranded and isolated? "}]},{"spans":[{"text":"I'd really like to meet her."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Haha, well, if she only had one team member left, the leader can't be in a much better position herself. "}]},{"spans":[{"text":"Still, it's better than a leader who gets herself isolated and dies after all her other team members."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Now that's just sad."}]}]},{"sprites":[],"ops":[],"speaker":"ISAC","narrator":false,"pages":[{"spans":[{"text":"Warning. Agent is suffering from starvation."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Did you hear that?"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Oh, your hunger gauge is in the red! Ehhhh? How come mine is even lower than yours? People in this world get hungry way too soon."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Well, I sampled some of that food from before to figure out its effect, so mine was topped up a little. "}]},{"spans":[{"text":"Do you have anything to eat?"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"I've got some, but it's not much."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Hm... I don't have anything left on me. "}]},{"spans":[{"text":"Just save it for now, it's definitely not enough for both of us. "}]},{"spans":[{"text":"We'll decide later, when we have to."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Yep, okay!"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"We don't have much time. Let's hurry and find more food!"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"M'kay!"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Ammo, grenades, gun parts... There are surprisingly quite a lot of supplies. "}]},{"spans":[{"text":"Hm... But none of these are edible."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"You can try it, if you aren't afraid of breaking your teeth. "}]},{"spans":[{"text":"Besides, it won't affect your body."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Ew... I don't wanna. "}]},{"spans":[{"text":"Ah, there's something over there!"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Wait a minute... I told you, don't rush!"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"2020TCTDsafehouse","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"That's strange. Nobody should have passed through here. "}]},{"spans":[{"text":"The ammo and whatnot are intact. "}]},{"spans":[{"text":"But there isn't a single bit of food here. "}]},{"spans":[{"text":"And what's this..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"PP-90 picks up the piece of paper in front of the counter."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"...It's a bill. "}]},{"spans":[{"text":"Looks like someone took all the food here and was kind enough to leave a shopping list behind."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"...I don't get it."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Me neither. But it proves that other teams have been here before. "}]},{"spans":[{"text":"They were right here, but they ignored all the guns and ammunition and just took all the food. "}]},{"spans":[{"text":"Are they planning to starve their rivals to death?"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"You can't possibly be serious. "}]},{"spans":[{"text":"As if anyone could be that underhanded. "}]},{"spans":[{"text":"...Nobody would do that, right?"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"I would very much like to agree with you. "}]},{"spans":[{"text":"But the facts are laid out before our eyes, and regardless of what their motives are... "}]},{"spans":[{"text":"This is what they have done."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"I'm really worried we're going to starve to death now..."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"2020TCTDdarkarea1","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"There's no food at all..."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"What a pain... Why are player characters designed to get hungry, anyway? "}]},{"spans":[{"text":"A Tactical Doll who can't fight without eating? "}]},{"spans":[{"text":"That makes us no better than regular human soldiers..."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"It can't be helped, it's just how the game works. "}]},{"spans":[{"text":"Also, this experience is kind of new. "}]},{"spans":[{"text":"Let's keep looking."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"...If, and I'm just saying if, PP-90. "}]},{"spans":[{"text":"If we really can't find any supplies..."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"...Don't be silly, you're the leader! "}]},{"spans":[{"text":"Get a grip!"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"So I'm a team leader who puts her team members at risk of starvation..."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"That's not your fault! "}]},{"spans":[{"text":"Oh, right! R93! Why don't you contact them and see how things are?"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"I... Yes, I should talk to them. "}]},{"spans":[{"text":"They might have supplies on their side."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click—"}]}]},{"sprites":[{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"R93","narrator":false,"pages":[{"spans":[{"text":"Hello? Vivi? What's wrong?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"It's an emergency, R93. "}]},{"spans":[{"text":"Do you have any food with you?"}]}]},{"sprites":[{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"R93","narrator":false,"pages":[{"spans":[{"text":"Food? Sure we do. We're all very full. Practically stuffed, in fact.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Being overstuffed isn't a good thing... She should rephrase it."}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"We're still collecting supplies on our end, but most of it is ammo.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"We basically eat all the food we find on the spot.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Seeing your temperature or hunger gauge drop feels really bad, even if it's only a little.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"R93","narrator":false,"pages":[{"spans":[{"text":"Seeing a full stat bar is as comforting as looking at a 100% charged battery...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"That's it for us. How are things on your end?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"...Is that so? I see. "}]},{"spans":[{"text":"We'll think of something for ourselves, then. "}]},{"spans":[{"text":"See you later, Queen Marie."}]}]},{"sprites":[{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"R93","narrator":false,"pages":[{"spans":[{"text":"What? Wait a—","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click— "}]},{"spans":[{"text":"The transmission ends."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"We're pretty much at our limit. "}]},{"spans":[{"text":"What about that food from earlier?"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Actually..."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"...There's only one can of food, right?"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Yeah..."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Well, there's no time, PP-90. "}]},{"spans":[{"text":"Go ahead and have it."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"What...! "}]},{"spans":[{"text":"What are you saying, Vivi?! "}]},{"spans":[{"text":"You want me to abandon you?!"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"This is my responsibility as team leader!"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"That's nonsense!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ka-chak—! "}]},{"spans":[{"text":"Vector suddenly raises her gun."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"This is an order, PP-90. "}]},{"spans":[{"text":"I'm the leader."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"...! "}]},{"spans":[{"text":"...Even so, I refuse."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"PP-90 returns Vector's gaze, unwilling to back down. She even goes as far as to rest her forehead against the muzzle of Vector's gun."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The air seems to freeze solid around the two of them. Neither is willing to back down, and they remain at an impasse."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"ISAC","narrator":false,"pages":[{"spans":[{"text":"Warning. Agent is suffering from starvation."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At least, until ISAC's notification breaks the stalemate.<下雪></下雪>"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"You heard him. We're out of time."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"I did, which is why you should hurry up and eat."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"I can't. It's my fault we ended up like this... "}]},{"spans":[{"text":"If I had realized the importance of food earlier, we wouldn't have ended up in this state. "}]},{"spans":[{"text":"I need to take responsibility for it."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"...Don't be silly. "}]},{"spans":[{"text":"I joined this squad because of you, Vivi. "}]},{"spans":[{"text":"I have no objections or complaints about your leadership. "}]},{"spans":[{"text":"And besides, between the two of us, you've got a better chance of winning this thing, right?"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"I...!"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Vivi. Stop making a fuss."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"PP-90 sighs, then gently pushes away the muzzle of Vector's gun."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"You want to play the hero, and I can't do anything about that. "}]},{"spans":[{"text":"That's because it's just the way you are. "}]},{"spans":[{"text":"Put nicely, you could call it a fierce sense of duty, but in a not-so-nice way, it's a form of martyr complex."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"...What do you mean?"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"I know, Vivi. You think this is just a game, right? "}]},{"spans":[{"text":"The Commander gave you a mission, but you never really wanted to win."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"That...that's not true. "}]},{"spans":[{"text":"Why do you say that? Do I look like I'm slacking off?"}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"No, but I'm sure you could do better if you wanted, Vivi."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"How do you..."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"I know what I'm saying is going to put more pressure on you. "}]},{"spans":[{"text":"But I...I really want to win! "}]},{"spans":[{"text":"I want to win the prize! I want money, both for the Commander and myself! "}]},{"spans":[{"text":"It's been...so long since the dorms were last renovated."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"PP-90..."}]}]},{"sprites":[],"ops":[],"speaker":"ISAC","narrator":false,"pages":[{"spans":[{"text":"Warning. Agent is suffering from starvation."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ISAC's warnings are coming more and more frequently. They both know that they're close to their limit. "}]},{"spans":[{"text":"PP-90 slowly walks up to Vector, then takes out the only remaining ration can from her backpack."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"You must survive until the end, for my sake."}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"PP-90, you...!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vector stares at PP-90, and the words she wants to say lodge in her throat, like she's contracted some kind of illness."}]}]},{"sprites":[{"prefab":"PP90","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"Remember, I want a renovated dorm—"}]}]},{"sprites":[],"ops":[],"speaker":"System","narrator":false,"pages":[{"spans":[{"text":"X Not A Wig They're Drills died of hunger."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2020TCTDdarkareaV","raw":"BIN"}],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"—!!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vector reaches out desperately, but PP-90's body, which has been right in front of her just moments ago, evaporates into a pillar of light "}]},{"spans":[{"text":"Her hands flail wildly, but the only thing they grasp is the empty air."}]}]},{"sprites":[],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"...You idiot..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vector slumps weakly to the ground. All that remains in front of her is the item pickup light, which is as bright as ever. "}]},{"spans":[{"text":"The last can of food remains where PP-90 left it, in front of her."}]}]},{"sprites":[],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"No... I'm the idiot."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vector picks up the ration can. PP-90's voice still echoes in her ears. "}]},{"spans":[{"text":"She stares at the can, still utterly stunned."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...To think that this tiny can was what had landed the both of them in this predicament. "}]},{"spans":[{"text":"They...they had been talking normally just a moment ago. "}]},{"spans":[{"text":"And in the end, for such a laughably trivial reason—!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"—!! "}]},{"spans":[{"text":"P—P—9—0—!"}]}]},{"sprites":[],"ops":[],"speaker":"ISAC","narrator":false,"pages":[{"spans":[{"text":"Warning. Agent is suffering from starvation."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After letting her balled-up fists fall weakly to the ground, Vector gulps down the contents of the can through gritted teeth."}]}]},{"sprites":[],"ops":[],"speaker":"ISAC","narrator":false,"pages":[{"spans":[{"text":"Agent is no longer in a state of hunger."}]}]},{"sprites":[],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"...Watch me. "}]},{"spans":[{"text":"...I WILL survive, until the very end."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She wipes the corner of her mouth, and her eyes flash with steely determination. "}]},{"spans":[{"text":"...It's time to move out.<火焰销毁></火焰销毁>"}]}]}]}
