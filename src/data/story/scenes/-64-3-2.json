":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Commander?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 390 thought the Commander would be interested in the organized warehouse, but the sight of the place only seems to have deepened their frown."}]},{"spans":[{"text":"She is a bit at her wits' end, but determined to turn this important mission around, she decides to move on to the next place."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Commander, let's keep going then."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
