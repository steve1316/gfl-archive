{"name":"-64-3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_SAC2045_Utopia","raw":"BGM"},{"type":"effect","value":"%%code=CJ_WC_piaofu%%","raw":"common_effect"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"19winter_inbg_2","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In a supply warehouse in the Ministry of Plenty, Sector 2Z64."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 390 lightly dusts off the clock in the corner of the warehouse. The hands are not moving anymore."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Commander, this is where we distribute our supplies. Residents of Sector 2Z64 come here for anything they lack."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"TPS...?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"No. 387, here for some supplies?"}]}]},{"sprites":[{"prefab":"TPS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"No. 387","narrator":false,"pages":[{"spans":[{"text":"Yep! And this is? An unfamiliar face!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text"