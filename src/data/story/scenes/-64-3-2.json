hy your package will take a bit longer to get here."}]}]},{"sprites":[{"prefab":"TPS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"No. 387","narrator":false,"pages":[{"spans":[{"text":"It's always the same excuses!"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"QBU-191","narrator":false,"pages":[{"spans":[{"text":"Commander, you're here."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ibis, has the logistics corridor still not been repaired?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"QBU-191","narrator":false,"pages":[{"spans":[{"text":"Unfortunately no. We lack the manpower and funds for the repairs..."}]}]},{"sprites":[{"prefab":"TPS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"No. 387","narrator":false,"pages":[{"spans":[{"text":"Commander, you need to sort this out quick! The other streamers have all cleared the stage already while I haven't even started!"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"The Commander has enough things to worry about. Please spare them your recreational problems."}]}]},{"sprites":[{"prefab":"TPS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"