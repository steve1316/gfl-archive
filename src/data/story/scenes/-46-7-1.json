or":false,"pages":[{"spans":[{"text":"I can't sense Ouroboros' presence, but I have the feeling that she's right here."}]}]},{"sprites":[{"prefab":"BOSS-2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"I wonder what that creepy woman is up to now."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"Shh."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_FT_Heel","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sound of high heels clacking against the ground echoes toward them from the depths of the hallway."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"BOSS-2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"Isn't that—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A familiar woman emerges from the darkness before executing an elegant bow."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"It seems Ouroboros has prepared quite a bit of entertainment for us."}]}]}]}
