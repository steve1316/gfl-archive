{"name":"-73-A-16","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"},{"type":"night","raw":"Night"},{"type":"background","value":"2021white_Bernvillage","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23SF_Battle_1","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the highway on the west bank of the canal, Dark Zone, Kamona."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Having shaken off Blackgold's pursuit, the Commander takes over the driver's seat. With only a sparse cache of ammunition and supplies left, they speed across the Kamona plains."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"night","raw":"Night"},{"type":"background","value":"202407_Car_b","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Are you sure your leg's fine?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Look."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander pulls a contoured steel plate out from their left pant leg and tosses it aside. A dent is clearly visible on the metal."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Impressive."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}},{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"And you? Why did you come back?"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}},{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Uh... well..."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}},{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"I thought about it, and you guys are such noobs. Without me, you're definitely screwed. So I figured I'd reluctantly tag along a little longer."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Mm. You're right."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I believe you."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hey, I'm serious!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"So are we... Hahahahahaha..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hahahaha..."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"...Hey! Enough already!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Alright, alright, we'll stop. Thanks, Kuro!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hmph... Sure..."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Just so we're clear—I didn't come back for that client. I came back for you guys."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"I know. Kuro, you're the best!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing that Kuro is still sulking, Mityl throws an arm around her neck and pulls her into a big hug."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hey, hey, hey! You're choking me!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Welcome back!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The night wind blows as the wind turbines spin silently on either side. The headlights cut a clear path ahead through the darkness. There's no one else around—only the three of them, alone in the Kamona wilderness."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Where are we going?"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Doss controls Floranpino. If Beluga wants to take the box back and avoid Hecate's people, there's only one path she can take."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Bridge 794!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah. We haven't lost too much time. I know a shortcut—we can catch up with her there..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Then we'll ask her how it feels to be Doss' lapdog."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_carmona","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"night","raw":"Night"},{"type":"background","value":"2022winter_Town","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Half an hour later, the car passes through an abandoned town."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl, who has been laughing and joking in the backseat, suddenly falls silent as she stares out the window."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"What's wrong?"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"...This was my home."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The road is riddled with potholes and scarred by deep tire marks from military vehicles. The buildings on either side have been wrecked by shelling, and rubble lies strewn across the road."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander carefully navigates around the debris, slowing the car even more."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"When the war reached here, I lost my home and my family. I was lucky. A special operative found me and let me follow him. He was the one who taught me how to shoot."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"A few years later, he took on a job and never came back. Before he left, he gave me a gun. I used it to complete my first gig."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"After that, I kept taking jobs, scrounging junk, stashing more and more stuff, saving up more and more money..."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"I even found a smuggler willing to get me out. Once I finish this job and get the payment, I can finally leave Kamona. For good."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl turns her gaze back into the car and instinctively reaches for the giant backpack that she always carries—only to realize she has left it on the riverbank. Her raised hand falls onto the empty seat."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Don't you worry. I'll get you a bigger pack."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl forces a smile."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Is this smuggler really trustworthy? I've heard it's getting harder and harder to leave the Dark Zone lately. You sure you're not getting scammed?"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"I don't think it's a scam? It's someone named Evita—she's a contractor in Marulos. I've taken jobs from her before. Seemed reliable."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Evita? I know her too. She may really have a way to get you out."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Come to think of it, I've seen her quite recently. If she hadn't helped me back then, I wouldn't have gotten this job in the first place."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander is momentarily distracted. The front-right tire runs over a massive rock, the steering wheel jerks, and the car lurches toward a pile of rubble."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Brake! Brake!"}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=4%%delay=0%%range=3","raw":"controll_shake"},{"type":"sfx","value":"AVG_brake","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A shrill screech fills the air. The car halts just short of the mound."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"What happened?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sorry. I was just... taken by surprise..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"background","value":"2022winter_Study","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Listen. Don't stay in Marulos for the next little while. It's better if you take an out-of-town job."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"},{"type":"background","value":"202407_Car_b","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander shifts gears and reverses, restarting the vehicle."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We all know Evita, and we all saw her before this mission."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Is that a problem?"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Not necessarily."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Evita is a well-known contractor in the Dark Zone. It's a coincidence, but not suspicious."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"But there's someone else you know. And that's not so easy to explain."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Who?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hecate."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Who?! That psycho woman who almost got us all killed?!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"I went back for you guys after I found the car, but Blackgold's people had already surrounded the area, so I had to hide in the woods. I saw everything."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"When you looked back and saw Hecate, you clearly recognized her."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Fine. I admit it."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We've met once."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"night","raw":"Night"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"background","value":"树林","raw":"BIN"},{"type":"flashback","raw":"回忆"},{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Four years ago."}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"I'll say it again. Your mission is to rescue the hostages trapped in the mountaintop camp and ensure their safety. Is that clear?"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"众人","narrator":false,"pages":[{"spans":[{"text":"Yes, sir!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a forested valley somewhere in Kamona, a uniformed officer is delivering a briefing. Before him are soldiers standing in a neat row—and six slack-looking special operatives."}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"The hostages are at the top of the mountain. Three sides are cliffs; only the northeastern slope is suitable for approach."}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"It's dense with rocks and trees, so I've brought in six local operatives familiar with the terrain."}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"Stand up straight!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The officer barks at the slouching operatives. They straighten up instantly."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What a hard-ass..."}]}]},{"sprites":[],"ops":[],"speaker":"Old Friend","narrator":false,"pages":[{"spans":[{"text":"Shh."}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"What was that? Speak up so I can hear it."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sir! We will complete the mission, sir!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"Hmph."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander is among the six, whispering to a friend."}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"This mission is important. Anyone who performs well gets a commendation. Whoever takes the lead role gets a rank promotion!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What if it's an operative?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"What a joke. An operative? Fine. If one of you gets the lead, I'll push to get them admitted into the military. Any other questions?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No, sir. Thank you, sir!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's friend elbows them, whispering excitedly."}]}]},{"sprites":[],"ops":[],"speaker":"Old Friend","narrator":false,"pages":[{"spans":[{"text":"The military! Did you hear that? The military!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Of course I heard."}]}]},{"sprites":[],"ops":[],"speaker":"Old Friend","narrator":false,"pages":[{"spans":[{"text":"Join the military, and you get a chance to leave Kamona..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It can't be that easy. They're just stringing us along."}]}]},{"sprites":[],"ops":[],"speaker":"Old Friend","narrator":false,"pages":[{"spans":[{"text":"God, I don't care where—I just want out of the Dark Zone...","style":{"size":"25"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lost in dreams of a better future, the friend doesn't notice the Commander's cynicism."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hey, look at that one with the dark hair."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the front row stands a girl with short dark hair, dressed in uniform and carrying a full set of climbing gear."}]}]},{"sprites":[],"ops":[],"speaker":"Old Friend","narrator":false,"pages":[{"spans":[{"text":"What about her?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"When the officer was making promises, she shrugged. Clearly didn't believe a word, haha..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"Quiet!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ahem..."}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"The winds are too strong for helicopters today. The northeastern slope is the enemy's only retreat path. We'll advance from there and trap them—"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Dark-Haired Girl","narrator":false,"pages":[{"spans":[{"text":"Sir!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The dark-haired girl suddenly speaks up."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dark-Haired Girl","narrator":false,"pages":[{"spans":[{"text":"I found a potential escape path on the southern cliff during reconnaissance. The enemy might retreat that way."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"You said it yourself, \"Might.\" \"MIGHT!' That cliff is steep—how would they get down with hostages? What about the others who scouted south?"}]}]},{"sprites":[],"ops":[],"speaker":"Soldier","narrator":false,"pages":[{"spans":[{"text":"Sir! I believe the south is impassable."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dark-Haired Girl","narrator":false,"pages":[{"spans":[{"text":"If we only attack from the northeast and they escape another way, the mission fails."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dark-Haired Girl","narrator":false,"pages":[{"spans":[{"text":"I request—"}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"I've scouted it too. No way they're getting out that way!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The officer cuts her off, clearly irritated."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch","raw":"SE1"}],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"I don't care how smart you were in the academy or what your scores were. This is Kamona. The Dark Zone. Not your fancy simulation lab!"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the officer drones on, the dark-haired girl falls silent."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Interesting."}]}]},{"sprites":[],"ops":[],"speaker":"Old Friend","narrator":false,"pages":[{"spans":[{"text":"What is?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Say, if that soldier's right... what then?"}]}]},{"sprites":[],"ops":[],"speaker":"Officer","narrator":false,"pages":[{"spans":[{"text":"You again? If you've got something to say, say it to my face!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander sighs and steps forward."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sir! I agree with her."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"night","raw":"Night"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"},{"type":"background","value":"202407_Car_b","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":