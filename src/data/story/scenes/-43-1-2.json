ight?"}]},{"spans":[{"text":"Jeez, you nearly sacrificed my shoes for nothing... Hey, quit eyeing them!"}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"Everyone, gear check. We'll leave once 90 returns."}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"Huh? We're just going to leave?"}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"R93","narrator":false,"pages":[{"spans":[{"text":"Do you really want to do a divination so badly?"}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"R93","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"I'm just thinking that we might be pretty slow, but they seem even slower. Don't you want to see who's coming after us?"}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Vector","narrator":false,"pages":[{"spans":[{"text":"We don't need to waste time on our pursuers. Once 90 returns, we'll leave immediately."}]}]},{"sprites":[{"prefab":"PP90","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PP-90","narrator":false,"pages":[{"spans":[{"text":"I'm back! Did you just say you needed me, Vivi?"}]}]},{"sprites":[{"prefab":"Vector","expression":0,"shown":true,"side":"left","tags