{"name":"-73-A-20","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Moto_Run","raw":"SE1"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"树林","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_NightOPS","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The trio get back in the car with the box and head toward the Northridge Hotel."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"night","raw":"Night"},{"type":"background","value":"202407_Car_b","raw":"BIN"},{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro climbs from the back seat into the front passenger seat. She unfolds a massive map and studies the route."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"This is truly a treasure we got from Doss—it's the most detailed map of the Dark Zone I've ever seen."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"We're here right now, and the Northridge Hotel is northeast of us. To get there, we'll have to pass through the mines..."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Ugh... Let's hope the boss there isn't interested in this box."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't count on it."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Is there any route that avoids the large factions' territories? We can go the long way. We still have... 13 hours."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"The mines or the farm. Take your pick."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"...Not thrilled about either of those graveyards."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Look on the bright side—we might make it through without trouble."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I know a way, but we can't take the car. And it's not an easy climb."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Where is it? It has to be better than the other two options."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Check the gear in the back. See if we have any climbing equipment."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"There's a path on the south face of the mountain. If we start from here, we can climb up and go over."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.43%%scale=1.5%%duration=0%%","raw":"bg_move"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"flashback","raw":"回忆"},{"type":"background","value":"2024AB_Hecatec","raw":"BIN"},{"type":"sfx","value":"AVG_AMB_Wind","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"night","raw":"Night"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Four years ago, on the south cliff of the mountain."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Over here, there's a foothold."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander and Hecate scale the sheer cliffside with their bare hands. The strong night wind makes the climb all the more treacherous."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"To avoid alerting enemies, they've dimmed their headlamps to the lowest setting. Every step and grip is executed with painstaking care."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Didn't think they'd only send the two of us this way. If we run into hostiles, it's going to be a problem."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Did you piss off your superiors or something?"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Haven't asked yet—what's your name?"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"You don't need to know."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If something happens, I should at least know what to call you."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"There's no one else here. Obviously, I'll know you're talking to me."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Don't slow me down."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate doesn't engage further. With swift, practiced movements, she uses the natural protrusions of the rock to overtake the Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Careful..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Now I understand why your superiors don't like you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander looks up and aims their headlamp at a small patch of rock, inspecting it carefully."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"When I was scouting the terrain in daylight, I noticed this area had far less vegetation than the rest. It looked like it'd been cleared by hand—made me suspect there might be a climbable route."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How'd you spot that?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate stops. Hanging by her left hand from a jutting rock, she pulls something from her pocket with her right."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"A piton? For securing ropes?"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Mm. Found it below."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She tucks it away again and continues her climb. The Commander searches the surrounding wall but finds nothing."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So there is a path up alright."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We're already at least 15 meters off the ground and haven't found any other pitons... If there were more, this climb would be a lot easier—"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ah!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander slips, their foot skidding off the rock. They catch themselves with their right hand, now dangling off the cliff."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Useless..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Zipper","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Even as Hecate mutters the insult, she descends two meters without hesitation and returns to the Commander's side."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Still holding on?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm fine."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander finds another foothold and steadies themself, then pulls two thin steel plates from behind their calf and drops them."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Too cumbersome to keep carrying."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"What are those?"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"\"Kamona Rules of Engagement, Article 11, Section 3—'When aiming to take targets alive, prioritize disabling shots to the legs to impair mobility.'\""}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I got that right, didn't I? It's from your military handbook."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"...Yes."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Haha..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They both understand the delicate relationship between foreign forces and Kamona's local task units. Neither chooses to comment further, and the climb continues in silence."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Look."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_button","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander stops and pulls out a small flashlight, directing the beam at a section of rock nearby."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A piton is driven deep into the cliff face."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We were right."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With that piton found, they quickly locate a second and third along the path."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Attaching their climbing rope with carabiners, they begin securing their ascent. With the added safety and support, they move faster and are soon halfway up the mountain."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"flashback","raw":"回忆"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.55%%scale=1.5%%duration=0%%","raw":"bg_move"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The wind grows stronger the higher they go. For safety, they have to slow their pace."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why aren't we using the same rope? With wind this strong, we'd be able to help each other if something happens."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If I'm not mistaken, we're still on the same side."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"I can handle myself."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But it'd be safer."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"A rope is a climber's second life. I'm not putting mine in someone else's hands."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"On the battlefield, you need to trust your teammates."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Only the weak need to huddle together."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing that Hecate isn't budging on this, the Commander drops the subject. In no time, they ascend another dozen meters."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_button","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Suddenly, Hecate turns off her headlamp."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_button","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander doesn't know why, but they quickly do the same and grow still."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"From above, a rappel rope drops down."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"Bring the hostage up. We're pulling out."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1%%duration=0%%","raw":"bg_move"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"2024AB_Hecatec","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_stage11","raw":"BGM"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"You discovered this path back then?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It is now dawn. Only 12 hours remain until the deadline set by the client."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander, Kuro, and Mityl struggle up the steep southern face of the mountain."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Mhm. I didn't think it'd still be here after all these years."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Then Hecate must know about it too, right? What if she's lying in ambush..."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's possible, but it's still better than walking straight into the mines and risking a direct confrontation."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"At least this route is so rough that even if Hecate's waiting, she can't bring many people with her."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Still risky as hell. I really don't want to run into that woman again."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Let's hope Beluga's plan worked and Hecate isn't chasing us anymore."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The three of them are tied together securely by a single climbing rope, with the Commander leading the way, and Kuro and Mityl following behind."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The box has been left at the base of the mountain, tied to the rope and secured to the Commander's harness."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"There's a small ledge ahead. We'll climb there first and pull the box up from there."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"How far is it? I'm getting tired."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl calls from the back. To lighten her load, she had even abandoned the freshly restocked backpack at the foot of the mountain."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Almost there."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander reaches the edge of the platform, braces both hands on the rock, and pulls themself up."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"},{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the ledge, Hecate and four Blackgold operatives are already waiting."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"You're slower than I expected."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Five guns are pointed at them, but at this position, they have no choice but to climb up."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't shoot. We can talk this through."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The three stand at the edge of the cliff, face to face with the operatives of Blackgold Universal."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Long time no see."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Indeed. I thought you hadn't recognized me."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"I don't want to admit it, but... those steel plates behind your calves actually came in handy."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So that's what gave me away... You haven't changed much either."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Enough catching up. Same deal as before—hand over the box, and we'll let you go."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"We don't have the box."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Our fight with Doss at Bridge 794 caused quite a commotion. Blackgold must've caught wind of it."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Doss took a box."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"But the one I'm after is yours."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"...As you can see, we're standing here, the three of us—no box."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We lost it. We're just trying to lay low now in case the client comes after us."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Then toss the rope clipped to your harness."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The rope in question is connected to the box at the base of the mountain."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Pull it up."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro and Mityl glance at the Commander. Hecate fires a warning shot into the air."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Pull. It. Up."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander gives a slight nod."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl and Kuro also grab the rope and start pulling together."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander isn't using all their strength—they're stalling, buying time."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I have a question. Blackgold is chasing more than just this box, right?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Then why would the leader of the Abyss Squad personally come after us?"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm just curious."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Your client leaked a false trail. Told everyone the real box was with you."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"The leak was too convenient. Most people now think your box is a decoy planted on purpose."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"But I don't buy it."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"I think your client is sneakier than that, and I think you didn't lose it."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Honestly? I don't even know if this box is the real one."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But you're right about the second part."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The box is only a few meters below the ledge. The three slow down, exchanging glances and silently asking each other what to do."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Blackgold Operative","narrator":false,"pages":[{"spans":[{"text":"Hurry it up!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Started by the Blackgold operative's sudden shout, Mityl stumbles backward and steps on a loose rock."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She falls over, and the rope slips from her hands. The box drops a few meters."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"shake","raw":"震屏3"}],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Hold it!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate instinctively moves forward to grab the rope, but stops herself just in time."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander and Kuro are yanked forward, but manage to halt the box's fall. Mityl scrambles up and grabs the rope again."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"...Sorry."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's okay."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing that the box is once again secured, Hecate lets out an almost imperceptible sigh of relief. She gestures for the Blackgold operatives to stay put."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Pull it up. No tricks."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But the Commander stops moving."}]}]