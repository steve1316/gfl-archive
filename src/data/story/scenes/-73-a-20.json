],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're scared of losing."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's make a bet. If the three of us can break through your encirclement, we walk away with the box."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If we fail, it's yours."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro opens her mouth, but Mityl grabs her arm."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"I believe in us!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"You think I was gonna stop you?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hey, you lot! It's five against three. Don't tell me you're scared?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"One of Hecate's men starts to speak, but another cuts them off."}]}]},{"sprites":[],"ops":[],"speaker":"Blackgold Operative","narrator":false,"pages":[{"spans":[{"text":"Did you forget? Our first priority is to ensure the safety of the box.","style":{"size":"25"}}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.6","raw":"CGDelay"}],"speaker":"Hecate","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"I accept."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
