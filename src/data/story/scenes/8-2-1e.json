{"name":"8-2-1E","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Persica!"}]},{"spans":[{"text":"..."}]},{"spans":[{"text":"Calling Persica!"}]}]},{"sprites":[{"prefab":"Persica","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Oh, yeah. I'm here."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"工厂背景avg","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Sorry. I was checking on M4."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"How...is she?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Everything is...going according to plan."}]},{"spans":[{"text":"But that aside, RO didn't see you do anything back in the database, did she...?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"No, I already had it sorted by the time she came out."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I see... How are you doing?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Humph. You'd better not tell me...it's not too late to regret my decision."}]},{"spans":[{"text":"But I do have a question. Let's just say it's some wild suspicion caused by instability in my neural cloud. Can you answer it?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Now that we're here...ask ahead."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Regarding Lyco's death, I ran a search in Griffin's database, and 378 reports stated that he died in an accident."}]},{"spans":[{"text":"So I don't understand why you're so hung up on it..."}]},{"spans":[{"text":"Whatever he's done, he's already dead. Why do you still care?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Because his death was extremely suspicious."}]},{"spans":[{"text":"Even if he did die, it couldn't have been an accident..."}]},{"spans":[{"text":"Which is why I'm not buying it."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Ha, who knew you can be so astute."}]},{"spans":[{"text":"Are you really just a scientist, Persica?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Like you, M16, I've had some narrow escapes from death. Survival is a skill."}]},{"spans":[{"text":"In any case, that thing is your target."}]},{"spans":[{"text":"The commander will hold off S.F.'s attack so that you can investigate safely."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Investigate...that strange signal source...?"}]},{"spans":[{"text":"When on earth did you notice that?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"When RO infiltrated the Sangvis mainframe and started searching for File No. 7..."}]},{"spans":[{"text":"I secretly conducted a multi-channel search on the network using RO's neural cloud and downloaded an interesting file."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I want to remind you that all files in the Sangvis mainframe are potentially virus sources..."}]},{"spans":[{"text":"Humph, but it hardly matters now, does it..."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Even RO herself can neutralize that kind of feeble Sangvis virus, but that's not the point."}]},{"spans":[{"text":"The reason I downloaded this particular file is because it's encrypted in a way that's completely different from standard Sangvis encryption method."}]},{"spans":[{"text":"Therefore, this is a message. An invitation that promises anything but a fool's errand... You got the coordinates, right?"}]}]},{"sprites":[{"prefab":"M16","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Invitation...you say?"}]},{"spans":[{"text":"In all my days on the field, I've never received such an ominous invitation."}]}]},{"sprites":[{"prefab":"M16","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"What? You're feeling skittish now that you've come this far?"}]}]},{"sprites":[{"prefab":"M16","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Even MY neural cloud can suffer a breakdown... Especially now."}]},{"spans":[{"text":"...Too bad...it can't be backed up."}]},{"spans":[{"text":"All this experience...can't be of use for M4."}]}]},{"sprites":[{"prefab":"M16","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You seem to...think about her in everything you do."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Yeah..."}]},{"spans":[{"text":"This is all for the sake of protecting M4..."}]},{"spans":[{"text":"This is the only order you've given me, and it's absolute."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I'm glad that you still remember."}]},{"spans":[{"text":"She'll wake up very soon, M16."}]},{"spans":[{"text":"If you move quickly, you might still make it in time to tell her goodbye."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Nah, it's fine. I don't have time to think about what to say..."}]},{"spans":[{"text":"Better get on with it. That's...the only thing I can do now."}]}]}]}
