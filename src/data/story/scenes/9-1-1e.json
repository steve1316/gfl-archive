{"name":"9-1-1E","beats":[{"sprites":[],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the AR Team's temporary safe house one week after M16A1's disappearance."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Hey...SOP II."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What's up?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Does the AR Team get into situations like this often?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I mean right now... A situation where we've lost contact with HQ and are surrounded by hundreds of Sangvis troops in a run-down factory with only a single magazine of ammo left..."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Well...I was in a similar situation a year ago when I got split up with M4 and the others, though there weren't this many enemies..."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That is to say...it's even worse right now?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Mmmm... I guess so?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Right...right..."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...RO suddenly stands up."}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yet you still opened fire on the enemy! SOP II! Didn't I say that we would sneak past that outpost!"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I don't think it would've been possible to sneak past them under those conditions."}]},{"spans":[{"text":"Rather than waiting to be discovered by the enemy, why not take the initiative ourselves?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I had already disguised our signals. Those low-level Sangvis troops wouldn't have been able to recognize us!"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Even if we were right in their face?"}]},{"spans":[{"text":"Wow...it's that awesome?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Of course it is... Wait, that's not the point! What I mean is that you should trust me. I'm the commander and I won't put us into unnecessary danger, understand?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Alright, alright..."}]},{"spans":[{"text":"But that's pretty awesome, is it new technology from 16Lab?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Heh, what's even better is that I can scan the number of enemies behind me while running right now."}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"But we're not running right now..."}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That's why I said \"now\"! Run, they're going to surround us!"}]},{"spans":[{"text":"Want to guess how many Sangvis troops are on our tail, you little troublemaker?!"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Lemme see... A little over a hundred?"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Stop looking and run!"}]},{"spans":[{"text":"Aaaaah! Help us, Commander! Hurry and locate our position already!"}]}]}]}
