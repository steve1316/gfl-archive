{"name":"-32-3-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"m_va_showtime","raw":"BGM"},{"type":"background","value":"BG-Cybercity","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Meanwhile in Griffin City, in front of City Hall. "}]},{"spans":[{"text":"...A great deal of Griffin Dolls and humans are gathered in a protest."}]}]},{"sprites":[{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"Wow...there are so many people."}]}]},{"sprites":[{"prefab":"MP446","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Viking","narrator":false,"pages":[{"spans":[{"text":"That's why I didn't want to come here, it's so damn bothersome!"}]}]},{"sprites":[{"prefab":"MP446","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"But there's nowhere else to go. All the shops and bars are closed, so we've got no choice but to — ah!"}]}]},{"sprites":[{"prefab":"MP446","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Gr MP5 is suddenly tripped by a human."}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Ah...sorry."}]}]},{"sprites":[{"prefab":"MP446","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Viking","narrator":false,"pages":[{"spans":[{"text":"Gr MP5, are you alright?"}]}]},{"sprites":[{"prefab":"MP446","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The human woman stares at Gr MP5 and nods. She then helps her up and walks away."}]}]},{"sprites":[{"prefab":"MP446","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Viking","narrator":false,"pages":[{"spans":[{"text":"What a strange native."}]}]},{"sprites":[{"prefab":"MP446","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"...I think I've seen her somewhere before."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The human woman continues to make her way through the crowd."}]}]},{"sprites":[{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Parapluie infection successful... This module's functions are normal."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"Stella, this is Crimson Rose. I'm in position.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Roger. Keep an eye on the situation. Report immediately if anything develops. "}]},{"spans":[{"text":"The last time I saw this many people was when the Prime Minister took office, and it was Mega Christmas to boot."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"Indeed, but security now is very thin. It's full of holes.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"The White Knights haven't shown up, so it seems that Architect and Sei...have successfully delayed Jericho. "}]},{"spans":[{"text":"And the Prime Minister doesn't believe the Dolls will do anything out of the ordinary, which would be true, unless..."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Stella touches her electronic right eye."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"}],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Unless they were all mine."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"I can hear you breathe. You sound a little tense.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Oh? You could hear that in such a noisy place?"}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"How much did you spend to buy me? I told you before, I'm worth every penny.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"It's true that I am very nervous. Even I don't know what's going to happen after this... "}]},{"spans":[{"text":"I took advantage of my friend for this moment, so I can't fail. "}]},{"spans":[{"text":"Just in case, I'm going to ask you again; if I ordered you to shoot the civilian Dolls here, will you really do it without question?"}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"Jeez. Let me say it again.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I'm just a product. You bought me, so I'll obey all of your orders unconditionally. Do you want to try me out right now?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"No, I don't want to mess up the plan, and I want to avoid that scenario if possible. "}]},{"spans":[{"text":"I'm sorry, I have full faith in you now."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"You really are too tense. Don't hang around in that crowd too long. You need to keep your breathing under control.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"You're right. Many Dolls here have perfume on; I'm not sure what brand it is, but there's diesel mixed into it. "}]},{"spans":[{"text":"Don't worry about me. Keep your eyes on the stage; the Prime Minister's going to show up soon."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"Are you sure? Even the TV stations said that there was no way she'd make an appearance.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Do you believe those politicians or me?"}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"(Laughs) Doll politicians have got to be better than the human ones.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"Politicians are politicians. They're all the same even if you appoint them from Seifar employees. "}]},{"spans":[{"text":"I'll say it again for you. My confidence comes from the S.F. module in my right eye. It can spread the Parapluie virus and infect every single Griffin Doll in the vicinity. "}]},{"spans":[{"text":"Every single Doll on this street and inside that big building will serve as my eyes and ears."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"Well isn't that handy? Who would have known that the right eye that S.F. took from you would become the tool for controlling this entire world?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I just want to save Griffin City. I'll pay any price to achieve victory."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"I should post those words of yours to Fatebook. I'm pretty sure you'll get a ton of likes after this is all over.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"By all means, but mind the angle this time around. "}]},{"spans":[{"text":"The picture last time...made my chest look a little big."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"The picture last time got the most likes of all—","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Hang on...she's coming. Our Prime Minister is about to show up.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Looks like you win, Stella.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"No, not yet."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Dorothy","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_va_troubling_news","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Ladies and natives! Good Southern Hemisphere! "}]},{"spans":[{"text":"I am the Prime Minister of Griffin City that everyone knows and loves! "}]},{"spans":[{"text":"I am Dorothy, Dorothy Haze, the cutest of them all! I'm very happy to see you!"}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"...This victory only counts when I announce it myself."}]}]},{"sprites":[{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Dear citizens of Griffin City, every Doll, every human, every single screw and cell! "}]},{"spans":[{"text":"I know everyone's concerned about the weather around the globe, and I fully understand how you feel! "}]},{"spans":[{"text":"Therefore, tonight, I will be taking everyone's questions about the global sand rains in an open and sincere fashion in a public and live-streamed event. "}]},{"spans":[{"text":"Please believe me when I say that I will always have your concerns at heart, and I will devote all of my efforts from now on to solving everyone's problems!"}]}]},{"sprites":[{"prefab":"G28","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G28","narrator":false,"pages":[{"spans":[{"text":"Prime Minister Dorothy! (Raises hand)"}]}]},{"sprites":[{"prefab":"G28","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Human Bodyguard","narrator":false,"pages":[{"spans":[{"text":"Hey, you can't come up here!"}]}]},{"sprites":[{"prefab":"G28","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G28","narrator":false,"pages":[{"spans":[{"text":"But I want to ask a question! And I want to see Prime Minister Dorothy!"}]}]},{"sprites":[{"prefab":"G28","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Dorothy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Uh...have I seen you somewhere before?"}]}]},{"spri