:[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Ah... Sorry, my mistake."}]},{"spans":[{"text":"Heheh. In any case, I'm the one who cleaned up your mess, so thank me properly."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Huh... What even..."}]},{"spans":[{"text":"Whatever. It's on Agent's orders anyway. Do what you want."}]},{"spans":[{"text":"But I'm sure you know where not to hit with your shells..."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Of course. I'll be careful as I sweep the carpet."}]},{"spans":[{"text":"Go back to your nap, Destroyer. Would you like a lullaby?"}]}]},{"sprites":[{"prefab":"Destroyer","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Thanks, but no thanks... I've had enough of nightmares..."}]},{"spans":[{"text":"Squids all over the place... Just thinking of it makes me squirm..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...RO breaks the connection."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I was right... We're dealing with yet another tough one..."}]}]},{"s