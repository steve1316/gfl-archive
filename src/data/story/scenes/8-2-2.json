{"name":"8-2-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Interior of Base 0, fifteen minutes into the operation."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"RO, this should be the heart of Base 0."}]},{"spans":[{"text":"The Commander just swept the place for us. There's no better place to set up the anti-jamming field."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Oh, we're there already? How can you be sure about that without detailed maps of this area?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Which would you place your bet on, downloaded data or my experience on the field?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"So you're banking on your experience...?"}]},{"spans":[{"text":"Fine. I'll make the preparations now. SOP-II, find a high vantage point upstairs and keep watch."}]},{"spans":[{"text":"M16, hand me the verification data for File No. 7."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 fishes out a storage drive and tosses it over."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Thanks."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Treat that well. We almost lost our lives over that thingy."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"This was extracted from Safe House 3, wasn't it?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"\"To recover all of Lyco's research data from when he was alive\". This is pretty much the AR Team's raison d'etre."}]},{"spans":[{"text":"Now here we are, on the final step."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"(Chuckles) You don't seem particularly thrilled."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You know I don't give a damn about this."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"(Sighs) Still worried about M4A1...?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"But whatever the case, M16, I've always looked up to you all..."}]},{"spans":[{"text":"I read your battle records, and your performance on the field has always been impeccable."}]},{"spans":[{"text":"What you and SOP-II did during Operation Arctic Warfare only reinforces that."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Don't be ridiculous, RO. T-Dolls are technological goods. The newer the better, like yourself."}]}]},{"sprites":[{"prefab":"M16","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"There's nothing worth looking up to in someone like me...a T-Doll who can't even save her own team leader..."}]}]},{"sprites":[{"prefab":"M16","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"M4 will be fine, M16."}]}]},{"sprites":[{"prefab":"M16","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Haha... It'd be nice if that had come from Miss Persica."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 smacks RO on the shoulder."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Eh, don't mind me. I was just grumbling. Is the anti-jamming field ready?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yes, I'm about to activate it."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Notify the Commander to be prepared. S.F. is bound to detect our presence the moment we activate the field."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...M16, what is this place?"}]},{"spans":[{"text":"The way you and Persica behave...leads me to suspect this isn't just a simple Sangvis base."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Of course it isn't just a SIMPLE Sangvis base. We're right on Sangvis Ferri's doorstep. We can run into anything."}]},{"spans":[{"text":"But if you ask me what I know... Sorry, this is the first time I've ever been here."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You don't act like it."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Oh? Sadly, according to my neural cloud...I really haven't been here before."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Really...?"}]},{"spans":[{"text":"M16, if you're hiding something from me..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You're the team leader. You know I can't hide things from you."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...M16 shrugs and establishes a connection to Persica's channel."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Ah...are we starting? My coffee is just ready."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Since we're short on time, Miss Persica, we'll focus on the objective of searching for File No. 7."}]},{"spans":[{"text":"You may record whatever you need, but please allow me to reject investigations of low priority."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Haha, that's a bit harsh, isn't it, RO?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The AR Team is created to recover Lyco's data. Isn't that what you said?"}]},{"spans":[{"text":"This is the safest, most reliable strategy for Griffin's and 16Lab's sake."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"It's fine, RO. Go look for File No. 7."}]},{"spans":[{"text":"I...I just wanna observe you guys in action..."}]},{"spans":[{"text":"After all...chances like this are hard to come by..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yeah...I understand..."}]},{"spans":[{"text":"The anti-jamming field is activated. I'm now connecting to Sangvis Ferri's mainframe to start searching for File No. 7."}]}]}]}
