{"name":"-73-A-6","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_arenabreakout_battle2","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"shake","raw":"震屏3"},{"type":"background","value":"2022winter_NPS","raw":"BIN"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Ha, another one down."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.2","raw":"CGDelay"},{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the warehouse by the port, cargo containers and shelves create a maze of cover. After hiding the crate and throwing a tarp over it, the trio launches a counterattack on their ambushers."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Who are these people? They got here fast."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"They're after the crate. Watch your left!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Without checking on her teammates behind her, Kuro vaults over the shelf and makes a break toward the front containers."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"cgDelay","value":"0.2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Fire!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"To her left, an enemy is driven back by a burst from the Commander."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"She's charging in on her own...? Hey, you!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before Mityl can finish, the Commander uses the lull in enemy fire to dash to the right."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"One forward, one right—shouldn't you at least try to coordinate?"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gunfire erupts from both flanks. Torn between helping either side, Mityl grits her teeth and runs for the stairs."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"From the second floor of the warehouse, the railing offers a wide view over most of the ground level."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"One, two, three, four, five, six... No, four left."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_The_Division_Grenade","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A grenade from Kuro and a clean sidestep-and-shoot from the Commander have thinned the numbers."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl sets up her rifle behind a crate."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! ...Missed."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! ...The shot bursts a water pipe in front of the Commander, spraying a high-pressure stream."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With their vision blocked, the Commander darts backward, avoiding a string of bullets fired through the mist."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Oops... My bad."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl whispers an apology that the Commander can't hear. Having exposed her position, she flips over the crate to seek new cover."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gunshots ring out all over the warehouse, accompanied by smoke grenades and the occasional crash of a collapsing shelf."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_NPS","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Phew... All clear, at last."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a stretch of silence confirms that the threat is gone, Mityl exhales and rushes downstairs."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"bgm","value":"BGM_23SF_Battle_1","raw":"BGM"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"You two okay? Anyone hurt?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Zipper","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Back by the crate's hiding spot, she shrugs off her oversized backpack that's wider than she is and slams it down, fishing out all kinds of medical supplies."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"I'm fine, though I almost died."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sorry. I didn't expect that grenade to drive him right into your line."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Forget it. Lucky for you, my movement was flawless."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With the crate safe and undamaged, the three start sweeping the battlefield."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Phone_Crash","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl reluctantly tosses away an enemy's assault rifle, pries out the magazine and stuffs it into her pack."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"That thing still has room? You sure you can carry it?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro tries lifting Mityl's backpack, but gets yanked down immediately by the weight."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"...Impressive."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander picks up the rifle that Mityl has discarded and straps it to their own pack."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"You're also scavenging now?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_ship_horn","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hoooooooonk—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The freighter outside blares its horn—it is about to set sail."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's move. Get to the ship."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2024AB_Freighter","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Captain","narrator":false,"pages":[{"spans":[{"text":"What's your business? You're not on the passenger manifest."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the gangplank, a middle-aged man stops them. Judging by his size, he hasn't missed many meals running this ship."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Captain, please do us a favor and give us a lift."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander discreetly slips something into the captain's hand. He rubs it between his fingers, then pockets it without a word."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We're moving a crate up to Northridge. You know how bad the roads are these days."}]}]},{"sprites":[],"ops":[],"speaker":"Captain","narrator":false,"pages":[{"spans":[{"text":"Whose crew are you with?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The bribe has smoothed the tone, and the Commander leans in to whisper a few words."}]}]},{"sprites":[],"ops":[],"speaker":"Captain","narrator":false,"pages":[{"spans":[{"text":"The Sewer Rats? I didn't hear anything. Who are you people?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The captain's face darkens again. Two sailors behind him raise their guns. Mityl stops Kuro from reaching for her own and puts on a near-tearful expression."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"I told you not to steal from the boss. What do we do now?"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"It was such a huge shipment that came in, we thought nobody would notice if a small amount went missing, but we haven't been able to get it out at all."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Captain, I beg you, please don't tip off our boss. We'll return the stuff right away."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With no rehearsal at all, Mityl jumps straight into the act. Her sobs stun everyone for a moment. Behind her, the Commander gives a subtle thumbs-up."}]}]},{"sprites":[],"ops":[],"speaker":"Captain","narrator":false,"pages":[{"spans":[{"text":"You stole this?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Yes. We just wanted to make a little side money. The bosses eat well while we don't even get scraps. We got greedy."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Here are our tags. Look, the Sewer Rats' logo. You can't fake that."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The captain examines the metal tags, checking the engraved symbol. After a hushed exchange with his first mate, he hands them back."}]}]},{"sprites":[],"ops":[],"speaker":"Captain","narrator":false,"pages":[{"spans":[{"text":"500k Koens."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"500k?! The cargo isn't even worth that much! Couldn't we..."}]}]},{"sprites":[],"ops":[],"speaker":"Captain","narrator":false,"pages":[{"spans":[{"text":"500k, not a coin less. Call it fare... and hush money."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He gives them a \"you get it\" look. Kuro pinches her thigh to resist the urge to pull a gun."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Fine. Mityl?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander doesn't have that much cash on them. They turn toward Mityl for help."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"...What, me?!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"...O... okay..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_Zipper","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a long internal struggle, Mityl pulls out a gold block from the innermost compartment of her \"Bag of Holding\" and hands it over reluctantly."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Meals are included, right?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Water_Drip","raw":"SE1"},{"type":"bgm","value":"BGM_TK_face","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-WarehouseOFF","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The cramped lower deck of the freighter reeks of mildew. The walls are stained with mold."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"500 grand and this is the kind of accommodation we get..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After checking for bugs or hidden mics, the Commander signals Kuro to help hide the box behind some cardboard boxes."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"At least it's safe. You really saved us back there."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"You reacted fast. It's almost like you'd turned into a different person."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"I'm great at mimicry. I can even do voice impressions."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"\"Allow me to introduce myself—I'm the contractor for this mission.\" How does that sound?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl mimics the voice from the radio earlier with uncanny accuracy. Kuro whistles in admiration."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Whoa! That sounded just like her! What do you think?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro glances at the Commander, who has fallen silent."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I have a feeling I've heard that voice before..."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Ugh... You think we can get reimbursed for the 500k Koens?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Ask when we finish the job."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"We're not even sure who our client is or how open they are to negotiation."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Wouldn't even show her face—doesn't seem like someone to mess with."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Who were those people at the port? We'd barely just set off when they jumped us. That intel moved fast..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander unstraps the new rifle that they have just picked up."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This rifle has been modified—shorter barrel, lower recoil, reduced range. It's more suited for tight spaces, but also harder to control..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Whoever they were, they're trained. Not your average thugs..."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Not average... You don't mean Blackgold Universal?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hey! Don't say scary stuff like that!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We can't rule it out. In the Dark Zone, only a few factions could field a squad like that."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Didn't stop us from mopping the floor with them though, did it?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Blackgold Universal is one of the biggest PMCs in the Dark Zone. If they're after this box..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...We're in trouble."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Silence fills the cabin. All three stare at the damned box. Mityl gets up and throws a few more cardboard boxes over it for good measure."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Try to be optimistic."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"From what I've heard, Blackgold has bigger plans. They should be too busy to bother with nobodies like us."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"I heard their Abyss Squad left their base recently. Probably on some big op."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Everyone in the Dark Zone knows—when Abyss moves, the sky changes."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Is that supposed to make me feel optimistic?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The cabin goes quiet again. Mityl gives up trying to further camouflage the box."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Anyway, enough gloom. The leader of the Abyss Squad, Hecate—I heard she got reported by her subordinate the other day."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"How do you know everything?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro grins and waves a communicator in her hand. The Commander notices that she has never put it down since they met."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Information is everything! In the Dark Zone, there are no secrets from me!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops"