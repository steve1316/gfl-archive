":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How did you know that?"}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[],"speaker":"Ninja","narrator":false,"pages":[{"spans":[{"text":"You mentioned it when you talked in your sleep last night."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"WHAT?!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You stop in your tracks, and the ninja finally stops holding onto your leg and gets to his feet."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[],"speaker":"Ninja","narrator":false,"pages":[{"spans":[{"text":"That's not the point. The important thing is—I know how to send you back."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How to send me back? How do I know I can trust you?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The ninja bows to you solemnly and resumes his nonsensical rambling."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"bgm","value":"m_avg_hope","raw":"BGM"}],"speaker":"Ninja","narrator":false,"pages":[{"spans":[{"text":"It all begins with Franchouchou, and it will all end with Franchouchou."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab