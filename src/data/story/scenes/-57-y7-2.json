{"name":"-57-Y7-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Park_a","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_amb_wilderness","raw":"SE1"},{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It's nighttime in the silent park. Even the wind is strangely quiet."}]},{"spans":[{"text":"Sakura stands in front of you, her smile as dazzling as always."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Time sure flies."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"When you think about it, it's only been a few days."}]},{"spans":[{"text":"However, I feel like I've known you forever."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Really? I feel like I've known you for a long time too, Commander."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"So long that sometimes, I think you might spend your entire life here."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"But that's impossible, right? "}]},{"spans":[{"text":"Tell me... about your original world."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Griffin?"}]},{"spans":[{"text":"...Well, it'd probably be very boring for you."}]},{"spans":[{"text":"Life there is hard, without much joy to it."}]},{"spans":[{"text":"There are mostly suffering, struggles, partings, and heartbreak, the sort of thing you'd expect from a messed up world."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Then why do you want to go back?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Because my friends and comrades are there and I can't abandon them."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Since that world is filled with suffering, then if they were true friends..."}]},{"spans":[{"text":"I think they'd want you to live in a world of peace."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes, and that's why I need to go back."}]},{"spans":[{"text":"Because I want to build a peaceful era with them."}]},{"spans":[{"text":"Just like here."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Just like here?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes... Back then, I said that I might be able to put down my identity as a Commander to be a manager, where my greatest challenge every day was how to put on a successful show."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Then... I guess I can't convince you to stay..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sakura..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sakura lowers her head, a hurt expression on her face."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"I'm sorry."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why are you apologizing?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Because I had a moment of selfishness just now."}]},{"spans":[{"text":"I wanted you to stay behind to keep us company..."}]},{"spans":[{"text":"But that would be disregarding your true ideals, I think."}]},{"spans":[{"text":"I belong in Franchouchou and you belong in Griffin. I... I shouldn't want you to give up your ideals... So I'm sorry."}]},{"spans":[{"text":"All this time... we've been causing you trouble and making you do all kinds of boring things."}]},{"spans":[{"text":"...I'm sorry."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Boring? You mean singing and dancing with you, and completing Franchouchou's concert?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Yeah, that sort of thing. I'm sure you must have found it lame, right?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I think it was very meaningful."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's because... It was your dream, Sakura."}]},{"spans":[{"text":"And your dream isn't lame at all."}]},{"spans":[{"text":"Even when I go back to a world without you in it, just thinking of your smile will fill me with courage."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"...Why is that?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Because I'll imagine that when my new world comes, there'll be many girls like you in it, full of life and courage, bringing happiness and hope to everyone."}]},{"spans":[{"text":"That's my driving force."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"...I just can't win against you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sakura takes out something from behind her back and hands it to you."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This is?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"effect","value":"%%code=Saga_Sakura_item%%","raw":"common_effect"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"...It's the loudspeaker I shout into during our daily training."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is it for me?"}]}]},{"sprites":[],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Yes... Ah, no..."}]},{"spans":[{"text":"No, yes!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Which is it?"}]}]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Park_a","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"...This is a cheap, everyday object. You can't really consider it a present. "}]},{"spans":[{"text":"The real gift is the words inside that I've left for you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You instinctively move to press the loudspeaker's button, but a red-faced Sakura grabs your hand."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"...Please, please wait until you leave this place before listening to them."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why is that?"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"...That way, when you return to your own time..."}]},{"spans":[{"text":"You'll be able to hear my voice. It'll be as though we were still living in the same era."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"That way, you won't forget the time you once spent with a girl called Sakura Minamoto."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I will never forget."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"And I'll be here, wishing to the moon every day, that the person who appeared and disappeared one night."}]},{"spans":[{"text":"That the Commander—"}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Will have finally returned to their own time and built a brave new world for themselves."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The night is almost at an end, and there are countless passers-by in the great journey of life."}]}]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=Saga_Sakura_item%%","raw":"common_effect"},{"type":"sfx","value":"AVG_Button_Click","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the darkness, you press that button."}]},{"spans":[{"text":"A girl's voice fills the air, filled with pep and vigor."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"I'm looking forward to seeing you again, Commander! When the time comes, I'm sure you'll be a mature manager of Franchouchou!\""}]}]}]}
