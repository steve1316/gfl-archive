that a dance?! And you're way off key!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Ugh... We're so sorry!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You open your mouth, but your objections die in your throat. "}]},{"spans":[{"text":"You really can't argue with that considering the absolute fiasco Franchouchou's performance has been."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The masked girl with silver hair slowly turns toward you with a dumbfounded expression."}]}]},{"sprites":[],"ops":[],"speaker":"Die-Hard Fan","narrator":false,"pages":[{"spans":[{"text":"Are these... alien impersonators or something?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Maybe..."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Production Assistant","narrator":false,"pages":[{"spans":[{"text":"What... what kind of lousy manager are you?!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=3%%delay=0.1%%range=8","raw":"controll_shake"},{"type":"sfx","value":"AVG_Crowd","raw":"SE1"}],"speaker":"Audience","narrator":false,"pages":[{"spans":[{"text":"Get the hell off the stage!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The outraged crowd slings insult after insult. Yugiri tries her best to soothe a sobbing Sakura and Lily even though she can barely hold herself together."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile, Ai and Junko, both fighting to remain calm, are holding back a furious Saki."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_BaseDoor_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The stagehand lowers the curtain to contain the commotion..."}]}]},{"sprites":[{"prefab":"NPC-Fans","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-250","spriteScale":"1.7"}}],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Die-Hard Fan","narrator":false,"pages":[{"spans":[{"text":"...That's it?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Production Assistant","narrator":false,"pages":[{"spans":[{"text":"Franchouchou's fate depended on this performance! "}]},{"spans":[{"text":"They will never recover from this train wreck!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_File_Put","raw":"SE1"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Smack! A Franchouchou fan sign thrown from who knows which direction hits you squarely."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sign has been viciously smashed, and Franchouhou's smiling faces are no longer lit up."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[],"speaker":"Production Assistant","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I gotta go."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The production assistant disappears in the crowd without a backward glance."}]}]},{"sprites":[{"prefab":"NPC-Fans","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-250","spriteScale":"1.7"}}],"ops":[],"speaker":"Die-Hard Fan","narrator":false,"pages":[{"spans":[{"text":"He looked totally heartbroken."}]}]},{"sprites":[{"prefab":"NPC-Fans","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-250","spriteScale":"1.7"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...He must be very disappointed."}]}]},{"sprites":[{"prefab":"NPC-Fans","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-250","spriteScale":"1.7"}}],"ops":[],"speaker":"Die-Hard Fan","narrator":false,"pages":[{"spans":[{"text":"I just don't understand. "}]},{"spans":[{"text":"They were spectacular in the face-off against Gray Tree, so where did it go wrong?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You replay the last few days in your mind. "}]},{"spans":[{"text":"From the very beginning, you did not consider Franchouchou's training as a problem to be taken seriously. "}]},{"spans":[{"text":"You just helped them practice their intonation and rhythm occasionally, and once you saw that they could beat Gray Tree, you grew complacent and forgot all about their training..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How did this happen...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You thought Franchouchou's training was no different than the paperwork sitting on your desk in the command center. If you leave it there for long enough, someone will end up sorting it out for you. "}]},{"spans":[{"text":"But you forgot that this is not the Griffin base, and you don't have a diligent adjutant who does your work for you."}]}]},{"sprites":[{"prefab":"NPC-Fans","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-250","spriteScale":"1.7"}}],"ops":[],"speaker":"Die-Hard Fan","narrator":false,"pages":[{"spans":[{"text":"Go to the backstage to comfort them. I feel sorry for them."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd","raw":"SE1"}],"speaker":"Audience","narrator":false,"pages":[{"spans":[{"text":"REFUND! REFUND! REFUND!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You push your way through the crowd, almost hysterically. You dare not listen too closely to their angry mutters or meet their eyes."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_20Winter_Door_Close","raw":"SE1"},{"type":"background","value":"2022winter_BedRoom","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the VVVIP's dressing room. "}]},{"spans":[{"text":"You shuffle into the room with heavy feet and are immediately greeted by a cloud of bleak misery. "}]},{"spans":[{"text":"The Franchouchou girls have already removed their makeup and are weeping quietly on the couch."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Commander... we... "}]},{"spans":[{"text":"We screwed up the show..."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"60,-190","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't cry... You're still young. You will still have lots of opportunities..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You make a futile attempt to comfort them with empty words as you slump down next to them."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"60,-90","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Our fans must be terribly disappointed..."}]}]},{"sprites":[{"prefab":"NPC-Saki","expression":11,"shown":true,"side":"left","tags":{"spritePosition":"0,-150","spriteScale":"1.34"}}],"ops":[],"speaker":"Saki Nikaido","narrator":false,"pages":[{"spans":[{"text":"Stop moping! Yes, we screwed up this time, but next time, we'll show everyone what we're made of!"}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-290","spriteScale":"1.3"}}],"ops":[{"type":"sfx","value":"AVG_Bite","raw":"SE1"}],"speaker":"Tae Yamada","narrator":false,"pages":[{"spans":[{"text":"Munch... munch... (She is munching on some dried shredded squid dejectedly.)"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"70,-160","spriteScale":"1.24"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Would anyone even come to our shows again...?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.9"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"As long as we persevere, someone will stop and watch us shine."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The air grows still and silent once again. You can hear the suppressed sobs. "}]},{"spans":[{"text":"You desperately want to say something, but deep down, you know that nothing you say will change anything. "}]},{"spans":[{"text":"All you can do is live with the guilt that you did not give Franchouchou's training the attention and dedication it deserved."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm sorry..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is the second time you've apologized to them. "}]},{"spans":[{"text":"But unlike the first time, when you were full of determination to start over, this time you feel utterly hopeless."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"It wasn't your fault..."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"60,-90","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Commander, please don't blame yourself..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Warm hands cover yours. Even now, they still trust you."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.9"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Don't cry..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"70,-160","spriteScale":"1.24"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Commander is making Lily cry...!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girls surround you and envelop you in a silent but firm embrace. "}]},{"spans":[{"text":"You can feel their hot tears and woeful sighs on your skin."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You can't help but close your eyes, hoping to escape from this moment of despair..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the dark, there are no tears, no empty bravado. "}]},{"spans":[{"text":"There is nothing there. "}]},{"spans":[{"text":"You stand in the dark for some time before you realize something doesn't seem quite right."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Splash... "}]},{"spans":[{"text":"The waves strike the hull of the boat rhythmically. The salty sea air is laced with a barely noticeable tinge of floral fragrance."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Where am I?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A vaguely familiar voice speaks up from behind you."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You ruined the show for those kids."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"If you could do this all over again, would you still let it end like this?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"The wheel of fate has started to turn again."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Do I still have a chance? Can I really start over?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"It has been set in motion since long ago. It will not stop now."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The boat suddenly surges forward at high speed. You can hear the sound of its bow cutting through the surface of the sea..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"openEyes","raw":"睁眼"},{"type":"background","value":"BG-Dorm","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You open your eyes and find yourself lying on the cold floor."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Your mind is blank. You feel like you have had a very long dream, but you cannot recall anything about it. "}]},{"spans":[{"text":"The television screen is still showing the selection menu of the same game. "}]},{"spans":[{"text":"\"Please select your preference from the following options.\"","style":{"color":"#FFFF00"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What is this all about...?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You're suddenly overcome by a terrible headache. You get up to look for some painkillers, so you do not notice... "}]},{"spans":[{"text":" The cursor has taken the liberty to pick out an option for you."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"AVG_Card_Reader","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"The wheel of fate starts spinning again."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
