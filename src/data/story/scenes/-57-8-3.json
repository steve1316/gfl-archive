{"name":"-57-8-3","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_RevengeLive_a","raw":"BIN"},{"type":"flashback","raw":"回忆"},{"type":"frame","value":"2","raw":"边框"},{"type":"bgm","value":"BGM_Saga_AVG_Day","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...15 minutes before the show. "}]},{"spans":[{"text":"You've already made it to the seat reserved for you in the auditorium. You get an excellent view of the stage from this seat—it is easily the best spot to watch Franchouchou's performance. "}]},{"spans":[{"text":"Of course, it would have been a much better experience if you were not sandwiched between two familiar figures."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Production Assistant","narrator":false,"pages":[{"spans":[{"text":"Are you confident about Franchouchou's performance tonight?"}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah... They'll be alright."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Production Assistant","narrator":false,"pages":[{"spans":[{"text":"I've been looking forward to this for so long..."}]}]},{"sprites":[{"prefab":"NPC-Fans","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-250","spriteScale":"1.7"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Die-Hard Fan","narrator":false,"pages":[{"spans":[{"text":"Anti-fans will always find fault in even the most outstanding performance. "}]},{"spans":[{"text":"Not to mention this is Franchouchou, who has invited Late Night Café and Gray Tree for guest appearances. The Coffee Lovers and Gray Tree fans will definitely be here to cause trouble!"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...It won't come to that."}]}]},{"sprites":[{"prefab":"NPC-Fans","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-250","spriteScale":"1.7"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Die-Hard Fan","narrator":false,"pages":[{"spans":[{"text":"Wanna bet?"}]}]},{"sprites":[{"prefab":"NPC-Fans","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-250","spriteScale":"1.7"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Bet what?"}]}]},{"sprites":[{"prefab":"NPC-Fans","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-250","spriteScale":"1.7"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Die-Hard Fan","narrator":false,"pages":[{"spans":[{"text":"You give me 10 yen for every boo from the audience tonight! "}]},{"spans":[{"text":"If there isn't a single boo throughout the entire concert, I'll give you 10,000 yen!"}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Production Assistant","narrator":false,"pages":[{"spans":[{"text":"How tempting. I'm also in."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":