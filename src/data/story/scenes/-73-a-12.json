{"name":"-73-A-12","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"night","raw":"Night"},{"type":"background","value":"机场","raw":"BIN"},{"type":"bgm","value":"BGM_TK_loading","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We should be safe now. Let's rest here for a while."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_splash_water","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"By the riverside, a lifeboat drifts gently to shore. Two girls leap off."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beluga follows close behind. Mityl is just ahead of her and reaches out a hand to help."}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"text":"...Thanks."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"You saved me back there, didn't you? Thank you!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Under the moonlight of a clear night, Mityl's eyes almost reflect the stars. Beluga stares into them, as if seeing another world beyond."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Is there something on my face?"}]}]},{"sprites":[{"prefab":"NPC-M16_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beluga","narrator":false,"pages":[{"spans":[{"