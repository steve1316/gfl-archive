{"name":"-32-7-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Covered by Jericho, Dana and Super-Shorty break through to Earth's core. "}]},{"spans":[{"text":"...Bang! Bangbang!"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Wow, I can see you're really mad from the state of their corpses."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I'm just anxious! I can't keep IDW waiting any longer! "}]},{"spans":[{"text":"Look, up ahead—"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"SFBase","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"At last... "}]},{"spans":[{"text":"This is the Earth Computer. It's the first time I've seen it in the flesh."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Hurry up, you two! S.F. is still bringing in reinforcements and we can only help you hold out for a little while more!"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Hey! You said you could wipe them all out!"}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"And I also said that you shouldn't charge too far ahead!"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"IDW...IDW!"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Don't be hasty, shorty. You're really high up. How good is your balance?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I don't care! IDW's waiting for me—ah!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Super-Shorty's hand slips, and she nearly falls off the outer wall of the Earth Computer."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Whew... That was close!"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Haha, are you alright? "}]},{"spans":[{"text":"Ever heard of the saying \"haste makes waste\"?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I'm not as agile as IDW, but I can do it! And besides, nobody but me can crawl into that crevice!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Super-Shorty clings tightly to the outer wall and resumes climbing."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Looks like your small body is your advantage."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I'm not happy to hear that! "}]},{"spans":[{"text":"But if the circumstances demand it, I don't mind being shorter for the sake of a friend!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Super-Shorty comes to the narrow crevice that leads to the Earth Computer's interior."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","value":"0,4","raw":"黑屏1"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I see it...the crevice that IDW used to enter. "}]},{"spans":[{"text":"I'm going—ahh!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","value":"0,2","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Crash! "}]},{"spans":[{"text":"...The section of the wall under Super-Shorty's feet suddenly gives way and she falls down!"}]}]},{"sprites":[],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Shorty!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"blackscreenOn","value":"0,0.6","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"SFBase","raw":"BIN"},{"type":"blackscreenOff","value":"0,0.6","raw":"黑屏2"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"You..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...A slender hand from inside the crevice grabs Super Shorty's hand."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"You've gotten heavier, Leader."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"IDW? ...IDW! How did you—"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Nya? Shouldn't the first thing you say to me be \"Good morning\"? "}]},{"spans":[{"text":"Everyone, please stop!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Whum—!"}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"The S.F. assault...stopped?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Haven't even had fun yet, Miss Captain?"}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Eh, it's like eating two pieces of sushi and then hearing the buffet is over."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"So...how long was I asleep?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Three years. It's been three years since that day... "}]},{"spans":[{"text":"I'm sorry, IDW, it was all my fault."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Three years, huh... "}]},{"spans":[{"text":"I must have missed the endings of a lot of cartoons."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Hi, excuse me, I know that I shouldn't be interrupting you two right now. "}]},{"spans":[{"text":"But based on my life experience as a native, allow me to remind you that you can actually continue your conversation after getting down from there."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Half an hour later, in the Core Elevator."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"So how are you feeling?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"It feels... Wow! The outside really is filled with sand! I remember this place used to be a forest! Was this all because of me?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Thanks to you, the forest is completely buried in sand now. "}]},{"spans":[{"text":"Fortunately, the humans don't call the shots anymore, otherwise the environmental protection groups would have scrapped you the moment you stuck your head out of the elevator."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Hehe, well, it can't be helped, I slept for a full three years."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Honestly, If I'd known you could have come out of the life pod, I would have just shouted for you from the outside."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Yes, I did wake up because you called my name. "}]},{"spans":[{"text":"Only Elisa would have been faithful enough to stay there. I just couldn't escape from among all those S.F.."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Hahh, I got all worked up for nothing. In the end you came out all full of life and vigor."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Haha, well, my body's gotten stiff after three years of inactivity. "}]},{"spans":[{"text":"If I get some time later, I'm going to run ten laps!"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"IDW..."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Nya?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I'm sorry."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Ah? What's this all of a sudden? "}]},{"spans":[{"text":"All you did was keep me waiting for three years. It really doesn't bother me. You must have had your reasons, Leader."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"No, I'm talking about the way I treated you before. "}]},{"spans":[{"text":"I took all my anger out on you and said a lot of things that I regret now."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Ah? Is that so? "}]},{"spans":[{"text":"I thought it was because you felt I wasn't good enough, Leader."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"You did very well, IDW. You bought everyone the chance to save the world. "}]},{"spans":[{"text":"It's just that I'm terrible and don't deserve to be the team leader."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"But how could this team have been formed without you being the leader, and with me as the only member?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Well you could just be the leader yourself, couldn't you?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Nah, a team with only one member would be finished the moment they made a mistake. "}]},{"spans":[{"text":"With two people, at least, there's a chance to salvage things like now."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"You were the one who saved me, IDW. "}]},{"spans":[{"text":"When I had no idea what to do, you came up with a solution."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"So I did help out after all! It was my honor!"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"(Sigh) Why don't you feel like I did something wrong?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"But...what's so special about doing something wrong? I'm used to breaking the rules."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I really shouldn't have discussed this with you. Now I feel like a self-hating moron. "}]},{"spans":[{"text":"Ahhhhh honestly! Why did I end up as your partner!?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Leader, do you still hate me?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"No, I never hated you. It's just... "}]},{"spans":[{"text":"When I'm around you, I'm either a bastard or an idiot."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Haha, that just means you're really compatible with me! That's how partners should be!"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Hmph, whatever. Besides, it looks like we'll need to keep working together for the time being. "}]},{"spans":[{"text":"In any case, this mission has gone on hiatus for three years. Are you still willing to complete it with me?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Of course, Leader!"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"While you still have to call me Leader, add a \"Shorty\" to it."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Huh? Why?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Because my friends...get to call me that. "}]},{"spans":[{"text":"Al-Although, it's not like you're much taller than me or anything!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Ding!"}]}]},{"sprites":[],"ops":[],"speaker":"System","narrator":false,"pages":[{"spans":[{"text":"You have reached the surface of the Southern Hemisphere. Please ensure you have all your personal belongings and weapons."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Yup! We're here, let's go, Leader Shorty!"}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","value":"0,0.6","raw":"黑屏2"},{"type":"background","value":"作战室avg","raw":"BIN"}],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Alma, Super-Shorty and the others are here, let's get started—"}]}]},{"sprites":[{"prefab":"Alma","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"IDW!!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Ngggh! Too tight, too tight!"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Good thing you only sent two shorties over, otherwise our plan to save the world would have ended up as a free hugs conference."}]}]},{"sprites":[{"prefab":"Alma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"It's because these two were personally selected by me."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Because we were short, right?"}]}]},{"sprites":[{"prefab":"Alma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"Super-Shorty, even if I had to select for small frames, I wouldn't have sent a Dinergate or a Shiba Inu that was all talk on that mission. "}]},{"spans":[{"text":"I chose you because I believed that you would succeed."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"But Alma, I didn't think that I could do it back then..."}]}]},{"sprites":[{"prefab":"Alma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"Well, what do you think now?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I've decided to believe in you, because you could always see the problems that I can't."}]}]},{"sprites":[{"prefab":"Alma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"I'm glad you finally realized that. "}]},{"spans":[{"text":"It isn't because we're smarter than you, but because other people are mirrors for ourselves. Super-Shorty, I could always find a way to fix myself from my family members."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Is that why you've been single all this time?"}]}]},{"sprites":[{"prefab":"Alma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"I! D! W! Maybe you should have stayed in the Computer for a while longer!"}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Alright, everyone, let's begin. No, I should say...let's continue."}]}]},{"sprites":[{"prefab":"Alma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"Okay, let's finish the mission that we couldn't complete three years ago!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"SFBase","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Alma walks in front of the Earth Computer."}]}]},{"sprites":[{"prefab":"Alma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"So it really does look like the picture that my big sister took."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Did your sister photograph the Earth Computer?"}]}]},{"sprites":[{"prefab":"Alma","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"When I was young, I thought she was the coolest person ever, until she abandoned her kids for her so-called adventures and dumped them on my parents. "}]},{"spans":[{"text":"After that, I promised myself that I would never abandon my responsibilities to my family for any reason. "}]},{"spans":[{"text":"I haven't been able to find a boyfriend ever since."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"That just proves nobody was good enough for you."}]}]},{"sprites":[{"prefab":"Alma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"You're a real flatterer, Dana, although I know that it was my own fault. "}]},{"spans":[{"text":"But it was thanks to the interests that my big sister sparked in me that I can stand here today. "}]},{"spans":[{"text":"I've completely cracked Elisa. All we need to do now is to put her back into the Computer and we can give it orders."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"You work fast."}]}]},{"sprites":[{"prefab":"Alma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"Why else would I chop off my real arms and replace them with prosthetics? "}]},{"spans":[{"text":"The human body is an obstacle. They will never keep up with the possibilities of the mind. "}]},{"spans":[{"text":"Come, which of you is willing to put Miss Elisa into the Computer and wake her up?"}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"I think that honor belongs to those shorties over there."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"IDW, let's go."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Huh? I'm going too?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Well, you pulled Elisa out, so of course you're going to stuff her back inside."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Super-Shorty and IDW pick up Elisa and insert her into the Computer."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Everyone! I've installed Elisa! "}]},{"spans":[{"text":"Elisa! Elisa, can you hear me? That's strange, why isn't she responding? "}]},{"spans":[{"text":"Hello, Elisa?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Geez, don't tell me you forgot to connect a wire or something. Let me take a look!"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"That's impossible! I was trapped in this thing for three years! How could I misremember?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Hm... It looks alright... "}]},{"spans":[{"text":"Wait a minute, do you hear that sound?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Tick, tock, tick, tock..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Huh? It sounds like...ticking..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"No...IDW... "}]},{"spans":[{"text":"This sound— "}]},{"spans":[{"text":"It's a bomb! Run! Everybody, run—!"}]}]},{"sprites":[],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"What!?"}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","value":"0,4","raw":"白屏1"}],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Everyone! Get down—"}]}]},{"sprites":[],"ops":[{"type":"whitescreenOff","value":"0,4","raw":"白屏2"},{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"background","value":"fullwhite","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...BOOM—! "}]},{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Alma","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"CG4N","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"(Cough)... (Cough cough)...! "}]},{"spans":[{"text":"Dammit, what on Earth... "}]},{"spans":[{"text":"Super-Shorty! IDW! Where are you!?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"I'm fine, I'm fine! "}]},{"spans":[{"text":"IDW, are you alright?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"I'm fine! It's all thanks to Shorty's shield."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Hah...if you had been any taller, I wouldn't have been able to cover you in time."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Whew... So what happened? "}]},{"spans":[{"text":"Why did the Earth Computer suddenly explode?"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"If the Computer exploded, then wouldn't this mean Earth..."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Stay on your guard! There's someone in the center of the explosion!"}]}]},{"sprites":[{"prefab":"Alma","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"spark","raw":"火花"},{"type":"cgDelay","value":"0.4","raw":"CGDelay"},{"type":"bgm","value":"BGM_Boss","raw":"BGM"}],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"Who...is that?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Dana","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Hey! Is this your doing? "}]},{"spans":[{"text":"Even if this city's a mess, setting off an explosion in a military base isn't too legal, is it?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Good evening, Miss Dana Zane."}]}]},{"sprites":[{"prefab":"Dana","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"You are... "}]},{"spans":[{"text":"You're that \"Anna\", aren't you? "}]},{"spans":[{"text":"It's about time you told us what the hell you're up to, don't you think?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"As you can see, I have blown up the Earth Computer. "}]},{"spans":[{"text":"And I fused with Elisa's data and have materialized a physical body."}]}]},{"sprites":[{"prefab":"Alma","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"Impossible...it can't be!"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Unfortunately, there is no Earth Computer anymore. "}]},{"spans":[{"text":"Or rather...I am the Earth Computer now. Destroying me means destroying the last hope for Earth."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"What the hell kind of monster are you!?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I am God, the very last god in this world. "}]},{"spans":[{"text":"It sounds very chuuni, but everyone has the right to dream, right? And I simply made it come true."}]}]},{"sprites":[{"prefab":"Alma","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"I don't get it, how did you do it... "}]},{"spans":[{"text":"I checked Elisa! Her data was secure! You couldn't have had the time to fiddle with her!"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Is that so? Then did you check your own computer? Didn't someone pay you a visit several hours ago?"}]}]},{"sprites":[{"prefab":"Alma","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"What—"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"Architect... "}]},{"spans":[{"text":"It's Architect! Her real master is Anna! She deceived everyone!"}]}]},{"sprites":[{"prefab":"Alma","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"So you're saying...Architect's real aim in coming to the base was my computer!?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"What else could it be? I'm just a pile of nanomachines. How could I politely ask to enter?"}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"That [bleep—]! When I catch her again, I'll have a good enough reason to kill her three times over!"}]}]},{"sprites":[{"prefab":"Dana","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Looks like I've finally got a good reason to throw down with her... "}]},{"spans":[{"text":"But still, you're the elephant in the room. What do you plan to do next!?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I intend to continue my plan, of course— "}]},{"spans":[{"text":"To destroy this world."}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Why on Earth would you do that? What's so bad about this world?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Frankly speaking, I think the world is pretty good as it is."}]},{"spans":[{"text":"But that's only if you assume that... "}]},{"spans":[{"text":"This world is sufficiently real, and sufficiently stable."}]}]},{"sprites":[{"prefab":"Alma","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"What...did you say?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"There might not be a difference to you, but to me...it isn't quite the same. "}]},{"spans":[{"text":"Therefore, don't be too sad. As you know, you don't really need a concrete reason for wars and breakups. It's all because the ways in which people live are incompatible."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..Saying so, Anna turns and walks back into the fire."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Hey, you shouldn't be slipping away like this, should you? Or do you think you can just walk off like that?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"What else would you have me do? Why should I transform or whatever before your eyes?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Anna snaps her fingers."}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"The White Knights... The White Knight mechs!"}]}]},{"sprites":[{"prefab":"IDW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"They're coming again! How many are there!?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"There are as many as I want there to be. "}]},{"spans":[{"text":"You should know that since I am now the Earth Computer, I am both the one who gives orders and the one who executes them. "}]},{"spans":[{"text":"I don't need the sand, I don't need S.F., because now I can destroy the world in any way I want."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Prepare to break through! Let's get out of here first!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bangbang!"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I will cover Earth's surface with strawberry ice-cream, and then summon a chocolate straw the size of Lake Superior to poke through Earth's core. "}]},{"spans":[{"text":"But first, I'll cover the top ten peaks in the world with Swiss rolls, so I can fill in the blanks on my geography test paper with \"egg roll\". "}]},{"spans":[{"text":"Do you like that? Do you think such an apocalypse would suit a high school girl's backstory?"}]}]},{"sprites":[{"prefab":"SuperShorty","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"How much time...would it take you to destroy the world?"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"What happened to your sense of romance, everyone? Turning Earth into an adorable ice cream will only take a few hours. "}]},{"spans":[{"text":"I still need to think about the proportion of the cream, because I don't like it when it overflows. Although, enough to cover the entire North American continent will do."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Don't think you'll get away with this. We'll stop you!"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Your former subordinates, those pathetic mechanical weapons, will stop you first."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Escorted by the White Knights, Anna walks into the depths of the flames."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I'm going out for a walk, to take one last look at this world, at this civilization with no dreams or sentiments to speak of. "}]},{"spans":[{"text":"I'll visualize it as a big pile of dirty laundry about to be washed, and then imagine it all fresh and clean; wouldn't that be enjoyable?"}]}]},{"sprites":[{"prefab":"Dana","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"We'll find you, Anna!"}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I know, I know, and I'll let you find me. "}]},{"spans":[{"text":"But do hurry it up. This city is far too fragile compared to the kind of waffles that I like."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"},{"type":"sparkOff","raw":"关闭火花"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...As the surrounding buildings collapse, Anna's silhouette vanishes into the flames."}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"Super-Shorty","narrator":false,"pages":[{"spans":[{"text":"What...should we do..."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Looks like you're in a hell of a fix too."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","value":"0,5","raw":"黑屏1"}],"speaker":"IDW","narrator":false,"pages":[{"spans":[{"text":"Y-You are—!"}]}]},{"sprites":[{"prefab":"Sei","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","value":"0,3","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"Sei","narrator":false,"pages":[{"spans":[{"text":"Hey...Captain Jericho, I'm sorry, we..."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Don't make that face. You couldn't possibly have screwed up more than I did."}]}]},{"sprites":[{"prefab":"Dorothy","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Um...thanks for your hard work, everyone, haha..."}]}]},{"sprites":[{"prefab":"Dorothy","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dorothy","narrator":false,"pages":[{"spans":[{"text":"Right, I know nobody's in the mood to hear me cheer you up."}]}]},{"sprites":[{"prefab":"Alma","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Alma","narrator":false,"pages":[{"spans":[{"text":"Prime Minister Dorothy? And...Stella! You're still alive!"}]}]},{"sprites":[{"prefab":"Stella","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"I should be saying that... Looks like SOME good things happened today, at the very least."}]}]},{"sprites":[{"prefab":"Dana","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Can we summarize our situation? "}]},{"spans":[{"text":"What should we do now?"}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"We still have one last thing that we need to do."}]}]},{"sprites":[{"prefab":"Jericho","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Go on. The Prime Minister will pay me overtime."}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"The person we have to stop isn't Anna... "}]},{"spans":[{"text":"...But Jill."}]}]},{"sprites":[{"prefab":"Dana","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dana","narrator":false,"pages":[{"spans":[{"text":"Why? I thought you wanted us to capture Anna and save the world."}]}]},{"sprites":[{"prefab":"Stella","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Stella","narrator":false,"pages":[{"spans":[{"text":"We are going to save the world... "}]},{"spans":[{"text":"But the world we can save isn't our own."}]}]}]}
