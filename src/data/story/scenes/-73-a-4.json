:[{"spans":[{"text":"I was still debating it, but I guess my options are pretty limited now..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander takes the supplies and the remaining Koens, but doesn't head for the door."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You never answered my earlier question."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The doctor who helped that woman back in the northern town—do you know them?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Evita freezes for just a moment. Then a smile spreads across her face. She opens a drawer, pulls out a velvet box, and places the pendant inside. A perfect fit."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"I knew I couldn't hide it from you."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Next time you've got a job, just come to me directly."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"After all, I need all 