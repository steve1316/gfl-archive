{"name":"-73-A-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_TK_face","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2019summer_12","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The city of Marulos—an important hub in the eastern Dark Zone. Being in close proximity of both seaport and canal, its strategic transport connections draw all kinds of people chasing opportunity."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":"Vendor","narrator":false,"pages":[{"spans":[{"text":"Hey, just finished a mission? Brought back anything good? I'll buy whatever you've got."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Empty-handed this time. Maybe next run."}]}]},{"sprites":[],"ops":[],"speaker":"Vendor","narrator":false,"pages":[{"spans":[{"text":"No goods? Then take a look at this fresh batch of gear. Fair prices, and it'll help you take down a few more bastards next time."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander nods a polite thanks to the vendor and continues forward. On their left, two men are kicking someone pinned to the ground."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Combat_Hits","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"You dare steal my gun? You've got a death wish?"}]}]},{"sprites":[],"ops":[],"speaker":"Downed Man","narrator":false,"pages":[{"spans":[{"text":"N-no, please! Just lend me one, I'll take on a job! I swear I'll pay you back, double, triple!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"For f*ck's sake! A loser like you's just gonna get killed and hand the reward to someone else."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Turning another corner, the Commander spots two heavily armed operatives sitting on a stairwell, cracking open a can of food."}]}]},{"sprites":[],"ops":[],"speaker":"Special Operative","narrator":false,"pages":[{"spans":[{"text":"That last client was so stingy. Promised us ten thousand Koens but gave only eight."}]}]},{"sprites":[],"ops":[],"speaker":"Special Operative","narrator":false,"pages":[{"spans":[{"text":"Don't dwell on it. It's hard to find work these days."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Two more streets. As the Commander approaches an intersection, they suddenly stop and duck behind a column."}]}]},{"sprites":[],"ops":[],"speaker":"Gangster","narrator":false,"pages":[{"spans":[{"text":"Still no trace of whoever hit the outpost up north?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Two armed men walk past, deep in conversation, weapons bulging under their coats."}]}]},{"sprites":[],"ops":[],"speaker":"Gangster","narrator":false,"pages":[{"spans":[{"text":"Nope. Heard it was some operative. (Spits) If that bastard dares show their face in Marulos, we'll get 'em sooner or later."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After the men disappear down the road, the Commander slips out from behind the column and heads quickly toward a nondescript building at the end of the street."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202410_Warehouse","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It is an old warehouse that has been unused for some time. The lights are off, so it's impossible to see what's inside."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This is the right address... Hm?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander pauses, spotting a large cardboard box to the left."}]}]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"sfx","value":"AVG_21Winter_Open_Light","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. A warm light flickers on above, casting a soft glow—and a round little shadow—by the box."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Uh..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A girl with her hair in high buns stands up behind it, backpack slung over her shoulders, looking annoyed."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"This place is terrible for hiding!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Come on out."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"From the top of a nearby shelf, a black-clad girl flips down lightly, landing without a sound."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"How did you spot me?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"There's another one?!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I saw you come in."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You really thought a bag that big would be hidden behind a box? I've got the footage~"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She smugly waggles a camera in her hand."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You! ...I was hidden just fine until they suddenly flipped on the lights... Who are you people?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The dusty warehouse falls into tense silence as the three size each other up."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"I'm Kuro. From your look, you're both operatives too?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girl with the high buns nods."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Mityl."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"An anonymous client contacted me two days ago and told me to be here today to take a job."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Same here."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Me too. But I wasn't told there'd be others—"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"You're all here. Allow me to introduce myself—I'm the contractor for this mission.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A radio sitting on a cloth-draped box blinks red, active with the woman's voice."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"I need the three of you to work as a team. Your task is to deliver the cargo to Northridge.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her sudden voice echoes sharply through the cramped space. The three gather around the box, eyes wary and uncertain."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro steps up and grabs the radio."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"You didn't say there'd be other people."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"The cargo is... a bit unusual. Look under the cloth, just below the radio.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro pulls off the white dust cover, revealing a large rectangular container."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"This big?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The box is over a meter long, and nearly half as wide and tall. Definitely not something one person can handle alone."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"As you can see, transport is best done with three. This is based on our risk assessment.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"And the reward? We still split the same pay three ways?"}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Your individual reward stays the same. As promised.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander, who has been silent until now, inspects the box closely. Titanium alloy shell. Two advanced biometric fingerprint locks."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What's inside?"}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"That's not information you need.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The woman's voice is striking—devoid of emotion, as though trained to suppress it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It echoes coldly from the radio, with an air of superiority."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro stops peeking through the air vents and grabs the radio from the Commander."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hey! If you want us to work for you, try showing a little sincerity."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"I assumed generous compensation already showed my sincerity.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Still doesn't seem fair. We don't know who you are, or what's in the box."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Do you really want to know?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The three lapse into silence."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Knowing more often means greater risk."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The heavy locks are there to protect not only the cargo, but also the ones carrying it."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No need."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Depart from this warehouse at 1900 hrs tonight. Deliver the box to the Northridge Hotel within 24 hours. Ensure the cargo remains undamaged—no gunfire, no heavy impact.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Think of the cargo as... a piece of fine porcelain.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Good luck.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Why exactly do we have to wait until 1900 hrs?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The radio stays silent."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Hey! ...Hello?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Phone_Crash","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro, frustrated, hurls the radio to the ground."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"If I find out who she is, I'll stink up her name across the whole damn Dark Zone."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander lifts the box slightly."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"About 60 kilos... We'll need transport."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Not a problem. I'll grab a vehicle. Stick to the main road and we'll make it by morning. We won't even need 24 hours."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I doubt it'll be that simple..."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Do either of you know who she is?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Silence. No answer."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander brushes the dust from their hands and heads for the door."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We've got some time, we should go get ready. See you at sundown."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's... try our best to work together."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_TK_face","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_Study","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a shabby little clinic in Marulos."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"It's been a while."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The room isn't large, but it's stocked with various medical supplies. Behind the table, a short-haired woman props up her chin and greets the Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's been a while, Evita."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander takes off their backpack and dumps its contents onto the table—weapons, ammo, gun accessories... all strewn messily across the surface."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This is all I brought back from the last job. How much can I get for it?"}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Let me see... 23k Koens."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's it? ...Oh, and this."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander pulls a droplet-shaped gold pendant from their pocket and hands it over."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Didn't make much on this one. The client was just an ordinary woman who heard that she could hire a special operative with money, so she came to me. Pity though..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Oh, and the one who told her that was a doctor. From Marulos, apparently. Do you know them?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Evita takes the pendant and gives her price without inspecting it closely."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"30k."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're not even going to check the weight?"}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"No need."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"I heard you got on the Sewer Rats' bad side because of this job. They're hunting you all across the city."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yep, almost ran into them."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Evita starts packing up the items on the table, then hauls out a crate from the shelf behind her."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Same as always? Five E3 military medkits, three Liquid Painkillers, three standard surgical packs... That leaves you with 13,600 Koens."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As she speaks, she pulls out the supplies smoothly and efficiently."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Then, after a brief moment of hesitation, she grabs a white pill bottle from the shelf."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I can't afford that."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"It's on the house."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"You should skip town for a while. Best take an assignment that gets you out of here."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Medicine_Bottle","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander raises an eyebrow at that, tossing the pill bottle gently and catching it again."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Who's backing the Sewer Rats? What have I done to earn a free bottle of EX Painkillers?"}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"It's Doss."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's hand freezes mid-air. The bottle slips, rolls across the table, and is caught by Evita."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Doss Anthony."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"You know how the Antonio family has run things for generations in the Dark Zone. They're vengeful as hell, and you've crossed them... Best to prepare for the worst."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Take two 