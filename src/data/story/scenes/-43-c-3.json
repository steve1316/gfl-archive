ingfield","narrator":false,"pages":[{"spans":[{"text":"Hm... It does seem quite hard to believe. I understand how you must feel. "}]},{"spans":[{"text":"However, if we really wanted to, wouldn't it have been better for us to simply ambush you?"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1903","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"It wouldn't because I'm alert and on my guard!"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1903","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Springfield","narrator":false,"pages":[{"spans":[{"text":"It is also because we honestly had no intention of attacking you in the first place. "}]},{"spans":[{"text":"The real battle is in the Dark Zone. If we wear each other down here, we won't be able to experience the most important content of the game."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1903","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"The most important content... True, if I don't enter the Dark Zone..."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1903","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Springfield","narrator":false,"pages":[{"spans":[{"text":"We are not enemies, at least not out here. "}]},{"spans":[{"text":"Winning is the most important thing, is it not? Now is not the time for us to fight with all our might. We need to survive."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1903","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Humph, even so..."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1903","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Springfield","narrator":false,"pages":[{"spans":[{"text":"You can think about it, but there isn't much time left. "}]},{"spans":[{"text":"Our progression speed will be affected if we don't enter the Dark Zone as soon as possible, so dragging this out is no good for us."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2020TCTDnight","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As Springfield is negotiating with A-91, the other three are starting to get restless."}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"Gr MP7","narrator":false,"pages":[{"spans":[{"text":"What are the chances we can take her out in one hit from this distance?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"Not high. Without using a scope, I might have to dump an entire mag to be sure.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP7","narrator":false,"pages":[{"spans":[{"text":"Isn't that a good thing? Why don't you go up and do just that?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"I'm not dumb, you know. She's carrying grenades and there are explosives everywhere. If we don't take her out in one shot, we'll be dead before we can even begin to run.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Springfield must be negotiating with her because she thought about that.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP7","narrator":false,"pages":[{"spans":[{"text":"No wonder you managed to survive until now. I've underestimated you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AA12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AA-12","narrator":false,"pages":[{"spans":[{"text":"Still, I don't think she's the type who'll listen to reason... Right, I've decided. If the negotiations don't work out, I'll give up right away, return her stuff and walk away.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AA12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"How can you do that?!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AA12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AA-12","narrator":false,"pages":[{"spans":[{"text":"I want to enter the Dark Zone and not fool around here.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AA12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"True, it's getting 