":"97type","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"While A-91 is being distracted by Springfield's words, Type 97 clutches the explosives she's holding tightly to her chest and begins tiptoeing off towards the Dark Zone. "}]},{"spans":[{"text":"However, she suddenly feels a keen gaze fall on her, and a shout from A-91 soon follows."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"shake","raw":"震屏"}],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"You, Twintails! Put my stuff down!"}]}]},{"sprites":[{"prefab":"97type","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"Ah! She spotted me! But how? I was really careful, wasn't I?"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Did you think I wouldn't notice your little stunt just because I look drunk? "}]},{"spans":[{"text":"This is my normal working state! The more drunk I am, the keener my senses are."}]}]},{"sprites":[{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"But that's water you're holding, right?"}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP7","narrator":false,"pages":[{"spans":[{"text":"Just because you're acting all sneaky and stuff doesn't mean people really won't notice you... (Sighs). "}]},{"spans":[{"text":"There's four of us. We'll win if it comes to a straight fight."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Put my stuff down and leave and I might let you off."}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP7","narrator":false,"pages":[{"spans":[{"text":"Also, why do you have so many explosives piled up here? Are you going to blow yourself up?"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Do you not take out your weapons to kill someone? Or do you beat them to death with your backpack, you moron?"}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP7","narrator":false,"pages":[{"spans":[{"text":"Kill someone? Who?"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Not you. Be glad."}]}]},{"sprites":[{"prefab":"M1903","expression":12,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Springfield frowns. She takes a step forward and shoots Gr MP7 a glance, telling her to back off. However, Gr MP7 doesn't get the message and keeps glaring at A-91."}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP7","narrator":false,"pages":[{"spans":[{"text":"If you're prepared to kill someone, then you should be prepared to have your trap taken down."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"What, you're going to lecture me? Think about who has the upper hand now!"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP7","narrator":false,"pages":[{"spans":[{"text":"Are you sure you're not misunderstanding something? "}]},{"spans":[{"text":"If it comes to a fight, you'll die before us."}]}]},{"sprites":[{"prefab":"M1903","expression":12,"shown":true,"side":"left","tags":{}},{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Springfield","narrator":false,"pages":[{"spans":[{"text":"Gr MP7! Don't provoke her."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Oh?! You think I'm scared just because there's more of you? "}]},{"spans":[{"text":"I won't go before I get rid of her! These are the components for the trap I'm setting up. Don't even think of getting away with any of them."}]}]},{"sprites":[{"prefab":"AA12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AA-12","narrator":false,"pages":[{"spans":[{"text":"...What a pain."}]}]},{"sprites":[{"prefab":"M1903","expression":12,"shown":true,"side":"left","tags":{}},{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Springfield","narrator":false,"pages":[{"spans":[{"text":"But how can we be certain that you'll let us go if we put down those items? "}]},{"spans":[{"text":"Like you said, we've already stepped into your trap, haven't we?"}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"You know this and you STILL want to talk terms with me? I am the ruler of this place! "}]},{"spans":[{"text":"I am the Abzolut god of vodka!"}]}]},{"sprites":[{"prefab":"MP7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP7","narrator":false,"pages":[{"spans":[{"text":"AA-12 was right, she's a total drunkard and impervious to reason."}]}]},{"sprites":[{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"If only there was a way to talk this over... "}]},{"spans":[{"text":"Hey, look, behind A-91... What's that in the fog?"}]}]},{"sprites":[{"prefab":"AA12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AA-12","narrator":false,"pages":[{"spans":[{"text":"It looks like the landmark boss we didn't find earlier... I'll head over to take care of him now."}]}]},{"sprites":[{"prefab":"A91","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Hey, that super insomniac over there! Where the hell do you think you're going with my stuff?!"}]}]},{"sprites":[{"prefab":"AA12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"97type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AA-12","narrator":false,"pages":[{"spans":[{"text":"There's an enemy behind you! Are you drunk on water or something?"}]}]},{"sprites":[{"prefab":"AA12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the enemy approaches, even Springfield's expression grows severe."}]}]},{"sprites":[{"prefab":"M1903","expression":12,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Springfield","narrator":false,"pages":[{"spans":[{"text":"A-91, please listen to me... Right 