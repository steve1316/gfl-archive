type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Late at night, back at the mansion. "}]},{"spans":[{"text":"The Franchouchou girls are sitting impassively in the sitting room, fatigue is written all over their makeup-free faces."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"},{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You have already been ranting in the living room for half an hour. The sofa now sports a row of indentations from where you've punched it."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What gives?! You are both idol groups, so why is there such a big difference in how you're treated?!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"And that Kalina! How could she do that to me?!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Commander... Don't be angry..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You suddenly come to your senses and realize that the one who needs comforting right now isn't you, but Franchouchou, whose performance was a flop."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You stop pacing and look at Sakura, who has been trying to make you feel better."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"We... we failed..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sakura..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"If Kotaro were here, he'd probably have jumped to his feet and called us useless idiots..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sakura is trying to keep up her smile, but her anguish is weighing down the corners of her lips."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't be so hard on yourselves. If you want to cry, just let it all out."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Commander... you're crying even harder than I am..."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_File_Put","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tae presses a used tissue onto your face. You accept it with some trepidation. By now, everyone has gathered all around you."}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-290","spriteScale":"1.3"}}],"ops":[],"speaker":"Tae Yamada","narrator":false,"pages":[{"spans":[{"text":"Awoo... (Don't cry...)"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"60,-190","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"It's nothing worth crying over. Late Night Café is extremely talented and skilled, it is the truth. "}]},{"spans":[{"text":"It may sound harsh, but we must face it and keep working hard to improve."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"60,-90","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Not all is lost, we still have a chance. "}]},{"spans":[{"text":"In four days..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Yeah! We will find a way... "}]},{"spans":[{"text":"We've made it through a lot of setbacks before, and we can do the same again this time."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ai and Junko walk up to Sakura to comfort her. The two girls both look miserable, but their unyielding courage and determination are still shining through."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We've been playing it too safe with the training plan. "}]},{"spans":[{"text":"To prepare for the performance in four days, we must change things up..."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"60,-190","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"I agree, Commander. You've become a proper idol manager."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...You think so?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You let out a bitter chuckle as you recall the events that transpired today. "}]},{"spans":[{"text":"You thought you had found the key to your own world. You dropped everything and ran up to the door, only to realize it was all a lie. "}]},{"spans":[{"text":"On the other side of the door, you were met with a Kalina who didn't know you at all. "}]},{"spans":[{"text":"Right now, all you have is your bond with Franchouchou."}]}]},{"sprites":[{"prefab":"NPC-Saki","expression":11,"shown":true,"side":"left","tags":{"spritePosition":"0,-150","spriteScale":"1.34"}}],"ops":[],"speaker":"Saki Nikaido","narrator":false,"pages":[{"spans":[{"text":"Why are you sulking?! "}]},{"spans":[{"text":"We have every right to moan, but you don't! You have to show us the way forward!"}]}]},{"sprites":[{"prefab":"NPC-Saki","expression":11,"shown":true,"side":"left","tags":{"spritePosition":"0,-150","spriteScale":"1.34"}}],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch","raw":"SE1"}],"speaker":"Saki Nikaido","narrator":false,"pages":[{"spans":[{"text":"Pull yourself together!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Saki whacks you on the back. It is probably just your imagination, but you suspect she was already holding back."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Another hand rests gently on your shoulder."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.9"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Don't worry, this wasn't the first time we'd experienced such things. "}]},{"spans":[{"text":"People were also jeering and making mean comments about us when Franchouchou first started out. We've all learned to take it in stride. "}]},{"spans":[{"text":"Besides, this time, we'll have you with us. As long as we work together, I'm sure we will find a way."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":11,"shown":true,"side":"left","tags":{"spritePosition":"70,-160","spriteScale":"1.24"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Perk up! If we're sad, even our singing will sound bad!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You look down at all the gentle hands trying to console you. You don't know why but you can't help but smile. "}]},{"spans":[{"text":"The Franchouchou girls are the ones who need comforting, but they end up comforting you instead. "}]},{"spans":[{"text":"Still, their encouragement has indeed reinvigorated your numb and tired heart."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Then let's all do our best together!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You hold out your hand, and the Franchouchou girls all place theirs on top of it. "}]},{"spans":[{"text":"This is the solemn promise you have made to them. You will lift Franchouchou up to the very top."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We will redeem ourselves next time!!!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We must make Kalina see us in a whole new light!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
