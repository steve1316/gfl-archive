r me? I'm the Commander..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-180","spriteScale":"1.3"}}],"ops":[],"speaker":"Kalina?","narrator":false,"pages":[{"spans":[{"text":"Commander?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You remember!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina's eyes flash with a familiar glint."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-180","spriteScale":"1.3"}}],"ops":[{"type":"sfx","value":"AVG_Cheerful","raw":"SE1"}],"speaker":"Kalina?","narrator":false,"pages":[{"spans":[{"text":"Don't tell me... you're from the military?!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-180","spriteScale":"1.3"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-180","spriteScale":"1.3"}}],"ops":[],"speaker":"Kalina?","narrator":false,"pages":[{"spans":[{"text":"Do you have gigs for us? "}]},{"spans":[{"text":"Both Late Night Café and Gray Tree have available slots in their schedules for the next few months~"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-180","spriteScale":"1.3"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm a Griffin Commander; I have nothing to do with the military. "}]},{"spans":[{"text":"You're my adjutant! Do you really not remember anything?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-180","spriteScale":"1.3"}}],"ops":[],"speaker":"Kalina?","narrator":false,"pages":[{"spa