er":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II holds M4 tightly for a while, then she looks up."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"And... AR-15... Is that actually you? "}]},{"spans":[{"text":"Didn't you..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I was fully prepared to die, but I didn't get my wish. "}]},{"spans":[{"text":"So I came back...to the same battlefield that you're also fighting on."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"AR-15...AR-15! (Massive sobbing)"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II throws herself at AR-15, almost knocking her off balance."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What's this all of a sudden... "}]},{"spans":[{"text":"Jeez, you're always such a baby..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Just cut her some slack on this occasion, 15."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Seriously, what am I going to do with you? "}]},{"spans":[{"text":"SOP-II, stop crying. "}]},{"spans":[{"text":"We finally meet again, you should be smiling."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AR-15 returns SOP-II's embrace and pats