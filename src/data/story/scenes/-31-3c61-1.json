riffin Dolls take their leave."}]}]},{"sprites":[{"prefab":"Clear Voice","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"They've gone. I will make sure we aren't disturbed in the next few minutes. "}]},{"spans":[{"text":"Now, let's establish a connection with the Pike Node."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"That's it? I just have to plug myself to this piece of metal?"}]}]},{"sprites":[{"prefab":"Clear Voice","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"Leave it to me."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The second she accesses the Node, M4 feels as if she's been sucked into a black hole. "}]},{"spans":[{"text":"The world turns into a void in an instant, then..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG-DjmaxLight","raw":"BIN"},{"type":"whitescreenOff","raw":"白屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lots of glittering shards start tumbling out from within the depths of the black hole. "}]},{"spans":[{"text":"Among these bubbles of memories, a few images stand out—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"—Several coordinates on the world map. "}]},{"spans":[{"text":"—A Relic site being excavated. "}]},{"spans":[{"text":"—Space. "}]},{"spans":[{"text":"—A satellite. "}]},{"spans":[{"text":"—The core of the satellite. "}]},{"spans":[{"text":"—A blinking signal."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"si