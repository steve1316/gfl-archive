, Ange.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Do not destroy the Pike Node. Have it transported to me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"What?!"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"The Pike Node is to be brought into Statesec's custody.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I refuse. "}]},{"spans":[{"text":"According to the original plan, the Pike Node cannot fall into the hands of either side. "}]},{"spans":[{"text":"It has to be destroyed."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Just follow your orders.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Traitors don't take orders from you."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"s