"}]}]},{"sprites":[{"prefab":"Low Female Voice","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Low Female Voice","narrator":false,"pages":[{"spans":[{"text":"So what do you say?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I suppose...there's only one answer."}]}]}]}
