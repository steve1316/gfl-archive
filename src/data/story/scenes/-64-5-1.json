{"name":"-64-5-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_amb_wilderness","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"night","raw":"Night"},{"type":"background","value":"2019summer_12","raw":"BIN"},{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In an unknown area in Sector 2Z64."}]},{"spans":[{"text":"Crack... The rough gravel crushed underfoot lets out an indignant groan."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"...I understand the situation. Come this way."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander turns and looks back uneasily. Their shop in the distance is bathed in warm and inviting moonlight."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Don't worry. We'll make sure you get back here on time tomorrow."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Mizukane is now in the central building. Doesn't look like she's coming this way any time soon."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Good. Looks like we're still flying under the radar."}]},{"spans":[{"text":"This is Batou. I'm sure you know what he's made of by now."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Howdy, Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Hello."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander recalls the frightening sense of intimidation they felt when commanding Batou's prosthetic Dummy."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What about Purin...?"}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"You said you saw her today. How's she doing?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"She seemed okay. Didn't look like she had been harmed."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Right, let's get going then."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Shouldn't we tell her you've made the connection?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Has she asked you about us?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Then there's no need to mention it to her."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Major walks toward the night."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"If she does bring this up, don't tell her you've met us either."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why?"}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Purin is a tenacious kid. She always finishes what she's started."}]},{"spans":[{"text":"She spent a long time investigating Shimamura's case. It's really strange how she just suddenly stopped caring."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Maybe she suddenly realized it's time to let go..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's face falls as they think back on everything that happened earlier today."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Let's leave the matter with Purin aside for now."}]},{"spans":[{"text":"Cutting straight to the chase—how much do you know about the situation here?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"All I know is that the supreme ruler of this place is a being known as \"Big Brother\". Their exact identity is unclear."}]},{"spans":[{"text":"Shimamura and Mizukane oversees the operations of each ministry, though they are trying to recruit me for some reason."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Of course they want to recruit you. The omnipresent telescreens and the myriad of strange measures in place are all for monitoring the Dolls' neural clouds, you see?"}]},{"spans":[{"text":"If you join Sector 2Z64, the Dolls will be stable, and you'll be their walking billboard as a human with a successful cyberbrain conversion."}]},{"spans":[{"text":"Your world is such a mess that the queue of humans who want to undergo the procedure would stretch all the way from Tokyo to Hokkaido. The only saving grace is that the technology is still immature at this stage..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It would be a lie to say that they haven't considered undergoing the conversion. The Commander's nails dig silently into their palms."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"My, my. Don't tell me you were seriously tempted?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"We don't have much time. Before we set off, I'll fill you in on what we know."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Okay."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"17xh-Networld","raw":"BIN"}],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"As you said, the entire Sector 2Z64 is a virtual network operating under an AI, with Shimamura and Mizukane playing important roles in its operations."}]},{"spans":[{"text":"However, it is still unclear what exactly they are in charge of."}]}]},{"sprites":[],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"From what we have observed, they've been trying to connect more Dolls, as well as humans who wish to attempt the cyberbrain conversion."}]},{"spans":[{"text":"But due to the limitations of current technology, humans can only access Sector 2Z64 via an extremely rare piece of equipment—like the one that you're using."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander looks down at their clenched fists, then at their physical body in the real world, which is slumbering on the equipment."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2023SAC_Office","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"According to the information that we have unearthed, the administration of Sector 2Z64 is divided across three ministries—the Ministry of Truth, the Ministry of Love, and the Ministry of Plenty."}]},{"spans":[{"text":"The first is in charge of the news and all entertainment, the second of maintaining law and order, and the third of anything related to the economy."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Purin said 433 worked for the Ministry of Truth..."}]},{"spans":[{"text":"I've also met Ibis, who's in the Ministry of Love."}]}]},{"sprites":[],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Ministry of Love... Looks like Shimamura and Mizukane are still quite wary of you."}]}]},{"sprites":[],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Hardly surprising. They're probably trying to determine which side you'll choose."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"night","raw":"Night"},{"type":"background","value":"2019summer_12","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Let's leave the internal dilemma for later."}]},{"spans":[{"text":"Batou, all set?"}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Yep, ready whenever you are."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Let's go, Commander."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Where are we going?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Just come with us."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"If you want to back out, now's the time."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No..."}]},{"spans":[{"text":"It's just that I'm usually the one giving orders. This is the first time I'm getting bossed around on the field."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"You don't exactly have any subordinates to give orders to right now."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Isn't this why you're here?"}]},{"spans":[{"text":"To get your Dolls back and wake them from their sweet dreams."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Now you're worried they'd hold it against you for destroying a perfectly good dream?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kusanagi stops walking and turns to the Commander. The Commander cannot see her face clearly in the dark."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"As I said, you can still turn back."}]},{"spans":[{"text":"Leave the past behind and live a carefree life here."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A drifting cherry blossom petal once again lands on the Commander's shoulder."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2019summer_12","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"So what is it gonna be?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I want to stay with my Dolls, but not here, not under someone's control."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"You want to bring them back to that bleak reality. Aren't you scared that they'd hate you for it?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I am, but I'm even more scared of not moving forward."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Major, you can't expect someone to make this difficult decision in such a short time."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Major peers warily into the darkness behind her."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Get in the car."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Still simmering with questions, the Commander climbs into the back seat of the jeep."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_21summer_intro_DemonVariation","raw":"BGM"},{"type":"sfx","value":"AVG_brake","raw":"SE1"},{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=3%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kusanagi floors the gas, and the jeep bolts forward."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"shake","value":"%%type_id=2%%duration=3000%%delay=0.1%%range=2","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1.6%%duration=0%%","raw":"bg_move"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2021summer_Research","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1%%duration=1%%","raw":"bg_move"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With great difficulty, the Commander leans forward against the Euler force pushing them back into the seat as the car accelerates. They hold onto Batou's and the Major's seats for dear life."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Can you at least tell me what the objective is?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"\"Anything Goes\", yeah?"}]},{"spans":[{"text":"Then we have a job for you."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What job?"}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Take this."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Batou hands over a P90 and several magazines. The Commander takes it in surprise."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Aren't they extremely strict with firearms here...? How did you get your hands on this?"}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Don't be silly."}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Batou","narrator":false,"pages":[{"spans":[{"text":"Rules are made to be broken."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander stows the gun away with mixed feelings and waits for Kusanagi to continue."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"Now, the job."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Please explain."}]}]},{"sprites":[{"prefab":"NPC-Motoko","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-40,130"}}],"ops":[],"speaker":"Motoko Kusanagi","narrator":false,"pages":[{"spans":[{"text":"You are to escort us safely to a designated location."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Me? Escort you?"}]}]},{"sprites":[{"prefab":"NPC-Batou","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker