{"name":"-57-L6-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Livingroom_a","raw":"BIN"},{"type":"bgm","value":"BGM_Saga_AVG_Day","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ever since you came to Saga, it's been one thing after another between training, promoting, and shows."}]},{"spans":[{"text":"At long last, you have some free time, which you spend on leaning back and letting your head sink into the soft fabric of the sofa."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The only thing that would make it better would be Kalin making you a pot of tea, and you wonder what the others are doing back at the base..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as you manage to relax both body and soul, a series of rapid footsteps approaches you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily pokes her head out from behind the sofa and waves a white card in front of you."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Commander, someone asked Lily to hand you this."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You take the card. A single line of words is printed on it. \"I know who you are. Meet me here.\""}]},{"spans":[{"text":"A set of coordinates is written below it, probably a location somewhere near the mansion."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Who gave this to you?"}]},{"spans":[{"text":"Was it Gray Tree or Late Night Café? Did they remember me at last...?","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"They were wearing a mask, so Lily couldn't tell."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"A mask... Was it the ninja? Well, it doesn't matter, I'll know once I see them.","style":{"color":"#A9A9A9"}}]},{"spans":[{"text":"Thank you, Lily, I'm heading out for a bit!"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Okay..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2023SAGA_Courtyard","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"For safety's sake, you don't announce your presence the moment you arrive. Instead, you hide in the darkness and observe the surroundings."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There's nobody around, and the only audible sound is the chirping of bugs, but perhaps this mysterious individual will show themselves in the next moment..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"？？？？","narrator":false,"pages":[{"spans":[{"text":"Com..."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Who's that?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An unexpected voice suddenly speaks from behind you. You jerk your head back and reach out to grab their arm."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_20HW_Scene_BPM82_loop","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"However... the arm is a little low, so you only manage to grab it the second time."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily, what are you...! You hurriedly let go."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Lily, were you following me all this time?"}]},{"spans":[{"text":"That must have hurt. I'm sorry..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily shakes her head, her eyes sparkling."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"That was sooooo cool! Just like what a secret agent ought to be!"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Secret agent?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Aw, you don't need to pretend. This place is well-hidden; nobody's going to hear you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Upon hearing this, you gradually realize what's going on."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait, so you were the one who asked to meet me here, Lily?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Yup! Lily thought of this so the others at the mansion wouldn't hear about it!"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Teehee, it's a great secret agent cliché, isn't it?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily proudly raises her index finger."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You've been talking about secret agents and so on for a while now... What's going on?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Lily kept hearing you mutter to yourself about \"the base\", \"your gun\", \"information\", and whatever, as well as all kinds of country and place names... You sound just like the lead of the spy movie that Lily acted in!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She then slowly points a finger at me, like the cool, calculating protagonist of a detective story."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"You... You are a secret agent, isn't that right?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hmm, you can put it that way..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"So is being Franchouchou's producer part of your mission as a secret agent?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"bgm","value":"GF_Memorial","raw":"BGM"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Will you be going back after you finish your mission? Will you go and meet... Kalin?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily tilts her head as she asks tentatively."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"(Sighs) Did I really say all that...? "}]},{"spans":[{"text":"Yes, there are a lot of people in the base waiting for me, Kalin included."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"When the time comes, I'll probably have to part ways with Franchouchou..."}]},{"spans":[{"text":"Will there still be someone to watch TV, eat, and go shopping with Lily?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Um..."}]},{"spans":[{"text":"Could you take Lily with you to the base? Lily wants to be a secret agent and have adventures with you all over the world too, Commander..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Eh?! "}],"choices":["Agree.","Refuse."]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hmm, that DOES sound like a good idea, doesn't it? I'm pretty sure Lily's wealth of acting experience would come in handy too."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Granted, you don't know if that's actually going to work out..."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm sorry, Lily... But this job is much more dangerous than you think it is. I can't agree to that."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Surprisingly, Lily responds with a laugh."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Aw, Lily just thought that becoming a friend of justice would be super cool, so Lily was just looking for a chance to say that."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Lily's job is being an idol, and Lily likes being an idol and living with Franchouchou."}]},{"spans":[{"text":"Still, Lily is very happy that you put so much thought into it, Commander..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Actually, I was really happy when I heard you say that, Lily."}]},{"spans":[{"text":"After all, we probably won't be able to contact each other after I leave...","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lily stands on her tiptoes and blows away a fallen leaf on your shoulder as though she's read your mind."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"In the movies, they say that it's a fatal mistake for an agent to leave traces of themselves behind..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"But it's okay! Even if we don't meet again, Lily will pray for you, Commander."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"So make sure you have a good life!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You nod solemnly."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I promise you that I will."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"And you don't need to worry too much about it either. Even if you DO die, Lily will ask Tatsumi to bring you back to life as a zombie!"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"AVG_Awkward","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I appreciate the sentiment."}]}]}]}
