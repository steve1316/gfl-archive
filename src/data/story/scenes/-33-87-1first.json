{"name":"-33-87-1First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2019summer_7","raw":"BIN"},{"type":"bgm","value":"BGM_Pervaded","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In Griffin's temporary command center."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Many people have their eyes on us..."}]}]},{"sprites":[{"prefab":"Commander","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's why we also need more information."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"New intel?"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Oh, it actually got through.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Whoa! How come the comms just activated itself?!"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"What's the matter? Have you been up to something no good?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"We were just startled by your sudden forced transmission, Mr Havier!"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Sorry about that. Allow me to first congratulate you on making it out of Tallinn in one piece.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"We'd expected as much, but everyone is still very pleased with the outcome.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Commander","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I doubt you called just to thank us for our work."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"I know this is a bit abrupt, but don't worry, it just shows that he does like you.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Since we're already speaking, I might as well offer a little piece of advice.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Commander","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Please do."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"I know you went ahead and agreed to Persica's request, so I'll save you the boredom of listening to more platitude.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"However, I strongly suggest you don't let Statesec know about what Persica's AR Team brought back.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"That thing...could save your life at a desperate moment, but it could also cost you your life just when you think you're safe.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Commander","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"That's it. I won't intrude upon you any longer. I hope your usual luck will persist through the rest of your journey, and I look forward to meeting you in person...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"...If you can make it back alive, that is.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"【Shattered Connexion - END】"}]}]}]}
