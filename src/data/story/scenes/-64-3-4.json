,{"spans":[{"text":"You need a proper holiday to let your mind and body recover, otherwise—"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This isn't the time. I'll think about it once the base is properly up and running."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"You don't want to keep the Dolls waiting, but you'll put off ending your own suffering?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"433 takes a deep breath."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"There's something that I've been meaning to say to you..."}]},{"spans":[{"text":"It has nothing to do with work, and it may take up some of your precious resting time..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Go ahead."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"433","narrator":false,"pages":[{"spans":[{"text":"The truth is, we—"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"frame","value":"2","raw":"边框"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"433 is interrupted by an emergency call from Persica."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After that, all that was left unsaid fades away in reality, along with all the unfulfilled \"next times\"."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"1.5","raw":"CGDelay"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"2021summer_Street","raw":"BIN"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Never mind. Forget I asked."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Please wait, Commander!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 390 stops the Commander from turning to leave."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"I can't quite tell why, but I have a feeling there's some kind of misunderstanding between us."}]},{"spans":[{"text":"The way you looked at me the first time we met..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Misunderstanding, huh..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's eyes harden once more."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Please explain it clearly."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why did you betray me? Why did you sell out Boys and Purin?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"What are you talking about? I have done no such thing..."}]},{"spans":[{"text":"And who are Boys and Purin?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Does this betrayal that you mentioned concern these two people?"}]},{"spans":[{"text":"If you trust me, please tell me their designations and I can make some inquiries for you."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"...Commander?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pag