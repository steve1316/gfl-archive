ood review!"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Let's leave it for today. I'll see you tomorrow."}]},{"spans":[{"text":"Tomorrow, I'll definitely—"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"433..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"...What?"}]},{"spans":[{"text":"What's 433..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Scar_Shenzhizi","raw":"BGM"},{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The brooding visitor suddenly looks straight into No. 390's eyes. Only then does she notice this sullen visitor actually has a look of great fortitude in their eyes."}]},{"spans":[{"text":"But at this moment, those eyes are filled with pain and sorrow."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What was it that you wanted to tell me before I left?"}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"What I wanted to tell you... before you left?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"