-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Sorry, I forgot you couldn't speak."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 388 reaches through the bars and removes No. 260's gag."}]}]},{"sprites":[{"prefab":"pa15","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,100"}}],"ops":[],"speaker":"No. 260","narrator":false,"pages":[{"spans":[{"text":"...Humph, so what?"}]},{"spans":[{"text":"Events can repeat all they want. I don't care as long as I can keep having fun."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is how most people would respond. They simply do not care if they live within a time loop as long as their lifestyle remains unchanged."}]},{"spans":[{"text":"Is she the only one who is bothered by that?"}]}]},{"sprites":[{"prefab":"pa15","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,100"}}],"ops":[],"speaker":"No. 260","narrator":false,"pages":[{"spans":[{"text":"Hey, I was just speeding! That's not a crime worthy of a visit from Miss Mizukane, is it?!"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 388 is so lost in her riling thoughts she did not even notice Miss Mizukane's shadow falling over her."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Miss Mizukane."}]}]},{"sprites":[{"prefab":"NPC-Suzuka","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-160,100"}}],"ops":[],"speaker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"No. 388, is No. 260's case dealt with?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Yes, ma'am. The case will now be handed over to the interrogator."}]}]},{"sprites":[{"prefab":"NPC-Suzuka","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-160,100"}}],"ops":[],"speaker":"Suzuka Mizukane","narrator":false,"pages":[{"spans":[{"text":"Perfect timing then. I have a new mission for you."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAC_LonelyBlock","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In the park in Sector 2Z64."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"bgm","value":"BGM_SAC2045_Utopia","raw":"BGM"}],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"...A human with a pending cyberbrain conversion, designation \"Commander\"."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 388 studies her mission target from afar. The human is sitting on a bench in the park and gazing up at the night sky with a look of melancholy."}]},{"spans":[{"text":"It's hard to imagine why someone like this would need to have their risk factor assessed."}]},{"spans":[{"text":"To No. 388, her target just seems to be a deeply unhappy person that she feels sorry for."}]},{"spans":[{"text":"But she has no choice but to follow Miss Mizukane's order."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"backgroundMove","value":"%%pivot_x=0.7%%pivot_y=0.4%%scale=1.7%%duration=0%%","raw":"bg_move"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2023SAC_LonelyBlock","raw":"BIN"}],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Hello, Commander."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"I hope you don't mind if I sit next to you."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"1","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before waiting for the Commander's reply, No. 388 sits down on the other end of the bench."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a brief pause, No. 388 breaks the silence."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Allow me to introduce myself. I am No. 388 from the Investigation Department of the Ministry of Love."}]},{"spans":[{"text":"I'm here to collect some feedback regarding your visit. After all, as the first human visitor without a cyberbrain, your opinion matters a great deal to us."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"According to the report submitted by No. 390, who was your guide today, she felt rather dismayed for not being able to provide you with satisfactory service."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"She did very well."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"In the report, she mentioned that you were very depressed throughout your visit, whether you were touring the residential area or the utility areas of our different departments."}]},{"spans":[{"text":"No. 390 could not determine the cause of your unhappiness. Would you be so kind as to share your feelings with me?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Do you care so much about me just because of your job?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"No."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 388 suddenly smiles cheerfully."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"My routine work is very monotonous."}]},{"spans":[{"text":"I sit at the office of the Ministry of Love and wait for my comrades to bring in people who broke the law. I complete their registration and transfer them to the interrogation room."}]},{"spans":[{"text":"The people who come and go are pretty much the same from day to day. Sometimes I even wonder if I'm just reliving the same day over and over again."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So, is investigating me a special mission for you?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Yes. I have never received such an assignment before, so I might have let it get to my head a bit too much."}]},{"spans":[{"text":"Do forgive me."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The visitor falls silent and seems to stare into space, but No. 388 notices that they are actually scanning the telescreens in the area."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Our telescreens record everything they see and hear."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So they're a part of your surveillance system. Was that how you found me?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Yes, the telescreens are how we communicate with each other. We also use them to obtain information and receive orders beyond our authorization."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So it's just a tool for communication?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Big Brother rules over the entire Sector 2Z64 using the telescreens as well."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Big Brother?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Big Brother is the top leader of Sector 2Z64. An ordinary civilian like me can never hope to meet Big Brother, of course."}]},{"spans":[{"text":"So we have no way of knowing Big Brother's gender, age, physical appearance, etc."}]},{"spans":[{"text":"What we do know is that Big Brother is omniscient and omnipotent and that Big Brother is always right."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"In other words, you can't actually be sure if \"Big Brother\" is even a person that exists."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"That's true, but no matter who or what Big Brother is, he is running Sector 2Z64 effectively."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Running it effectively..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 388 can see that the Commander is pondering something with a deep frown."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_machine_turn","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She decides to leave them with their own thoughts and walks over to the vending machine nearby. She buys two cans of drinks and offers one to the Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Grape juice? That's not very like you..."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Nothing."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"I've answered your questions. In return, could you tell me what you think about Sector 2Z64?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's a fool's paradise filled with pointless hustle and bustle."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"So I take it you believe Sector 2Z64 is an empty illusion?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"What makes you think so?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The visitor known as the Commander stops weighing the can of grape juice. After a short pause..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2023SAC_LonelyBlock","raw":"BIN"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0.1%%range=6","raw":"controll_shake"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"backgroundMove","value":"%%pivot_x=0.3%%pivot_y=0.55%%scale=1.7%%duration=0.3%%","raw":"bg_move"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They fling the can vehemently at the telescreen before them."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Crack! The telescreen is smashed right in the center."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Fire_Alarm","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Then comes the ear-splitting shriek of the alarm."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"backgroundMove","value":"%%pivot_x=0.7%%pivot_y=0.4%%scale=1.7%%duration=0%%","raw":"bg_move"},{"type":"background","value":"2023SAC_LonelyBlock","raw":"BIN"},{"type":"bgm","value":"BGM_23S_Crossroads_Warrior","raw":"BGM"}],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Now Big Brother can't eavesdrop on our conversation."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Tell me the truth."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"About what?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Do you enjoy your life here? Do you genuinely think living here... is better than living somewhere else?"}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Hm..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 388 thinks for a while and meets the Commander's gaze solemnly."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"I don't exactly enjoy my life here, but I don't hate it either."}]},{"spans":[{"text":"I have never lived anywhere else, but I suppose life can't be so different no matter where I live."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"You don't seem very happy with my answer."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I just want to have another proper chat with you over some booze..."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Booze? Commander, alcohol has been banned for years."}]},{"spans":[{"text":"In fact, I believe it has been centuries since the time when we could consume alcohol at a table."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"Excuse me, I've just received an emergency call. I must go."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 388 jogs off but suddenly stops and turns around. The Commander has resumed their melancholic study of the night sky."}]},{"spans":[{"text":"She breathes in the aroma of grape juice in the air."}]}]},{"sprites":[{"prefab":"NPC-QBU191","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-80,0"}}],"ops":[],"speaker":"No. 388","narrator":false,"pages":[{"spans":[{"text":"They say people in the past would make wine by fermenting grape juice."}]},{"spans":[{"text":"If we ever get the chance, why don't we try some together in secret?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No. 388's long, dark hair disappears completely into the night."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"cgDelay","value":"1.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAC_LonelyBlock","raw":"BIN"},{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The maintenance staff that rushed to the scene has disabled the alarm and replaced the smashed telescreen."}]},{"spans":[{"text":"It is as if nothing had ever happened in the spacious and quiet park."}]},{"spans":[{"text":"The Commander is still sitting on the same bench, staring in the direction in which Ibis has departed."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No. 388... She has even forgotten her own name..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A notification pings softly, and a chat window pops up in front of the Commander."}]},{"spans":[{"text":"It's a call from No. 390."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130","commsBox":""}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Commander!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130","commsBox":""}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"I ran a search on the names you mentioned—\"Boys\" and \"Purin\"—in the database but didn't find anything...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"It struck me as a bit odd, as even if there's no such data in the database, the search engine should've brought up similar results.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I will try to run searches on other databases. Please wait a bit longer.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130","commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130","commsBox":""}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"Also, you accused me of betraying you before you stormed off. I'd like to make something clear.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"As someone who has been awarded \"Best Employee\" in the Ministry of Truth for three years in a row, I would never be a traitor!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,130","commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"You haven't changed at all..."}]}]},{"sprites":[{"prefab":"NPC-HK433","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,130","commsBox":""}}],"ops":[],"speaker":"No. 390","narrator":false,"pages":[{"spans":[{"text":"What does that mean? Have we met before?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander closes the chat window."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"SAC_2045_ARDevice_Activate","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After staring at the colorful interface in a daze for a while, the Commander, as if possessed, pulls up their memory interface."}]},{"spans":[{"text":"Since they have not undergone cyberbrain conversion, the memory interface is only a simulated display."}]},{"spans":[{"text":"But if..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Will I also be able to forget everything about the past, just like them?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
