":[{"spans":[{"text":"You're about to get up and ask her to leave, but she grabs you by the arm before you can say anything."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-180","spriteScale":"1.3"}}],"ops":[],"speaker":"Kalina?","narrator":false,"pages":[{"spans":[{"text":"I'm very interested in the Griffin base that you mentioned the other day!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-180","spriteScale":"1.3"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Kalina?","narrator":false,"pages":[{"spans":[{"text":"I did some research after our conversation, but all I could find about that was..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-180","spriteScale":"1.3"}}],"ops":[{"type":"bgm","value":"BGM_Home","raw":"BGM"}],"speaker":"Kalina?","narrator":false,"pages":[{"spans":[{"text":"\"Girls' Frontline\" is a gacha and real-time strategy mobile game that features a fascinating story in an expansive post-apocalyptic world! "}]},{"spans":[{"text":"Hundreds of T-Dolls, illustrated by many renowned artists, assemble at Griffin! In these dark times, what will fate have in store for the Griffin Commander and the T-Dolls?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-360","spriteScale":"1.6"}}],"ops":[{"type":"sfx","value":"AVG_Rromantic","raw":"SE1"}],"speaker":"Kalina?","narrator":false,"pages":[{"spans":[{"text":"Commander, please give the order!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-360","spriteScale":"1.6"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":1,"s