{"name":"-57-6-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Studio","raw":"BIN"},{"type":"bgm","value":"BGM_Saga_AVG_Day","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You are sitting inside the television studio, feeling a little anxious. "}]},{"spans":[{"text":"Once Franchouchou's concert was confirmed last night, you resolved to help them promote it so that more people can see their radiance. "}]},{"spans":[{"text":"This is why you're here. "}]},{"spans":[{"text":"You have made every preparation, and you believe that Franchouchou has also steeled themselves for what's to come."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[],"speaker":"Production Assistant","narrator":false,"pages":[{"spans":[{"text":"Let me know when you're ready."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Right."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You can sense that Franchouchou has placed their fate in your hand. "}]},{"spans":[{"text":"This isn't the first time you've held sway over others' fate, but this is very different. What you have in your hand is the girls' dreams. "}]},{"spans":[{"text":"And you will fight for these dreams to the bitter end."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm ready."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[],"speaker":"Production Assistant","narrato