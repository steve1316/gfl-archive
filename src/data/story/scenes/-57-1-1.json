{"name":"-57-1-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Street_a","raw":"BIN"},{"type":"bgm","value":"Campaion-34","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a long and busy morning, you walk on the street, completely exhausted."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm starving... "}]},{"spans":[{"text":"I miss the good old days when I had an adjutant who would bring me my lunch..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You lean feebly against a wall. This place called \"Saga\" is far more technologically backward compared to the Griffin base. There are no electric bike rentals, and even GPS navigation doesn't exist yet. "}]},{"spans":[{"text":"You've already gotten lost multiple times in this small city in a single morning."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Better get something to eat first."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The modest signboard of the convenience store comes into view from across the street. "}]},{"spans":[{"text":"You arrive at the entrance and catch a glimpse of familiar figures just as you are about to enter."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You hesitate at the door, uncertain if you should go up and say hello, when their chatter becomes audible to you."}]}]},{"sprites":[],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Have you seen the Commander this morning? "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"Hm... I see..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girls are huddled together in a hushed conversation about you, but you're still too far away to catch everything."}]}]},{"sprites":[],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"Do you think the Commander will be able to help us complete the concert?"}]}]},{"sprites":[],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"We'll definitely be fine, whether or not we have the Commander's support..."}]}]},{"sprites":[],"ops":[],"speaker":"Saki Nikaido","narrator":false,"pages":[{"spans":[{"text":"Humph, I'm just curious to see what this specially hired expert is made of!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Looks like the girls still do not completely trust your abilities, but that's only to be expected. "}]},{"spans":[{"text":"After all, when you first joined Griffin, it also took you a very long time to come to terms with the the fact that your work involves a lot more than simply \"repelling the occasional Sangvis Ferri intruders\". "}]},{"spans":[{"text":"It took an even longer time for you to get to know the hundreds of Dolls serving under your command."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You let out a wistful chuckle at the thought and gaze at the seven girls whom you have only met recently..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"bgm","value":"BGM_Saga_AVG_Day","raw":"BGM"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"21Jashin_gatyakan","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is No. 1, Sakura Minamoto. "}]},{"spans":[{"text":"Gentle, approachable, yet can be quite sensitive."}]}]},{"sprites":[{"prefab":"NPC-Saki","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-190","spriteScale":"1.4"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is No. 2, Saki Nikaido. "}]},{"spans":[{"text":"She may look like a mean delinquent at first glance, but she strikes you as a very genuine person with a kind of bold candidness."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is No. 3, Ai Mizuno. "}]},{"spans":[{"text":"Calm and collected, she can make sound judgment calls promptly in rapidly-changing situations."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is No. 4, Junko Konno. "}]},{"spans":[{"text":"Quiet and reserved, with a hint of melancholy. The type that will take some coaxing to open up."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is No. 5, Yugiri. "}]},{"spans":[{"text":"Probably the most mature one out of the seven. Charming, graceful, and very perceptive."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is No. 6, Lily Hoshikawa. "}]},{"spans":[{"text":"She has the appearance and bearing of a cute and innocent child, but she is more wise and mature than she lets on."}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-340","spriteScale":"1.4"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is No. 0, Tae Yamada. "}]},{"spans":[{"text":"She doesn't seem capable of intelligible speech, and her actions are often unpredictable. An interesting subject for observation."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2023SAGA_Street_a","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"These seven girls of diverse characters form a group known as \"Franchouchou\". That's all the information you have managed to piece together so far. "}]},{"spans":[{"text":"Your thoughts are interrupted by more conversation drifting over from inside the shop."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"21Jashin_gatyakan","raw":"BIN"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Why don't we eat while we talk?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Our seven bentos, plus the Commander's. I've got everything."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"sfx","value":"AVG_Card_Reader","raw":"SE1"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Hello, that's 4,000 yen for a total of 8 bentos. Would you like them microwaved?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_Wonder","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You notice that the smile has frozen on Lily's face as she stands in front of the cashier."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"What's wrong, Lily?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Are we short on money?"}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"sfx","value":"AVG_Awkward","raw":"SE1"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Yeah... Just by a bit."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The awkwardness is almost palpable in the air. The girls look crestfallen. "}]},{"spans":[{"text":"You shift your gaze away, finding this difficult to watch even from outside the door."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Excuse me, would you still like these bentos?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"So what are you going to do?"}],"choices":["A. March in heroically and pay on Franchouchou's behalf.","B. Snicker at Franchouchou's humiliation and run off.","C. Grab the bentos and run with the girls."]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"branch","value":"3","raw":"分支"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Street_a","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You frown a little as you size up the cashier of the convenience store who is wearing a professional smile. "}]},{"spans":[{"text":"He is quite lean for an adult man; you should be able to knock him down easily with your years of combat experience. "}]},{"spans":[{"text":"Besides, this is a parallel universe. Perhaps doing something \"unusual\" could break the world and propel you back to your own reality."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"bgm","value":"m_wv_title","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Having arrived at a conclusion, your lips curl up in a dangerous smile as you push open the door of the convenience store."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"},{"type":"sfx","value":"AVG_20Winter_Doorbell","raw":"SE1"},{"type":"branch","value":"3","raw":"分支"},{"type":"background","value":"21Jashin_gatyakan","raw":"BIN"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Welcome~!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What did you just say?"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You stand coldly in front of the cashier and stares intensely at his forehead— "}]},{"spans":[{"text":"Apparently, this gesture of intimidation can convince others that you are not to be messed with."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Just now, you mean? I asked them if they still wanted these eight bentos."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"3","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Well, I'm taking them all."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"sfx","value":"AVG_Card_Reader","raw":"SE1"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Sure, that would be 4,000 yen."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You flash a dastardly grin, grab the stack of eight bentos, and beckon at the Franchouchou members standing behind you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"branch","value":"3","raw":"分支"},{"type":"shake","raw":"震屏3"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're not getting a single cent from me!","style":{"size":"50"}}]},{"spans":[{"text":"You lot, come with me!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=4%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You sprint towards the exit of the convenience store as if you were fleeing from a hoard of ELIDs—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"branch","value":"3","raw":"分支"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh! Something clamps around your arms and legs, holding you securely in place."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"black","raw":"BIN"},{"type":"branch","value":"3","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before you register what is happening, you have already completed several revolutions through the air and been deposited safely in the cashier's arms."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"branch","value":"3","raw":"分支"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"background","value":"21Jashin_gatyakan","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"sfx","value":"AVG_Awkward","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"bgm","value":"Campaion-34","raw":"BGM"},{"type":"branch","value":"3","raw":"分支"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Hello, that would be 4,000 yen, please."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"sfx","value":"AVG_Zipper","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The cashier's voice seems to radiate some kind of compelling magic. You obediently fish out the money you got from pawning off what valuables you had earlier."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"sfx","value":"AVG_Cash_register","raw":"SE1"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Yes, taking 4,000 yen in cash. "}]},{"spans":[{"text":"Would you like the bentos microwaved?"}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"3","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes...","style":{"size":"25"}}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The cashier puts you down across the counter and starts heating up the bentos."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Commander, what just happened?"}]}]},{"sprites":[{"prefab":"NPC-Saki","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-190","spriteScale":"1.4"}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Saki Nikaido","narrator":false,"pages":[{"spans":[{"text":"Seriously, what the hell was that?! What's with that levitation?!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I... I don't know either..."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"branch","value":"3","raw":"分支"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Excuse me, all the bentos have been heated up. Please enjoy your meal."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Still dumbfounded, you collect the bentos and have a simple lunch with Franchouchou. "}]},{"spans":[{"text":"Although you're still not entirely sure what just happened, at least you have had a happy lunch break."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You grit your teeth and fish out the money you got from pawning off what valuables you had earlier. Then you push open the door and enter the convenience store."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Sakura","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"background","value":"21Jashin_gatyakan","raw":"BIN"},{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"},{"type":"sfx","value":"AVG_20Winter_Doorbell","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Commander...!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"bgm","value":"m_wv_title","raw":"BGM"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You push Lily, who is still standing in a daze in front of the cashier counter, gently but firmly aside."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"AVG_Zipper","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'll foot the bill. 4,000 yen in total, yeah?"}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"AVG_TurnOverCard","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As you put down your limited cash with feigned nonchalance, you can almost feel your charm go up by 200 points—if such stats exist in this universe."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, you feel a strong tug on the hem of your coat."}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-340","spriteScale":"1.4"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Tae Yamada","narrator":false,"pages":[{"spans":[{"text":"Ugh... Argh... (The translator is offline.)"}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-340","spriteScale":"1.4"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What is it, Tae?"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tae places two packets of dried shredded squid on top of the bentos and points at you."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Tae, you can't...!"}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-340","spriteScale":"1.4"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Tae Yamada","narrator":false,"pages":[{"spans":[{"text":"Aaaaargh... Gah...! (I want them! Buy them for me! Dried shredded squid!)","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-340","spriteScale":"1.4"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"AVG_TurnOverCard","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Fine. Please include these as well."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"AVG_Bite","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tae mumbles happily, and the two packets of dried shredded squid vanish into thin air in an instant."}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"AVG_Cash_register","raw":"SE1"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Sure thing. That would be 4,200 yen altogether. Taking 4,200 yen in cash. Please take your items. "}]},{"spans":[{"text":"Would you like the bentos microwaved?"}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes, please."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Thank you, Commander!"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Being cared for makes me feel all warm and fuzzy."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's alright. We're now a team, after all. "}]},{"spans":[{"text":"We're all in this together, through thick and thin."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Franchouchou girls' eyes shine with gratitude. You believe you have done the right thing by strengthening your bond with them. "}]},{"spans":[{"text":"Perhaps this will benefit your subsequent work. "}]},{"spans":[{"text":"Perhaps this is the ice-breaker needed for everyone to begin their training, complete the concert, then send you off happily so that you can return to Griffin, where you must be very sorely missed... "}]},{"spans":[{"text":"At the thought of this, you beam contently."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Thank you, Commander. I'll be going then."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"I also have other matters to attend to. Please enjoy your meal."}]}]},{"sprites":[{"prefab":"NPC-Saki","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-190","spriteScale":"1.4"}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Saki Nikaido","narrator":false,"pages":[{"spans":[{"text":"Thanks for lunch, but don't think you can bribe me with this!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"A-are we not eating together?"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"},{"type":"sfx","value":"AVG_20Winter_Doorbell","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Your fantasy is instantly shattered, but at least a few of the girls are staying to have lunch with you."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"AVG_tableware","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You end up having a simple lunch accompanied by some pleasant chit-chat. "}]},{"spans":[{"text":"Other than needing to stop Tae from getting another packet of dried shredded squid, it has been a lovely lunch break."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"bgm","value":"GF_20HW_Battle1_BPM102_Loop","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You let out a low snicker. How dare they gossip about you behind your back. They haven't actually spoken ill of you, but this feeling of being excluded isn't cool at all. "}]},{"spans":[{"text":"You pull a face at the Franchouchou girls' stiff backs through the shop window before turning to find another place to eat."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But just then, Tae turns her head—"}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-340","spriteScale":"1.4"}}],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"AVG_Cheerful","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"—and spots you immediately. You can see her inert face light up with elation."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"She's going to tell the others I'm here!","style":{"color":"#A9A9A9"}}]},{"spans":[{"text":"I gotta leave the scene right now!","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Relying on your abundance of combat experience, you lift your left arm and stride out with your left leg... No, wait, that's rubbish coordination. It should be your right—"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before you can adjust your movement, your body is already shooting ahead of your brain, and you end up lifting both your legs one after the other within a split second—"}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=3%%delay=0.1%%range=8","raw":"controll_shake"},{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"And so, your left leg kicks off on your right leg, which sends you soaring into the convenience store."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_lifttable","raw":"SE1"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Crash! Boom!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Awkward","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"21Jashin_gatyakan","raw":"BIN"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Franchouchou","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Tae","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-340","spriteScale":"1.4"}}],"ops":[{"type":"bgm","value":"Campaion-34","raw":"BGM"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Tae Yamada","narrator":false,"pages":[{"spans":[{"text":"Ugh... Argh... (Dried shredded squid... Dried shredded squid...)"}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Convenience Store Cashier","narrator":false,"pages":[{"spans":[{"text":"Um... That was quite some impressive agility. Are you alright?"}]}]},{"sprites":[{"prefab":"NPC-Ninja","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-420","spriteScale":"1.6"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm fine... I'm okay..."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You scramble to your feet sheepishly and look over at the Franchouchou girls, who are gawking at you in a daze. "}]},{"spans":[{"text":"To break the awkward silence hanging in the air, you decide to say something."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why don't we have lunch together?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"S... sure..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"But we don't have enough..."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's okay, I'll pay."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"AVG_Cash_register","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You pull out your wallet reluctantly and pay at the counter."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is money you got from pawning off what valuables you had earlier. There isn't much, so spend it wisely."}]}]},{"sprites":[{"prefab":"NPC-Lily","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"70,-170","spriteScale":"1.21"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Lily Hoshikawa","narrator":false,"pages":[{"spans":[{"text":"Thank you, Commander!"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Come and sit over here, Commander. We've got a table."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Alright, I'm coming."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You lose some cash, but you get to enjoy a nice and leisurely lunch break in exchange. "}]},{"spans":[{"text":"A simple lunch accompanied by some pleasant chit-chat."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
