[{"text":"... "}]},{"spans":[{"text":"You call this a weapon to protect myself?! "}]},{"spans":[{"text":"Also, since when did Griffin have so much free time to idle away? Why would they run all the way to my base to rummage through this trash?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ouroboros disdainfully wads the picture up into a ball and throws it to the ground."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"Ouroboros, this is your last chance. "}]},{"spans":[{"text":"If you do not pass Griffin's neural calibration exam, you will be scrapped and returned to the AI storage vault. "}]},{"spans":[{"text":"If that happens, the next time we meet might be at a children's science fair one hundred years later."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"\"Kids, do you see this AI? This is the oldest AI sample we have in storage. Everyone, wave hi to her.\""}]}]},{"sprites":[{"prefab":"Weaver","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"You!"}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"I've sent you all the information regarding the exam material and the Griffin base."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"Survive by any means necessary. That IS your specialty, after all."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn"