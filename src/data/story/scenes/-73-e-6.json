ator":false,"pages":[{"spans":[{"text":"Hurry! The fire's getting worse!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Someone rushes past the Commander, hauling a bucket of water."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd_Run","raw":"SE1"},{"type":"bgm","value":"BGM_arenabreakout_battle2","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander immediately follows the man. They're headed straight for the medical outpost."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Burnfire_Loop","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2022winter_Fire","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What happened...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Turning the corner, the Commander sees thick black smoke billowing from the clinic's windows. The man with the bucket dashes inside."}]}]},{"sprites":[],"ops":[],"speaker":"Passer-by","narrator":false,"pages":[{"spans":[{"text":"There are still people in there!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander strips off their coat, soaks it in a water bucket nearby, throws it over their head, and rushes into the building."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":fa