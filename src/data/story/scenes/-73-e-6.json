se,"pages":[{"spans":[{"text":"You'll see her."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Yeah! I will! I've even prepared a gift for her!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Susan pulls out a string of colorful, glimmering beads from her pocket."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Don't they look like candy?"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Kind of."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"I strung them myself. Took me ages to collect enough pretty ones..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Under the light, she excitedly shows the Commander the fruits of her labor and explains the story behind each bead, utterly oblivious to the Commander's distracted silence."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"...Anyway, I'll make sure to hand it to Dr. Evita myself."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"It's getting late. I won't keep you. I'll visit again tomorrow."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Carefully packing the beads into a small cloth pouch, Susan tucks it away and waves goodbye, running off down the footpath."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hey!"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She stops and turns back. The flickering street lamp overhead casts a wavering shadow across her face."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't mention that envelope to anyone. I feel... embarrassed about the silly mix-up."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Hahaha... okay, no problem."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Not even to Evita!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Susan waves to show she understands. The Commander watches her run off into the night until she's completely out of sight."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"gunCGlake","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At night, the pond is even quieter than it was during the day. The Commander arrives at a clearing, carefully ensuring there's no place for anyone to hide nearby."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hello?"}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"How did it go?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's all confirmed. Doctor Lawrence was indeed murdered."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"He had been using his procurement privileges here to make money for himself, and his mistress took a decent cut of that too."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Not long ago, he announced that he was leaving but didn't plan to take her with him. Out of resentment, she got him drunk and pushed him into the pond."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Is that all?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If I remember correctly, my job was to investigate the cause of Lawrence's death. Beyond that, I didn't dig further."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Did Lawrence leave behind anything?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"As far as I know, all of his belongings are still in his home, waiting for your team to come sort them."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Anything else?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"Never mind.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"You did well. You'll receive the promised payment.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Thanks."}]}]},{"sprites":[{"prefab":"NPC-Evita_AB","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Evita","narrator":false,"pages":[{"spans":[{"text":"One more thing—I heard there 