":"Holding a stack of procurement orders, the Commander quickly flips through the listed figures."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"3.4 million, 5.7 million, 2.15 million... Even accounting for embezzlement, why would Evita have invested so much money here?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is being a contractor that profitable?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Recalling their last meeting with Evita in Marulos, the Commander suddenly feels they should've haggled harder."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Well, maybe this is a secret I shouldn't be poking my nose into."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They place the procurement orders back on the desk and pick up the picture frame lying next to them."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's her?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_button","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. A faint sound comes from the direction of the bedroom."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander shows no reaction, pretending not to have heard, and instead restores the desk to its original state before continuing to search through the drawers, inching closer to the bedroom."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"},{"type":"bgm","value":"BGM_stage13","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As they step one foot across the doorway, a gust of wind rushes toward the back of their head—an ambush!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Prepared for the attack, the Commander shifts sideways, causing the assailant's weapon to miss. They retaliate with a sweeping kick, sending the attacker crashing to the ground."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"Ugh!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It's the woman who had given them directions earlier that day."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As she struggles to get up, the Commander swiftly kicks the knife from her hand and ties up her hands with an IV tube that they've brought from the ward."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"Who are you?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You killed Dr. Lawrence, didn't you?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"How do you know?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I guessed.","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't ask so many questions. I'm not here to avenge him."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"There's a photo of you two together on the desk. Intimate. So—what's going on?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"Why should I tell you anything?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander pulls a small tape recorder from their pocket, its reel slowly turning."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I've already recorded your confession. You just admitted to murder yourself."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"...You vile prick!"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I need some way to protect myself."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"Turn it off first."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Fine."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Button_Click","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Once the Commander switches off the recorder, the woman slumps against the doorframe with a sigh."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"It's true. Lawrence and I were lovers."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why did you kill him?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"I assume you already know he was skimming off the top of the procurement funds?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing the Commander nod, she raises her bound hands. A shiny gold ring gleams on her left middle finger."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"Life was pretty good with him. But two weeks ago, he suddenly said he wanted to leave the medical outpost. I asked to go with him, but he refused."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"If he left, where would the money come from?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Two weeks ago, again..."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So you killed him over that?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"That wasn't the plan."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"His sudden decision to leave raised some red flags. You know how profitable this place was for him. Something must've made him abandon all that."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"So I pretended to see him off. Got him drunk and tried to get the truth out."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What did he say?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"He'd gotten hold of a secret document. He was using it to blackmail someone into smuggling him out of Kamona."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"A document? What kind of document?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"I don't know. It had something to do with someone's identity. He was too drunk and kept rambling on about \"fakes\", \"covert\", \"operative\"."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"We were walking near the pond. I asked again if he would take me with him. He cursed me instead."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"I just... snapped. He... he brought it on himself!"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Where's that document now?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"I came here today to look for it. No idea why the place was already ransacked. I couldn't find it."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What does it look like?"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"It's in a red envelope with some wine stain—he spilled red wine on it by accident."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2024AB_Operating_Room","raw":"BIN"},{"type":"flashback","raw":"回忆"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"I've got other things to do. You get some rest. I'll be back before it's time to change your bandages."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander points to a red envelope that's fallen to the floor, stained with dark, brownish smudges."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You dropped this."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Oh! Thank you! I'm off now. Shout for me if you need anything."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Susan picks up the red envelope and tucks it into the messy pile of papers, then hurries out of the ward."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"night","raw":"Night"},{"type":"background","value":"2020summerOffice","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Just go. Let's pretend you never saw me tonight."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander unties the IV tube from the woman's wrists. She scrambles to her feet and stumbles toward the door."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Also, forget about the envelope. For your own good."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker