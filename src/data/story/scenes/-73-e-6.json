rator":false,"pages":[{"spans":[{"text":"They didn't... even open it..."}]}]},{"sprites":[{"prefab":"NPC-Lilyan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tess","narrator":false,"pages":[{"spans":[{"text":"Don't scare me... (Sobs)"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A tiny hand tugs at the Commander's coat—it's Tess and Susan, both with tear-streaked faces."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"The fire was so big... I-I was scared..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girls throw themselves at the Commander from both sides. They can feel their small bodies trembling as they tighten their arms around them."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't be afraid... It's okay now... It's over..."}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"We... didn't go to the clinic today... What happened?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Around them, people scramble to extinguish the remaining flames. A doctor continues CPR on the woman for over ten minutes before finally shaking his head in exhaustion and closing her eyes."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Handing the girls over to a nearby nurse, the Commander walks over and checks the woman's nostrils."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No soot..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"The cause of the fire was identified—chemicals spilled in the dispensary. When two compounds mixed, they ignited and set the curtains ablaze. It then spread to the archives...\""}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Did anyone come here today?"}]}]},{"sprites":[],"ops":[],"speaker":"Doctor","narrator":false,"pages":[{"spans":[{"text":"No."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Not even Evita?"}]}]},{"sprites":[],"ops":[],"speaker":"Doctor","narrator":false,"pages":[{"spans":[{"text":"Evita? No, she's been busy over in Marulos, arranging a donation of new equipment for us. Fire safety systems, in fact..."}]}]},{"sprites":[],"ops":[],"speaker":"Doctor","narrator":false,"pages":[{"spans":[{"text":"If only they'd arrived a little sooner..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The doctor trails off, unable to finish the sentence."}]}]},{"sprites":[{"prefab":"NPC-Lilyan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tess","narrator":false,"pages":[{"spans":[{"text":"Big sis... It's not—"}]}]},{"sprites":[{"prefab":"NPC-Sanaya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susan","narrator":false,"pages":[{"spans":[{"text":"Hush! We promised."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Susan interrupts her little sister's soft protest. Her right hand subconsciously reaches into her pocket, but the pouch containing the chain of beads is now empty."}]}]},{"sprites":[],"ops":[],"speaker":"Doctor","narrator":false,"pages":[{"spans":[{"text":"It was an accident..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...An accident, you say?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"Hold on. Wasn't there one more patient here? That new one from a few days ago.\""}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"Oh right! Where has he gone? I remember him—his right arm was covered in burn scars...\""}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-Slum","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Take good care of yourselves, you two."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander pats the two girls' heads one last time and turns to leave."}]}]},{"sprites":[],"ops":[],"speaker":"Doctor","narrator":false,"pages":[{"spans":[{"text":"Where are you going?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Now that you ask me, I don't really know either."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The open flames at the medical outpost have finally been extinguished. No one is crying, and no one expresses sorrow over the losses."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Everyone just goes about their tasks—salvaging what can be saved, tending to the injured—as if nothing out of the ordinary had happened..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After all, they've all grown used to it. Used to sudden, irreversible partings."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander waves their hand in farewell."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But I know this for certain—such \"accidents\" must stop happening in Kamona."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
