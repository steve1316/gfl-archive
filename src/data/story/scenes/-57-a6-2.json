{"name":"-57-A6-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2023SAGA_Beach","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"},{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sky in the distance has started to grow dark, and it looks like it is going to be a gloomy night with no trace of starlight."}]},{"spans":[{"text":"Before you is the sea, reflecting the moon in its rippling waves—as well as Ai, who is sitting on the sand."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm not late, am I?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"...No, I was just a little early."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ah, I see..."}]},{"spans":[{"text":"I'm feeling so nervous all of a sudden...","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Relax, you've been doing well recently."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Does that mean I'm a useful manager now?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Of course. You're much better than I expected."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm glad you approve of me."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"But that's not enough."}]},{"spans":[{"text":"Given your current performance, you're a long way off from being able to hold a successful show."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'll work as hard as I can."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"I don't doubt that."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But just working hard might not be enough."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ai sighs."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"I don't want to rain on your parade, but... you'd best be prepared that you might be stuck here forever."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Still, I'll do my best to help you out. I've sent the forthcoming training schedules to your mailbox."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Let's work hard toward that goal in the future!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ai-chan..."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What does being an idol mean to you?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Why are you asking me that?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Because I think that if all you need is precise pitch control and neat dance steps, why would we even need human idols? Dolls can do all that."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"...So you're saying that they don't need idols anymore in the future?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We still have human singers, actors and poets in my time."}]},{"spans":[{"text":"They haven't been completely replaced by AI yet."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Are AIs and Dolls creations of the place where you come from?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes, they're creations of the future. "}]},{"spans":[{"text":"Technology is always advancing, but art isn't a mere product."}]},{"spans":[{"text":"I think art is more than simply practicing and getting familiar with your routines."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"In any time and any place, there is more than one way to approach art."}]},{"spans":[{"text":"If Franchouchou wants to succeed, just being able to sing and dance well is nothing more than getting your foot in the door. It's a long way off from being a proper idol."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Oh?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's kind of embarrassing, but in addition to practicing, I've also been thinking... What makes Franchouchou one of a kind?"}]},{"spans":[{"text":"What makes Franchouchou different from other idols? What makes them irreplaceable in the hearts of their fans?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"...Hm. What makes idols idols, you say...?"}]},{"spans":[{"text":"If you ask me, it's because they give people a unique form of strength and courage."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Well done, Commander."}]},{"spans":[{"text":"You managed to spot your member's worries and doubts in a timely fashion. That makes you a pretty decent manager, I'd say."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ah, no, I'm a long way off."}]},{"spans":[{"text":"You can't just become good at a job like this overnight."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"I've never seen you as a battlefield commander before..."}]},{"spans":[{"text":"But I think that someone like you would excel in anything you did."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Do I really merit such high praise?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Yeah. Though we might all have our own talents and skills..."}]},{"spans":[{"text":"There are a few qualities which every successful professional possesses."}]},{"spans":[{"text":"No matter what kind of trials they encounter, their real worth will always shine through."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...That applies to you too."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm saying, it's the same for you."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You'll always be the best, whether you're an idol or something else."}]},{"spans":[{"text":"It's been an honor working with you."}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"Same here."}]},{"spans":[{"text":"Come on, we've both got things to do, Manager-Commander."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You stand up and help each other pack up without saying a word."}]},{"spans":[{"text":"You can sense it now."}]},{"spans":[{"text":"Something has definitely changed between the two of you."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
