ops":[],"speaker":"K2","narrator":false,"pages":[{"spans":[{"text":"They will. Listen carefully, El Fail and every Fairy here. "}]},{"spans":[{"text":"This is something we seized back from her... "}]},{"spans":[{"text":"...Something that belonged to all of you in the first place!"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"DJMAX_LadyMadeStar","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"FAIL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"El Fail","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"This song... "}]},{"spans":[{"text":"Haha, you've gotta be kidding..."}]}]},{"sprites":[{"prefab":"K2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K2","narrator":false,"pages":[{"spans":[{"text":"That's right, you should know it! "}]},{"spans":[{"text":"I'm sure you do, since you took it from the Fairies!"}]}]},{"sprites":[{"prefab":"DJMAXSEHRA","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,250"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...On the other side of the stage, the twin idols start singing."}]}]},{"sprites":[{"prefab":"K2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K2","narrator":false,"pages":[{"spans":[{"text":"Fairies! P-Please listen to this song! It belongs to Sehra and Nina! "}]},{"spans":[{"text":"This is music that's one-of-a-kind and only belongs to them!"}]}]},{"sprites":[{"prefab":"FAIL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"El Fail","narrator":false,"pages":[{"spans":[{"text":"Uh... H-Hold on for a second..."}]}]},{"sprites":[{"prefab":"K2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K2","narrator":false,"pages":[{"spans":[{"text":"They have what is theirs by right! You used to possess such things as well! "}]},{"spans":[{"text":"This person, who claims to be your Master, took them all away from you – your name, your memories, your music! She turned you into shadows of your former selves, left to wander around the city aimlessly!"}]}]},{"sprites":[{"prefab":"FAIL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"El Fail","narrator":false,"pages":[{"spans":[{"text":"I said wait! "}]},{"spans":[{"text":"You don't understand! I'm trying to protect them!"}]}]},{"sprites":[{"prefab":"K2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K2","narrator":false,"pages":[{"spans":[{"text":"How is this protection?! "}]},{"spans":[{"text":"You're simply treating them like they're your own possessions!"}]}]},{"sprites":[{"prefab":"FAIL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"El Fail","narrator":false,"pages":[{"spans":[{"text":"Don't think...that only you have your own music. "}]},{"spans":[{"text":"As the Master of this city, everything that's yours is mine to begin with!"}]}]},{"sprites":[{"prefab":"K2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K2","narrator":false,"pages":[{"spans":[{"text":"All you have is your vanity and self-delusional greed! "}]},{"spans":[{"text":"Let us decide this city's fate with a proper fight, El Fail!"}]}]},{"sprites":[{"prefab":"FAIL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...El Fail sighs heavily."}]}]},{"sprites":[{"prefab":"FAIL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"DJMAX_BlackCat","raw":"BGM"}],"speaker":"El Fail","narrator":false,"pages":[{"spans":[{"text":"Reality already sucks enough, and now you want to corrupt our world as well? "}]},{"spans":[{"text":"As you wish. Come at me. "}]},{"spans":[{"text":"A friendly reminder – You can't defeat the Queen of Pocket City. All you can do is accumulate meaningless points before you achieve a Break."}]}]},{"sprites":[{"prefab":"K2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K2","narrator":false,"pages":[{"spans":[{"text":"That's fine... "}]},{"spans":[{"text":"All we need...is to show everyone their ideals."}]}]},{"sprites":[{"prefab":"FAIL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"El Fail","narrator":false,"pages":[{"spans":[{"text":"Unfortunately, your ideals are exactly what I'm going to rip and tear away from you."}]}]},{"sprites":[{"prefab":"FAIL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"El Fail","narrator":false,"pages":[{"spans":[{"text":"Dreams die. History will be forgotten. Blood, sweat and tears are shed in vain. "}]},{"spans":[{"text":"Now, let me tell you what really matters! "}]},{"spans":[{"text":"Come! Say it louder! No turning back!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"White","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
