ull,"narrator":false,"pages":[{"spans":[{"text":"You raise the pouch painfully and show everyone its empty contents."}]}]},{"sprites":[{"prefab":"NPC-Junko","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"60,-230","spriteScale":"1.27"}}],"ops":[],"speaker":"Junko Konno","narrator":false,"pages":[{"spans":[{"text":"What is the meaning of this?"}]}]},{"sprites":[{"prefab":"NPC-MizunoAi","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"60,-250","spriteScale":"1.27"}}],"ops":[],"speaker":"Ai Mizuno","narrator":false,"pages":[{"spans":[{"text":"If I remember correctly, this is the pouch in which the Commander stores our IDs..."}]}]},{"sprites":[{"prefab":"NPC-Sakura","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-270","spriteScale":"1.27"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_Wonder","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Sakura Minamoto","narrator":false,"pages":[{"spans":[{"text":"Huh?!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=3%%delay=0.1%%range=8","raw":"controll_shake"},{"type":"sfx","value":"AVG_Thunder_Dry","raw":"SE1"}],"speaker":"Production Assistant","narrator":false,"pages":[{"spans":[{"text":"WHAAAAAT?!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The production assistant's wretched howl echoes through the quiet lakeside..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"background","value":"2023SAGA_RevengeLive_b","raw":"BIN"},{"type":"sfx","value":"AVG_Pause","raw":"SE1"},{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the end, you are delayed so much all the audience has left by the time you finally arrive at the venue. "}]},{"spans":[{"text":"The organizers have angrily blacklisted Franchouchou. "}]},{"spans":[{"text":"You have no choice but to leave the venue and return to the mansion."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2023SAGA_VillaNight","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Franchouchou put on the show in the living room of the mansion. "}]},{"spans":[{"text":"As their only audience, you watch their performance for which they have put in a lot of effort to prepare on the sofa. "}]},{"spans":[{"text":"You've got to admit that the quality of their performance has room for improvement, but their sincerity and earnestness certainly shine through. "}]},{"spans":[{"text":"They keep up their dazzling smiles on the stage as you dissolve into a sobbing mess. "}]},{"spans":[{"text":"If only... you had... "}]},{"spans":[{"text":"You can't stop beating yourself up for what happened."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Then like a sudden power outage, everything goes dark around you."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"A power cut?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nobody answers you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Splash... "}]},{"spans":[{"text":"The waves strike the hull of the boat rhythmically. The salty sea air is laced with a barely noticeable tinge of floral fragrance."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What's going on?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"The wheel of fate has started to turn again. "}]},{"spans":[{"text":"You may have a chance to put things right."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"It has been set in motion since long ago. It will not stop now."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The boat suddenly surges forward at high speed. You can hear the sound of its bow cutting through the surface of the sea... "}]},{"spans":[{"text":"Somehow you have a feeling... you are about to be given a second chance."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
