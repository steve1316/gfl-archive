{"name":"-73-A-24","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_Wind","raw":"SE1"},{"type":"sfx","value":"AVG_Creep","raw":"SE1"},{"type":"background","value":"树林","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At last, the three climb over the cliff with the box, reaching flat ground. They pause to rest and reorganize. In the distance, the Northridge Hotel comes into view."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Never thought Hecate would show such mercy. Looks like the intel I had on her was wrong."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Mercy? Hecate? Did I hear that right?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Four years ago, if she hadn't shown mercy and instead killed that glory-hungry traitor, she could've claimed all the credit and gotten the reward."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"She got to where she is not because she's ruthless, but because she has more principles than most."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro unties the ropes from the box, casually lifting one of the handles. She tries to hoist it up, but her strained arm gives out from earlier exertion, and the box thuds back to the ground."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Careful!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro stares at the Commander, puzzled at their overreaction."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"What's wrong with you?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Judging from Hecate's reaction earlier, I have a bad feeling about what's inside this box. I hope I'm just being paranoid."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander offers no further explanation. Together with Kuro, they lift the box again, this time more steadily."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's go find a ride. We're almost at the hotel."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"background","value":"black","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_BedRoom","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At dusk, less than two hours from the scheduled time."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Do we really have to leave our weapons outside? I bet it's another damn radio."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the Northridge Hotel, the Commander, Mityl, and Kuro come to an unmarked room. They push open the door."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"You made it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A man in black greets them inside the room. He is wearing sunglasses, which obscures his face."}]}]},{"sprites":[],"ops":[],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"Did you bring the box?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ignoring Kuro's snarky remark, the man cuts straight to the chase. The Commander sets the box down on the carpet in the center of the room."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Here."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man doesn't touch the box. Instead, he picks up a walkie-talkie."}]}]},{"sprites":[],"ops":[],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"They've arrived."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"What did I say...?","style":{"size":"25"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl nudges her into silence. A familiar woman's voice crackles through the speaker."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Good. The box?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"Minor wear, no major damage."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Open it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"Open it? ...Alright."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man hesitates briefly, then calls someone over."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_The_Division_Baggage_bomb_Activation","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The two men each place a finger on a biometric lock. With a click, the box opens."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander can't see inside from their angle. The man reaches in, carefully inspecting something."}]}]},{"sprites":[],"ops":[],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"She's alive."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Good. Get her to the doctor.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"You're free to go.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man sets the radio down on the table. With help from the newcomer, he lifts the contents from the box—"}]}]},{"sprites":[],"ops":[],"speaker":"Mityl & Kuro","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It is a human girl, unconscious."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She looks about seventeen or eighteen. Her eyes are closed. Her supple long hair trails behind her, with a vivid streak of color dyed on the left side."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"bgm","value":"BGM_TheUniverse-TheWheelofFortune","raw":"BGM"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"It's a person... There's a person in that box!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl's gasp escapes her mouth before she can clap a hand over her mouth. Her eyes widen in shock. Kuro grabs her arm."}]}]},{"sprites":[],"ops":[],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"Please remain here. The client would like to talk to you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man carries the girl toward the exit. As he passes, her limp hair brushes the Commander's arm."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man halts. His partner places a hand on his waist—near his holster."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The box... Aren't you taking that with you?"}]}]},{"sprites":[],"ops":[],"speaker":"Man","narrator":false,"pages":[{"spans":[{"text":"No."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander has instinctively reached out for the girl, but they manage to stop themself in time. They jam their hands into their pockets forcefully."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right. Got it."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"sfx","value":"AVG_20Winter_Door_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The two men exit, shutting the door behind them."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Out of sight, the Commander's hands in their pockets have clenched into tight fists."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"You've done well.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The walkie-talkie sits on the table. The three stand frozen. It's feels like the warehouse in Marulos all over again."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"I heard Hecate and Doss gave you trouble along the way, but you made it. Thank you for your efforts.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"I've arranged rooms for you in the Northridge Hotel. Rest here for the night. I'll bring your payment in the morning.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No chance for a response. The light on the walkie-talkie goes dim."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The door opens. A man dressed as a hotel staff member bows slightly."}]}]},{"sprites":[],"ops":[],"speaker":"侍者","narrator":false,"pages":[{"spans":[{"text":"Allow me to escort you to your room."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2022winter_BedRoom","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Room 307, Northridge Hotel."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The layout and decor are identical to the previous room. All three are assigned to the same space."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After thanking the staffer and locking the door behind them, the tension finally breaks."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"They stuffed a person in a box and tricked us into delivering her! That's kidnapping!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"That's why there were air holes, and why they insisted it be delivered within 24 hours."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Imagine if we'd dropped it off the cliff..."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Good thing we didn't. She's alive."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"What about Beluga? Does she also know that it was a girl inside the box?"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Definitely. Hecate too."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Beluga clearly knows the girl, and yet she still had us bring her here. Why?"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The box had cutting-edge biometric locks and could only be opened with two people. Forcing it open could've harmed the girl inside."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If we didn't bring her to Northridge, she'd have died inside. This was Beluga's only option."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Who is this girl, anyway? To have both Doss and Hecate fighting over her—it's totally unheard of."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Whoever she is... To drug someone and lock them in a box... they're no good people."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Should we... should we...?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl trails off. The three exchange glances. No one needs to say it aloud."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Just like when we let John go on the boat."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They nod to each other, sharing a knowing smile."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"bgm","value":"GF_2022_Summer_Battle_3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kuro slumps back into a chair, finally relaxed without the weight of ammo belts and weapons."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"First thing—we need to figure out where they took the girl. And second—we've got to get our guns back."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Guns? ...Damn it!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander bolts to the door and tries to open it, only to find it locked from the outside."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Wheelchair","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They yank on the white-painted wooden door. The wood strains under the force."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"They're tying up loose ends!"}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"That's why they opened the box in front of us and didn't bother to hide their secrets."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Fire_Bonfire","raw":"SE1"},{"type":"effect","value":"%%code=CJ_fire%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"From the gap beneath the door, flames and smoke begin to seep in."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Cough... Get back!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl and Kuro grab the table, preparing to ram the door."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_gun_silencer","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hang on!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander hears a shot fired from a suppressed pistol—then the door is kicked open from the outside."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Flames pour in from the hallway. Silhouetted against the blaze is a familiar figure."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's you?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"black","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-InterrogationRoom","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The next day, in a hidden room one kilometer northwest of the Northridge Hotel, a phone call takes place."}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Hello, it's me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"The box was delivered, but someone took the \"cargo\" last night.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"All we know is that it was a woman missing an eye.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Mhm. Those three special operatives have already been dealt with, but I suspect someone else showed up at the Northridge Hotel last night.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Female Voice","narrator":false,"pages":[{"spans":[{"text":"Don't worry. I'll get to the bottom of this.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_carmona","raw":"BGM"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"树林","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the woods, fifty kilometers from the Northridge Hotel."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A jeep bumps and grinds its way down a mountain path. Judging by the depth of the tracks, it's carrying a heavy load."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We're far enough. We should be safe now."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_HeavyVehicle_Stop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The jeep halts. One, two, three... seven people hop off."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is she alright?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander glances toward the eighth person, still lying quietly in the back of the jeep. The unconscious girl's long dark hair is tied into a ponytail, trailing softly across the seat."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Antje","narrator":false,"pages":[{"spans":[{"text":"The phone took the bullet. It didn't hit anything vital—just knocked her out. But the impact, plus the smoke from the fire..."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Antje","narrator":false,"pages":[{"spans":[{"text":"She still hasn't woken up. We'll take her to a doctor we trust."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Renate","narrator":false,"pages":[{"spans":[{"text":"Don't worry."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Renate","narrator":false,"pages":[{"spans":[{"text":"She's like a blade of grass growing from the driest stones in Kamona. She won't die without meaning."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"I hope she's okay... Thank you. You saved our lives!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah, thanks. This was the second time you've charged into a burning building. What were you even doing in Northridge?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"It wasn't a coincidence. A month ago, we took a job. The only instruction was to arrive at the Northridge Hotel yesterday and stay the night."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"A job?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"Yeah. The client was a teenage girl. Never heard of her before, not even in the Dark Zone. But she had a streak of highlight dyed into the left side of her hair."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"And?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"We waited outside until sunset. That's when a girl with an eyepatch over her right eye came looking for us."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Beluga!"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"You know her?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"She's our friend. How is she?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"She looked fine."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"She had a private conversation with Angelia, and then Angelia took us on a rescue mission. Didn't expect to see you again when we busted down the door..."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Thank you, truly."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"We don't know much else."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"It's strange, though. Angelia is always so guarded... but she trusted those two enough to put everything on the line... Just like she risked her life to save you."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Strange? To be honest, I don't even understand it myself. But if I had the chance, I'd do everything in my power to save her too."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"But you're strangers, no?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We've never met. And yet, it feels as if we'd known each other forever—like we'd gone through fire and water together countless times."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Maybe there's a kind of trust that transcends time. A gift of fate."}]}]},{"sprites":[{"prefab":"AK15","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erwin","narrator":false,"pages":[{"spans":[{"text":"So what now?"}]}]},{"sprites":[{"prefab":"AK15","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We'll probably need to lie low for a while."}]}]},{"sprites":[{"prefab":"AK15","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If you hadn't swapped us out with three corpses yesterday, we wouldn't have gotten out so cleanly."}]}]},{"sprites":[{"prefab":"AK15","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Whoever's backing the client must be dangerous. We'll need new identities."}]}]},{"sprites":[{"prefab":"AK15","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erwin","narrator":false,"pages":[{"spans":[{"text":"A wise choice."}]}]},{"sprites":[{"prefab":"RPK16","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Renate","narrator":false,"pages":[{"spans":[{"text":"Well then, this is where we say goodbye. We need to figure out how to wake our sleeping beauty. And this jeep can't handle any more weight..."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Antje","narrator":false,"pages":[{"spans":[{"text":"Good luck. I hope we meet again."}]}]},{"sprites":[{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erwin","narrator":false,"pages":[{"spans":[{"text":"Take care."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Moto_Start","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The four light-haired girls get back into the jeep. Lucia starts the engine and leans out of the driver's seat."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucia","narrator":false,"pages":[{"spans":[{"text":"Let's not make it too long till next time."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Trust me. It won't be."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Bye! Stay safe!"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Bye!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Moto_Run","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The jeep carries off the four girls and the unconscious Angelia. The forest is quiet again, with only the Commander, Kuro, and Mityl left behind."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"树林","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The morning sun rises slowly, dissolving the night fog clinging to the woods."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After two days and nights of chaos and peril, this hastily assembled team finally finds a moment of peace."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Crap! What about the girl in the box?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't worry. Beluga would never leave her behind..."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"So what now...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl and Kuro stand by the Commander's side."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl has once again lost her precious backpack. Kuro's body is marked with bruises and cuts from combat..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But the three of them are still together—unbroken by the storm, unlost in the dark."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander raises a hand to shield their eyes as they peer up at the sky. An eagle soars across the rising sun."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Shall we... go on together?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"night","raw":"Night"},{"type":"background","value":"主界面背景","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Late night, at an unspecified forest camp somewhere in the Dark Zone in Kamona."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Follow me.","style":{"size":"25"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mityl moves quietly through the camp, leading four bewildered civilians, carefully avoiding the guards."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Cuckoo! Cuckoo!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A familiar \"bird call\" echoes from the trees ahead—it is Kuro, signaling her position and urging them on."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"This way.","style":{"size":"25"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Burnfire_Loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The kidnapped civilians are led to safety. At the same time, plumes of flame rise from several tents in the center of the camp. The Commander loops in from a side path and joins them."}]}]},{"sprites":[{"prefab":"NPC-P90_AB","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Mityl","narrator":false,"pages":[{"spans":[{"text":"Timing's perfect."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You ready?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Soot smears the Commander's coat—evidence of their arson. Mityl fits a gas mask over her face. Kuro flicks off the safety on her weapon with a sharp click."}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"},{"type":"bgm","value":"BGM_arenabreakout_battle2","raw":"BGM"}],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"Then it's showtime!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Three figures dive into the Kamona jungle under the cover of night, cutting through the long-standing rot of the Dark Zone with fire and gunfire in their wake."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Faint, perhaps—but light all the same. Light that refuses to be extinguished by the dark."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
