{"name":"-73-H-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_TK_face","raw":"BGM"},{"type":"background","value":"树林","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After leaving the factory owner's villa, the Commander calls the client."}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Red curly hair—that's him, that's Hubert!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Hecate... I knew it. It's got to be her!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hold on, what makes you so sure?"}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Hubert humiliated Hecate in public once—offended her.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"I've suspected all along that she was settling a personal grudge. That's why I came to you instead of letting Blackgold know.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But from what I know, Hecate doesn't seem like the type to kill in the shadows..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"You have no idea what happened!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"It was three months ago...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_Combat_Hits","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"BG_Base","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nice!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Good hit!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At a Blackgold Universal Abyss Squad encampment, two Blackgold operatives are sparring in the open area."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hubert, get him! Nice one!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man with red curls, shirtless under a tight tank top, is none other than Hubert."}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=4%%delay=0%%range=3","raw":"controll_shake"},{"type":"sfx","value":"AVG_lifttable","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a swift sidestep and a bit of redirecting force, he throws his opponent to the ground."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"The winner is Hubert!\""}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Cheers erupt from the crowd. Hubert stands in the center of the clearing, raising his arms to acknowledge the spectators."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Then, the cheering abruptly dies down. Hubert turns around in confusion, A black-haired woman has stepped out of the tent."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It's Hecate."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Blackgold operatives lounging around quickly scramble to their feet, snapping to attention in unison."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Blackgold Operatives","narrator":false,"pages":[{"spans":[{"text":"Ma'am!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate nods. She was heading toward the camp entrance, but she changes course and walks directly toward the sparring ring."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She stops in front of the group, arms crossed, lips tight, chin slightly raised."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Don't mind me. Continue."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Blackgold operatives, previously laughing and relaxed, now stand frozen."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Continue."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The second time, the word sounds colder. Despite their tension, no one dares disobey. They hesitantly reform a loose circle, leaving space in the center."}]}]},{"sprites":[],"ops":[],"speaker":"Blackgold Operative","narrator":false,"pages":[{"spans":[{"text":"...The last winner was Hubert. Anyone else want to challenge?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hubert returns to the center, awkwardly rubbing his hands together and glancing around, carefully avoiding eye contact with Hecate."}]}]},{"sprites":[],"ops":[],"speaker":"Blackgold Operative","narrator":false,"pages":[{"spans":[{"text":"...Anyone?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No one responds. One operative at the edge tries to slip away but is yanked back by the teammate beside him."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Realizing her presence is paralyzing the team, Hecate finally lowers her arms, swallows discreetly, and sits down on the spot."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Only then do the others slowly begin to sit down. At Hubert's pleading glance, Saul steps forward."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Hubert","narrator":false,"pages":[{"spans":[{"text":"...C'mon."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"BG_Base","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Combat_Hits","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They've already been exchanging blows for a while. Both men are overly cautious now—nothing like the energetic combat earlier."}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"What now?","style":{"size":"25"}}]}]},{"sprites":[],"ops":[],"speaker":"Hubert","narrator":false,"pages":[{"spans":[{"text":"A draw?","style":{"size":"25"}}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Taking advantage of a close-range stalemate, they whisper to each other. Then, they simultaneously let go and retreat, ending the match."}]}]},{"sprites":[],"ops":[],"speaker":"Hubert","narrator":false,"pages":[{"spans":[{"text":"It's a draw."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This heavily theatrical duel is finally over. The watching operatives seem relieved. Scattered applause echo through the camp."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate sits expressionless at the front, snapping a dry grass stalk in her hand."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Blackgold Operative","narrator":false,"pages":[{"spans":[{"text":"...So, can we disperse now?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Everyone exhales in relief. A few younger operatives start to rise, trying to escape the oppressive atmosphere."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"I'll have a go."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate brushes the crushed grass from her hand and rises to her feet."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"},{"type":"background","value":"树林","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hubert beat Hecate in front of everyone??!!"}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Yes.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How could he even dare?"}]}]},{"sprites":[{"prefab":"NPC-MDR_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kuro","narrator":false,"pages":[{"spans":[{"text":"What's the big deal?"}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"You wouldn't say that if you knew Hecate's record.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"She was a decorated Marine before joining Blackgold. After an operative, she became a living legend for how quickly she rose through the ranks.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"At first, people questioned how someone so young could lead the Abyss Squad. But soon, no one questioned her again—she earned it with her life.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"In the Abyss Squad, no one disobeys her. Hubert... how could he dare?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's surprising, I admit. But there's still no proof that Hecate had anything to do with Hubert's disappearance."}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Ever since that incident, Hubert has been targeted—on purpose.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"There were so many signs...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"BG_Base","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Is everyone clear on the team assignments for this infiltration mission?"}]}]},{"sprites":[],"ops":[],"speaker":"Blackgold Operatives","narrator":false,"pages":[{"spans":[{"text":"Yes, ma'am!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the camp, Hecate is giving out instructions. Two rows of Blackgold operatives stand straight, eyes forward, expressions serious."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Hubert","narrator":false,"pages":[{"spans":[{"text":"One question, ma'am!"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Go ahead."}]}]},{"sprites":[],"ops":[],"speaker":"Hubert","narrator":false,"pages":[{"spans":[{"text":"Why are the others in teams of three or four, and I'm alone?"}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"I'm not obligated to answer that."}]}]},{"sprites":[],"ops":[],"speaker":"Hubert","narrator":false,"pages":[{"spans":[{"text":"Yes, ma'am."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Prep yourselves for departure. Dismissed!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The operatives break formation, heading off in groups to gather gear or discuss strategies. Only Hubert walks alone toward the dorms, dragging his feet."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing this, Saul catches up to him."}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"What's going on?"}]}]},{"sprites":[],"ops":[],"speaker":"Hubert","narrator":false,"pages":[{"spans":[{"text":"I don't know... Could be a mission requirement?"}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Could it be... retaliation?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The two mutter under their breath, not noticing Hecate walking right past them."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Hubert","narrator":false,"pages":[{"spans":[{"text":"Ahem! Cough..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She gives no sign of having heard anything. Her pace never falters; her eyes remain fixed directly ahead as she walks into her ops room."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Watching her go, Saul pats Hubert on the shoulder."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Just be careful, alright?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_SnowMountain","raw":"BIN"},{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"Keep up. We've only done 20 kilometers—just about halfway."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A team from Blackgold is silently trekking through mountainous terrain, each person carrying a heavy pack."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hecate leads at the front. Even her face is drenched in sweat from the long, grueling hike."}]}]},{"sprites":[{"prefab":"NPC-Hecate_AB","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hecate","narrator":false,"pages":[{"spans":[{"text":"If anyone falls behind, it's double training when we return."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No one says a word. They march in sync, focused entirely on conserving breath."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hubert and Saul are at the rear. At a bend in the trail, Saul stops Hubert."}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Give me five kilos of your load."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hubert's face is pale. Sweat—cold or hot, it's hard to tell—pours from his forehead. He takes a few seconds to catch his breath before replying."}]}]},{"sprites":[],"ops":[],"speaker":"Hubert","narrator":false,"pages":[{"spans":[{"text":"Thanks... but no."}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Everyone else is carrying 20 kilos, only you've got 30. She's singling you out!"}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Don't push yourself. C'mon, quick—before they notice."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hubert pats Saul's shoulder, breaks off a tree branch to use as a walking stick, and continues climbing."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"树林","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Dangerous missions, harsh training... there's been a lot of this.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"And all of it started after Hubert took Hecate down in front of everyone. I choose to believe that's not a coincidence.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Hecate is taking revenge!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I admit, it sounds pretty convincing, but we still don't have proof. Hubert's just missing—"}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"We do!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[],"ops":[],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"You mentioned the person who killed Hubert just now...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"They only left together. The factory owner didn't see Hubert actually get shot—"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Saul","narrator":false,"pages":[{"spans":[{"text":"Regardless, that bald guy with the scar is named Stone. I know where he is.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
