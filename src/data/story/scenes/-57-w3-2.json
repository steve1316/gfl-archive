{"name":"-57-W3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2023SAGA_Beach","raw":"BIN"},{"type":"bgm","value":"BGM_Saga_AVG_Dusk","raw":"BGM"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The beach at night is completely different from the beach during daytime."}]},{"spans":[{"text":"During the day, the waves are calm and clear, steadily washing up the shore."}]},{"spans":[{"text":"But the sea at night is melancholy and quick to anger, throwing up sand particles everywhere and foaming furiously as it pounds against your feet."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You walk alone by the seaside, enjoying the sensation of the sea breeze caressing your scalp."}]},{"spans":[{"text":"During quiet moments such as these, those feelings of yours that are typically pinned down by countless minutiae begin slowly coming to the fore."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Strum, strum, strum... A shamisen is faintly audible in between the crashing of the waves. You look toward the source of the sound and see a lovely figure standing by herself on the shore."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"gradientShow","value":"2","raw":"GradientShow"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"... ♪"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You quietly creep up and try to listen to the tune she's humming. You've never heard it before."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"...Commander-han?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I just happened to be passing by. Did I disturb you?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Not at all."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri chuckles politely and then puts down her plectrum."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I've never heard you sing this song before."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"It's a tune from my hometown. I doubt you'd hear it in Saga..."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Weren't you born in Saga?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Oh, no. I lived in Edo City once and followed my former owner to Saga."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So you're far from home, just like me."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Although I didn't grow up here, Saga has always felt special to me."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"It's as though destiny binds me here. I can't leave, nor do I want to."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Really now..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You break away from her tender gaze and look out at the inky-black surface of the sea."}]},{"spans":[{"text":"You can vaguely glimpse the silhouette of the Griffin base in the darkness."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Are you... thinking of home?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I guess."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Where IS your home, Commander-han?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You smile bitterly. You don't even know where your home is or how to get back to it."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Somewhere far, far away."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Somewhere far, far away, you say... "}]},{"spans":[{"text":"Have you ever wondered what you would do once you get home? "}],"choices":["Savagely embrace my adjutant.","Run 50 laps around the base in a mad dash.","Quit my job and open an entertainment company with my Dolls."]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri chuckles."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Then all I can do is hope your wish comes true."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm sure it will."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Mhm!"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Oh yes, Commander-han. How shall I contact you once you get home?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Back where I come from, we use terminals to communicate with each other."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Terminals?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"They're kinda like tablets. You can do all sorts of things with them, from making calls to ordering food deliveries, and even shopping."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"One-one moment please, Commander-han. Things are getting more and more complicated."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"My apologies, Yugiri. It must be a bit too complicated for you."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Modern technology has truly developed quickly..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri sighs in resignation. You think about how Yugiri is used to communicating, and you hit on an idea."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You can write a letter to me."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"Hm... But if there is a great distance between us, then the letter will have to travel a long way."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Hm, that's right."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri rests her cheek on her hand. Suddenly, her eyes light up."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"I have an idea. It's something we can both do easily, and it'll get the message across without any mistakes."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What is it?"}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"In the future, on this hour of this day of each year, we will both come to the beach for a walk."}]},{"spans":[{"text":"We're only allowed to come by ourselves, and we have to think of the other person when we do."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"That way, we will be able to overcome the barriers of time and space to be by each other's side."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri looks expectantly at you. Her eyes gleam like diamonds on black velvet."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Of course."}]}]},{"sprites":[{"prefab":"NPC-Yugiri","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"120,-150","spriteScale":"1.85"}}],"ops":[],"speaker":"Yugiri","narrator":false,"pages":[{"spans":[{"text":"It's a date, then."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yugiri takes your arm and walks into the shallows of the beach, which have been wetted by the seawater."}]},{"spans":[{"text":"The footprints you leave on the soft sand are soon washed away by the waves, but you know that they're still there."}]},{"spans":[{"text":"They will exist in your memories forever, on this day that belongs to the two of you alone."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
