oor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You dry your hands carefully and open the door to your locker, which contains all the songs you have written in the last few days in a sudden burst of inspiration. "}]},{"spans":[{"text":"Every one of them has the potential to be a massive hit."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I wrote these songs specially for Franchouchou. If they sing them during the concert, it will surely propel them to stardom! "}]},{"spans":[{"text":"And take their career to new heights!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You believe that with great certainty."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2023SAGA_Failure","raw":"BIN"},{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"BGM_Saga_AVG_Live_Bad","raw":"BGM"},{"type":"sfx","value":"AVG_Pause","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Until you see for yourself what Franchouchou is doing with the songs you wrote."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You have always prided yourself on being a strong-willed person who doesn't give up easily. "}]},{"spans":[{"text":"But on this night, you break down. You feel so thoroughly defeated, you've lost the will to carry on. "}]},{"spans":[{"text":"You have been driven to utter despair, but Franchouchou is still pressing on with their performance on stage."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":