# Asset host: one repo read through raw GitHub links, which send `access-control-allow-origin: *`.
VITE_ASSET_BASE_URL=https://raw.githubusercontent.com/steve1316/gfl-archive-assets/main/

# The base must stay a web address. A folder path such as `C:\...` cannot be loaded by the browser.
# To self-host the art from a local copy, leave the line above as is and set the folder below.
# Keep that folder outside this repo's folder, or every Docker build copies all of it.
# Then run the command in the README, which serves the folder and points the build at it.
# GFL_ASSETS_DIR=C:\path\to\gfl-archive-assets
